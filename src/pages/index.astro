---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PopularCities from '../components/PopularCities.astro';
import AdSlot from '../components/AdSlot.astro';
import { getHomeSEO, generateStructuredData } from '../lib/seo';
import { fetchWeatherData } from '../lib/weather';
import provinces from '../data/provinces.json';
import regions from '../data/regions.json';

const seo = getHomeSEO();
const structuredData = generateStructuredData('home', {
  name: seo.title,
  description: seo.description,
  url: seo.canonical,
});

// Fetch weather for popular cities at build time
const popularProvinces = provinces.filter((p: any) => p.popular);
const popularCitiesWeather = await Promise.all(
  popularProvinces.map(async (p: any) => {
    try {
      const weather = await fetchWeatherData(p.lat, p.lon);
      return {
        name: p.name,
        slug: p.slug,
        lat: p.lat,
        lon: p.lon,
        temperature: weather.current.temperature,
        weatherCode: weather.current.weatherCode,
        max: weather.daily.temperatureMax[0],
        min: weather.daily.temperatureMin[0],
      };
    } catch {
      return {
        name: p.name,
        slug: p.slug,
        lat: p.lat,
        lon: p.lon,
        temperature: 0,
        weatherCode: 0,
        max: 0,
        min: 0,
      };
    }
  }),
);

const regionGroups = regions.map((r: any) => ({
  ...r,
  provinces: provinces.filter((p: any) => p.region === r.id),
}));
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  structuredData={structuredData}
>
  <Header slot="header" />

  <!-- Hero -->
  <div class="gradient-sky dark:gradient-night text-white py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-3">
        Türkiye Hava Durumu
      </h1>
      <p class="text-lg md:text-xl opacity-90 mb-6">
        81 il ve tüm ilçeler için 15 günlük detaylı hava tahmini
      </p>
      <div class="max-w-md mx-auto relative" role="search">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input
          type="text"
          id="hero-search"
          placeholder="Şehir veya ilçe ara..."
          aria-label="Şehir veya ilçe ara"
          autocomplete="off"
          data-search-input
          data-search-target="hero-search-results"
          data-search-theme="hero"
          class="w-full pl-12 pr-4 py-3.5 rounded-2xl bg-white/95 dark:bg-slate-800/95 text-slate-900 dark:text-white placeholder:text-slate-400 shadow-lg text-base focus:outline-none focus:ring-2 focus:ring-white/50"
        />
        <div id="hero-search-results" class="absolute top-full left-0 right-0 mt-2 bg-white dark:bg-slate-800 rounded-2xl shadow-lg overflow-hidden hidden z-50 max-h-60 overflow-y-auto border border-slate-200 dark:border-slate-700">
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 py-8">
    <AdSlot id="home-top" />

    <!-- Popular Cities -->
    <PopularCities cities={popularCitiesWeather} />

    <AdSlot id="home-mid" />

    <!-- Regions -->
    <section class="mt-10">
      <h2 class="text-xl font-bold mb-6">Bölgelere Göre İller</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {regionGroups.map((region: any) => (
          <div class="weather-card">
            <h3 class="text-sm font-semibold text-primary-600 dark:text-primary-400 mb-3">
              {region.name}
            </h3>
            <div class="grid grid-cols-2 gap-2">
              {(() => {
                const popular = region.provinces.filter((p: any) => p.popular);
                const featured = (popular.length >= 4 ? popular : region.provinces).slice(0, 6);
                return featured.map((p: any) => (
                  <a
                    href={`/${p.slug}-hava-durumu/`}
                    class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-[var(--color-bg)] transition-colors"
                  >
                    <svg class="w-3.5 h-3.5 text-[var(--color-text-secondary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    </svg>
                    <span class="text-sm">{p.name}</span>
                  </a>
                ));
              })()}
            </div>
          </div>
        ))}
      </div>
    </section>

    <AdSlot id="home-bottom" />

    <!-- SEO content -->
    <section class="mt-10 max-w-none space-y-4">
      <h2 class="text-xl font-bold">Türkiye Hava Durumu Tahmini</h2>
      <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
        YarınHava.com olarak Türkiye'nin 81 ili ve tüm ilçeleri için güncel hava durumu
        bilgilerini ve 16 günlük detaylı tahminleri sunuyoruz.
      </p>

      <h3 class="text-base font-semibold mt-6">Hangi verileri sunuyoruz?</h3>
      <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
        Saatlik sıcaklık değişimleri, yağış olasılıkları, rüzgar hızı ve yönü, nem oranı,
        UV indeksi, basınç ve görüş mesafesi gibi kapsamlı meteorolojik verilere anında
        erişebilirsiniz.
      </p>

      <h3 class="text-base font-semibold mt-6">Veri Kaynaklarımız</h3>
      <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
        Hava durumu verileri NOAA GFS, DWD ICON ve ECMWF IFS gibi dünya çapında kabul görmüş
        meteorolojik tahmin modellerinden alınmaktadır.
      </p>

      <h3 class="text-base font-semibold mt-6">Kim için faydalı?</h3>
      <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
        İster tatil planı yapıyor olun, ister günlük aktivitelerinizi planlayın — doğru hava
        tahmini ile her zaman hazırlıklı olun.
      </p>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<!-- Hero search behavior is handled by /scripts/search.js (loaded in Header.astro). -->

<script is:inline>
  // Client-side weather refresh for popular cities
  (function() {
    var CACHE_KEY = 'popular_cities_weather';
    var CACHE_MS = 30 * 60 * 1000; // 30 minutes
    var WMO = {0:'Açık',1:'Az Bulutlu',2:'Parçalı Bulutlu',3:'Bulutlu',45:'Sisli',48:'Kırağılı Sis',51:'Hafif Çisenti',53:'Çisenti',55:'Yoğun Çisenti',61:'Hafif Yağmur',63:'Yağmurlu',65:'Şiddetli Yağmur',71:'Hafif Kar',73:'Kar Yağışlı',75:'Yoğun Kar',77:'Kar Taneleri',80:'Hafif Sağanak',81:'Sağanak Yağış',82:'Şiddetli Sağanak',85:'Hafif Kar Sağanağı',86:'Kar Sağanağı',95:'Gök Gürültülü Fırtına',96:'Dolu ile Fırtına',99:'Şiddetli Dolu Fırtınası'};

    function getTempClass(t) {
      if (t >= 35) return 'temp-hot';
      if (t >= 25) return 'temp-warm';
      if (t >= 15) return 'temp-mild';
      if (t >= 5) return 'temp-cool';
      if (t >= -5) return 'temp-cold';
      return 'temp-freezing';
    }

    function showUpdated(ts) {
      var el = document.getElementById('popular-updated');
      if (!el) return;
      var d = new Date(ts);
      var h = String(d.getHours()).padStart(2, '0');
      var m = String(d.getMinutes()).padStart(2, '0');
      el.textContent = 'Son güncelleme: ' + h + ':' + m;
    }

    function updateCity(slug, data) {
      var temp = Math.round(data.current.temperature_2m);
      var code = data.current.weather_code;
      var max = Math.round(data.daily.temperature_2m_max[0]);
      var min = Math.round(data.daily.temperature_2m_min[0]);

      var tempEl = document.querySelector('[data-city-temp="' + slug + '"]');
      if (tempEl) {
        tempEl.textContent = temp + '°';
        tempEl.className = 'text-2xl font-bold mt-1 ' + getTempClass(temp);
      }
      var descEl = document.querySelector('[data-city-desc="' + slug + '"]');
      if (descEl) descEl.textContent = WMO[code] || '';
      var maxEl = document.querySelector('[data-city-max="' + slug + '"]');
      if (maxEl) maxEl.textContent = '↑' + max + '°';
      var minEl = document.querySelector('[data-city-min="' + slug + '"]');
      if (minEl) minEl.textContent = '↓' + min + '°';
    }

    function getCached() {
      try {
        var c = localStorage.getItem(CACHE_KEY);
        if (!c) return null;
        var p = JSON.parse(c);
        if (Date.now() - p.ts > CACHE_MS) return null;
        return p;
      } catch(e) { return null; }
    }

    function refresh() {
      var cached = getCached();
      if (cached) {
        Object.keys(cached.d).forEach(function(slug) { updateCity(slug, cached.d[slug]); });
        showUpdated(cached.ts);
        return;
      }

      var cards = document.querySelectorAll('[data-city-slug]');
      var cities = [];
      cards.forEach(function(card) {
        cities.push({ slug: card.getAttribute('data-city-slug'), lat: card.getAttribute('data-lat'), lon: card.getAttribute('data-lon') });
      });

      if (cities.length === 0) return;

      var lats = cities.map(function(c) { return c.lat; }).join(',');
      var lons = cities.map(function(c) { return c.lon; }).join(',');

      var params = new URLSearchParams({
        latitude: lats,
        longitude: lons,
        current: 'temperature_2m,weather_code',
        daily: 'temperature_2m_max,temperature_2m_min',
        timezone: 'Europe/Istanbul',
        forecast_days: '1'
      });

      fetch('https://api.open-meteo.com/v1/forecast?' + params)
        .then(function(r) { return r.json(); })
        .then(function(results) {
          var dataMap = {};
          if (Array.isArray(results)) {
            results.forEach(function(r, i) {
              if (cities[i] && r.current) dataMap[cities[i].slug] = r;
            });
          } else if (results && results.current) {
            // Single location response
            dataMap[cities[0].slug] = results;
          }

          var now = Date.now();
          localStorage.setItem(CACHE_KEY, JSON.stringify({ d: dataMap, ts: now }));
          Object.keys(dataMap).forEach(function(slug) { updateCity(slug, dataMap[slug]); });
          showUpdated(now);
        })
        .catch(function() {});
    }

    refresh();
  })();
</script>
