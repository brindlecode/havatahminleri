---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PopularCities from '../components/PopularCities.astro';
import AdSlot from '../components/AdSlot.astro';
import { getHomeSEO, generateStructuredData } from '../lib/seo';
import { fetchWeatherData } from '../lib/weather';
import provinces from '../data/provinces.json';
import regions from '../data/regions.json';

const seo = getHomeSEO();
const structuredData = generateStructuredData('home', {
  name: seo.title,
  description: seo.description,
  url: seo.canonical,
});

// Fetch weather for popular cities at build time
const popularProvinces = provinces.filter((p: any) => p.popular);
const popularCitiesWeather = await Promise.all(
  popularProvinces.map(async (p: any) => {
    try {
      const weather = await fetchWeatherData(p.lat, p.lon);
      return {
        name: p.name,
        slug: p.slug,
        lat: p.lat,
        lon: p.lon,
        temperature: weather.current.temperature,
        weatherCode: weather.current.weatherCode,
        max: weather.daily.temperatureMax[0],
        min: weather.daily.temperatureMin[0],
      };
    } catch {
      return {
        name: p.name,
        slug: p.slug,
        lat: p.lat,
        lon: p.lon,
        temperature: 0,
        weatherCode: 0,
        max: 0,
        min: 0,
      };
    }
  }),
);

const regionGroups = regions.map((r: any) => ({
  ...r,
  provinces: provinces.filter((p: any) => p.region === r.id),
}));
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  structuredData={structuredData}
>
  <Header slot="header" />

  <section class="sky sky-clear-day">
    <div class="max-w-6xl mx-auto px-4 pt-10 pb-12 sm:pt-16 sm:pb-16">
      <h1 class="text-[2rem] sm:text-5xl font-bold tracking-tight leading-[1.1] max-w-2xl">
        Türkiye Hava Durumu
      </h1>
      <p class="mt-3 text-base sm:text-lg text-white/85 max-w-xl">
        81 il ve 969 ilçe için bugün, yarın, saatlik ve 15 günlük tahmin. Her gece yarısından sonra güncellenir.
      </p>
      <div class="mt-6 max-w-lg relative" role="search">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"/>
        </svg>
        <input
          type="search"
          id="hero-search"
          placeholder="İl veya ilçe adı yazın"
          aria-label="İl veya ilçe ara"
          autocomplete="off"
          data-search-input
          data-search-target="hero-search-results"
          data-search-theme="hero"
          class="w-full h-14 pl-12 pr-4 rounded-2xl bg-white text-slate-900 placeholder:text-slate-400 shadow-[0_10px_30px_rgba(0,0,0,0.15)] text-base focus:outline-none focus:ring-4 focus:ring-white/40"
        />
        <div id="hero-search-results" class="absolute top-full left-0 right-0 mt-2 bg-white dark:bg-slate-800 rounded-2xl shadow-xl overflow-hidden hidden z-50 max-h-72 overflow-y-auto border border-slate-200 dark:border-slate-700"></div>
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 py-8 space-y-10">
    <AdSlot slot="header" id="home-top" />

    <PopularCities cities={popularCitiesWeather} />

    <AdSlot slot="inContent" id="home-mid" />

    <section>
      <h2 class="text-xl font-bold tracking-tight mb-3">Bölgelere Göre İller</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {regionGroups.map((region: any) => (
          <div class="weather-card">
            <h3 class="text-sm font-semibold text-[var(--color-text-secondary)] mb-2.5">{region.name}</h3>
            <div class="flex flex-wrap gap-1.5">
              {region.provinces.map((p: any) => (
                <a href={`/${p.slug}-hava-durumu/`} class="px-3 py-1.5 rounded-full bg-[var(--color-surface-2)] text-[0.85rem] font-medium hover:text-[var(--color-accent)] transition-colors">
                  {p.name}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <AdSlot slot="footer" id="home-bottom" />

    <section class="weather-card max-w-3xl">
      <h2 class="section-title">Türkiye Hava Durumu Tahmini</h2>
      <div class="prose-text space-y-3 text-[var(--color-text-secondary)]">
        <p>
          YarınHava.com, Türkiye'nin 81 ili ve 969 ilçesi için güncel hava durumu bilgisini ve 15 günlük
          tahminleri sunar. Tahminler her gün gece yarısından sonra yenilenir; sayfalardaki "şu an" değeri,
          ziyaret ettiğiniz saatin tahminini gösterir.
        </p>
        <p>
          Saatlik sıcaklık, yağış olasılığı, rüzgar hızı ve yönü, nem, UV indeksi, basınç ve görüş mesafesi
          gibi verilere tek sayfada ulaşabilirsiniz.
        </p>
        <p>
          Veriler <a href="https://open-meteo.com/" rel="noopener">Open-Meteo</a> aracılığıyla NOAA GFS, DWD ICON ve
          ECMWF IFS gibi uluslararası tahmin modellerinden alınır. Resmi uyarılar için Meteoroloji Genel Müdürlüğü'nü takip edin.
        </p>
      </div>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<!-- Hero search behavior is handled by /scripts/search.js (loaded in Header.astro). -->
