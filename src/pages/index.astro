---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PopularCities from '../components/PopularCities.astro';
import AdSlot from '../components/AdSlot.astro';
import { getHomeSEO, generateStructuredData } from '../lib/seo';
import { fetchWeatherData } from '../lib/weather';
import provinces from '../data/provinces.json';
import regions from '../data/regions.json';

const seo = getHomeSEO();
const structuredData = generateStructuredData('home', {
  name: seo.title,
  description: seo.description,
  url: seo.canonical,
});

// Fetch weather for popular cities at build time
const popularProvinces = provinces.filter((p: any) => p.popular);
const popularCitiesWeather = await Promise.all(
  popularProvinces.map(async (p: any) => {
    try {
      const weather = await fetchWeatherData(p.lat, p.lon);
      return {
        name: p.name,
        slug: p.slug,
        temperature: weather.current.temperature,
        weatherCode: weather.current.weatherCode,
        max: weather.daily.temperatureMax[0],
        min: weather.daily.temperatureMin[0],
      };
    } catch {
      return {
        name: p.name,
        slug: p.slug,
        temperature: 0,
        weatherCode: 0,
        max: 0,
        min: 0,
      };
    }
  }),
);

const regionGroups = regions.map((r: any) => ({
  ...r,
  provinces: provinces.filter((p: any) => p.region === r.id),
}));
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  structuredData={structuredData}
>
  <Header slot="header" />

  <!-- Hero -->
  <div class="gradient-sky dark:gradient-night text-white py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-3">
        Türkiye Hava Durumu
      </h1>
      <p class="text-lg md:text-xl opacity-90 mb-6">
        81 il ve tüm ilçeler için 15 günlük detaylı hava tahmini
      </p>
      <div class="max-w-md mx-auto relative">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input
          type="text"
          id="hero-search"
          placeholder="Şehir veya ilçe ara..."
          autocomplete="off"
          class="w-full pl-12 pr-4 py-3.5 rounded-2xl bg-white/95 dark:bg-slate-800/95 text-slate-900 dark:text-white placeholder:text-slate-400 shadow-lg text-base focus:outline-none focus:ring-2 focus:ring-white/50"
        />
        <div id="hero-search-results" class="absolute top-full left-0 right-0 mt-2 bg-white dark:bg-slate-800 rounded-2xl shadow-lg overflow-hidden hidden z-50 max-h-60 overflow-y-auto border border-slate-200 dark:border-slate-700">
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 py-8">
    <AdSlot id="home-top" />

    <!-- Popular Cities -->
    <PopularCities cities={popularCitiesWeather} />

    <AdSlot id="home-mid" />

    <!-- Regions -->
    <section class="mt-10">
      <h2 class="text-xl font-bold mb-6">Bölgelere Göre Hava Durumu</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {regionGroups.map((region: any) => (
          <div class="weather-card">
            <h3 class="text-sm font-semibold text-primary-600 dark:text-primary-400 mb-3">
              {region.name}
            </h3>
            <div class="grid grid-cols-2 gap-2">
              {region.provinces.slice(0, 8).map((p: any) => (
                <a
                  href={`/${p.slug}-hava-durumu`}
                  class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-[var(--color-bg)] transition-colors"
                >
                  <svg class="w-3.5 h-3.5 text-[var(--color-text-secondary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  </svg>
                  <span class="text-sm">{p.name}</span>
                </a>
              ))}
            </div>
            {region.provinces.length > 8 && (
              <p class="text-xs text-[var(--color-text-secondary)] mt-2 text-center">
                ve {region.provinces.length - 8} il daha...
              </p>
            )}
          </div>
        ))}
      </div>
    </section>

    <AdSlot id="home-bottom" />

    <!-- SEO content -->
    <section class="mt-10 prose prose-slate dark:prose-invert max-w-none">
      <h2 class="text-xl font-bold mb-4">Türkiye Hava Durumu Tahmini</h2>
      <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
        HavaTahminleri.com olarak Türkiye'nin 81 ili ve tüm ilçeleri için güncel hava durumu
        bilgilerini ve 15 günlük detaylı hava tahminlerini sunuyoruz. Saatlik sıcaklık değişimleri,
        yağış olasılıkları, rüzgar hızı ve yönü, nem oranı, UV indeksi gibi kapsamlı meteorolojik
        verilere anında erişebilirsiniz. İster tatil planı yapıyor olun, ister günlük aktivitelerinizi
        planlayın — doğru hava tahmini ile her zaman hazırlıklı olun.
      </p>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  // Hero search - loads provinces inline + districts from search-index.json
  let heroItems = [];
  let heroDistrictsLoaded = false;
  const heroInput = document.getElementById('hero-search');
  const heroResults = document.getElementById('hero-search-results');

  function normalize(str) {
    return str.toLowerCase()
      .replace(/ğ/g, 'g').replace(/ü/g, 'u').replace(/ş/g, 's')
      .replace(/ı/g, 'i').replace(/ö/g, 'o').replace(/ç/g, 'c')
      .replace(/â/g, 'a').replace(/î/g, 'i').replace(/û/g, 'u');
  }

  async function loadHeroSearch() {
    if (heroDistrictsLoaded) return;
    try {
      const res = await fetch('/search-index.json');
      if (res.ok) {
        const districts = await res.json();
        heroItems = districts;
        heroDistrictsLoaded = true;
      }
    } catch {}
  }

  heroInput.addEventListener('focus', loadHeroSearch);

  heroInput.addEventListener('input', async (e) => {
    const query = normalize(e.target.value.trim());
    if (query.length < 2) { heroResults.classList.add('hidden'); return; }

    await loadHeroSearch();

    const matches = heroItems.filter(c => normalize(c.n).includes(query)).slice(0, 8);
    if (matches.length === 0) {
      heroResults.innerHTML = '<div class="px-4 py-3 text-sm text-slate-400">Sonuç bulunamadı</div>';
    } else {
      heroResults.innerHTML = matches.map(c =>
        `<a href="${c.u}" class="flex items-center gap-3 px-4 py-3 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors text-slate-700 dark:text-slate-200">
          <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
          <div>
            <span class="text-sm font-medium">${c.n}</span>
            <span class="text-xs text-slate-400 ml-1">${c.t === 'ilce' ? '(İlçe)' : '(İl)'}</span>
          </div>
        </a>`
      ).join('');
    }
    heroResults.classList.remove('hidden');
  });

  document.addEventListener('click', (e) => {
    if (!heroInput.parentElement.contains(e.target)) {
      heroResults.classList.add('hidden');
    }
  });
</script>
