---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PopularCities from '../components/PopularCities.astro';
import AdSlot from '../components/AdSlot.astro';
import { getHomeSEO, generateStructuredData } from '../lib/seo';
import { fetchWeatherData } from '../lib/weather';
import provinces from '../data/provinces.json';
import regions from '../data/regions.json';

const seo = getHomeSEO();
const structuredData = generateStructuredData('home', {
  name: seo.title,
  description: seo.description,
  url: seo.canonical,
});

// Fetch weather for popular cities at build time
const popularProvinces = provinces.filter((p: any) => p.popular);
const popularCitiesWeather = await Promise.all(
  popularProvinces.map(async (p: any) => {
    try {
      const weather = await fetchWeatherData(p.lat, p.lon);
      return {
        name: p.name,
        slug: p.slug,
        lat: p.lat,
        lon: p.lon,
        temperature: weather.current.temperature,
        weatherCode: weather.current.weatherCode,
        max: weather.daily.temperatureMax[0],
        min: weather.daily.temperatureMin[0],
      };
    } catch {
      return {
        name: p.name,
        slug: p.slug,
        lat: p.lat,
        lon: p.lon,
        temperature: 0,
        weatherCode: 0,
        max: 0,
        min: 0,
      };
    }
  }),
);

const regionGroups = regions.map((r: any) => ({
  ...r,
  provinces: provinces.filter((p: any) => p.region === r.id),
}));
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  structuredData={structuredData}
>
  <Header slot="header" />

  <!-- Hero -->
  <div class="gradient-sky dark:gradient-night text-white py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-3">
        Türkiye Hava Durumu
      </h1>
      <p class="text-lg md:text-xl opacity-90 mb-6">
        81 il ve tüm ilçeler için 15 günlük detaylı hava tahmini
      </p>
      <div class="max-w-md mx-auto relative" role="search">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input
          type="text"
          id="hero-search"
          placeholder="Şehir veya ilçe ara..."
          aria-label="Şehir veya ilçe ara"
          autocomplete="off"
          data-search-input
          data-search-target="hero-search-results"
          data-search-theme="hero"
          class="w-full pl-12 pr-4 py-3.5 rounded-2xl bg-white/95 dark:bg-slate-800/95 text-slate-900 dark:text-white placeholder:text-slate-400 shadow-lg text-base focus:outline-none focus:ring-2 focus:ring-white/50"
        />
        <div id="hero-search-results" class="absolute top-full left-0 right-0 mt-2 bg-white dark:bg-slate-800 rounded-2xl shadow-lg overflow-hidden hidden z-50 max-h-60 overflow-y-auto border border-slate-200 dark:border-slate-700">
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 py-8">
    <AdSlot slot="header" id="home-top" />

    <!-- Popular Cities -->
    <PopularCities cities={popularCitiesWeather} />

    <AdSlot slot="inContent" id="home-mid" />

    <!-- Regions -->
    <section class="mt-10">
      <h2 class="text-xl font-bold mb-6">Bölgelere Göre İller</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {regionGroups.map((region: any) => (
          <div class="weather-card">
            <h3 class="text-sm font-semibold text-primary-600 dark:text-primary-400 mb-3">
              {region.name}
            </h3>
            <div class="grid grid-cols-2 gap-2">
              {(() => {
                const popular = region.provinces.filter((p: any) => p.popular);
                const featured = (popular.length >= 4 ? popular : region.provinces).slice(0, 6);
                return featured.map((p: any) => (
                  <a
                    href={`/${p.slug}-hava-durumu/`}
                    class="px-2 py-1.5 rounded-lg hover:bg-[var(--color-bg)] transition-colors text-sm"
                  >
                    {p.name}
                  </a>
                ));
              })()}
            </div>
          </div>
        ))}
      </div>
    </section>

    <AdSlot slot="footer" id="home-bottom" />

    <!-- SEO content -->
    <section class="mt-10 max-w-none space-y-4">
      <h2 class="text-xl font-bold">Türkiye Hava Durumu Tahmini</h2>
      <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
        YarınHava.com olarak Türkiye'nin 81 ili ve tüm ilçeleri için güncel hava durumu
        bilgilerini ve 15 günlük detaylı tahminleri sunuyoruz. Tahminler her gün gece yarısından
        sonra yenilenir.
      </p>

      <h3 class="text-base font-semibold mt-6">Hangi verileri sunuyoruz?</h3>
      <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
        Saatlik sıcaklık değişimleri, yağış olasılıkları, rüzgar hızı ve yönü, nem oranı,
        UV indeksi, basınç ve görüş mesafesi gibi kapsamlı meteorolojik verilere anında
        erişebilirsiniz.
      </p>

      <h3 class="text-base font-semibold mt-6">Veri Kaynaklarımız</h3>
      <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
        Hava durumu verileri <a href="https://open-meteo.com/" rel="noopener" class="underline">Open-Meteo</a>
        aracılığıyla NOAA GFS, DWD ICON ve ECMWF IFS gibi dünya çapında kabul görmüş meteorolojik
        tahmin modellerinden alınmaktadır.
      </p>

      <h3 class="text-base font-semibold mt-6">Kim için faydalı?</h3>
      <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
        İster tatil planı yapıyor olun, ister günlük aktivitelerinizi planlayın — doğru hava
        tahmini ile her zaman hazırlıklı olun.
      </p>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<!-- Hero search behavior is handled by /scripts/search.js (loaded in Header.astro). -->
