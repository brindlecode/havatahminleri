---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import provinces from '../data/provinces.json';

const title = 'Sayfa Bulunamadı | Yarın Hava';
const description = 'Aradığınız sayfa mevcut değil veya taşınmış olabilir. Yarın Hava ana sayfasına dönerek 81 il ve tüm ilçeler için hava durumuna ulaşabilirsiniz.';

const popularCities = (provinces as any[]).filter((p) => p.popular).slice(0, 8);
---

<BaseLayout title={title} description={description} noindex>
  <Header slot="header" />

  <div class="max-w-3xl mx-auto px-4 py-16 text-center">
    <p class="text-7xl font-extralight tracking-tighter text-[var(--color-accent)] mb-4">404</p>
    <h1 class="text-3xl font-bold mb-4">Sayfa bulunamadı</h1>
    <p class="text-[var(--color-text-secondary)] mb-8">
      Aradığınız sayfa mevcut değil veya taşınmış olabilir. URL'yi kontrol etmenizi ya da
      ana sayfa üzerinden aramanızı öneririz.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3 mb-12">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[var(--color-text)] text-[var(--color-bg)] font-semibold hover:opacity-90 transition"
      >
        Ana Sayfaya Dön
      </a>
    </div>

    <section class="text-left">
      <h2 class="text-lg font-semibold mb-3 text-center">Popüler Şehirler</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
        {popularCities.map((p: any) => (
          <a
            href={`/${p.slug}-hava-durumu/`}
            class="px-3 py-2 chip-link justify-center transition-colors text-sm font-medium text-center"
          >
            {p.name}
          </a>
        ))}
      </div>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
