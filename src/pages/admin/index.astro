---
// Admin panel - CMS-style sidebar layout
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin Panel | Yarın Hava</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: 'Inter', sans-serif; background: #0f172a; color: #e2e8f0; min-height: 100vh; }
      .hidden { display: none !important; }

      /* ── Login Screen ── */
      .login-screen { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 2rem; }
      .login-card { text-align: center; max-width: 400px; width: 100%; }
      .login-card .lock-icon { margin-bottom: 1.5rem; opacity: 0.4; }
      .login-card h2 { font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem; }
      .login-card p { color: #94a3b8; font-size: 0.875rem; margin-bottom: 2rem; line-height: 1.5; }
      .login-btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: #1e293b; border: 1px solid #334155; border-radius: 0.75rem; color: white; font-size: 0.875rem; font-weight: 500; cursor: pointer; transition: all 0.2s; text-decoration: none; }
      .login-btn:hover { background: #334155; border-color: #475569; }
      .login-btn svg { width: 20px; height: 20px; }

      /* ── Top Header Bar ── */
      .top-header { position: fixed; top: 0; left: 0; right: 0; height: 56px; background: #1e293b; border-bottom: 1px solid #334155; display: flex; align-items: center; justify-content: space-between; padding: 0 1.5rem; z-index: 200; }
      .top-header-left { display: flex; align-items: center; gap: 0.75rem; }
      .top-header-left .logo { font-size: 1rem; font-weight: 700; color: #f1f5f9; }
      .top-header-left .logo span { color: #3b82f6; }
      .top-header-right { display: flex; align-items: center; gap: 1rem; }
      .top-header-right .user-pill { display: flex; align-items: center; gap: 0.5rem; padding: 0.25rem 0.75rem 0.25rem 0.25rem; background: #0f172a; border: 1px solid #334155; border-radius: 2rem; }
      .top-header-right .user-pill img { width: 24px; height: 24px; border-radius: 50%; }
      .top-header-right .user-pill span { font-size: 0.75rem; color: #cbd5e1; }
      .logout-btn { font-size: 0.7rem; color: #94a3b8; cursor: pointer; background: none; border: 1px solid #334155; border-radius: 0.375rem; padding: 0.3rem 0.6rem; transition: all 0.15s; }
      .logout-btn:hover { color: #ef4444; border-color: #ef4444; }

      /* ── Mobile hamburger ── */
      .hamburger { display: none; background: none; border: none; color: #e2e8f0; font-size: 1.25rem; cursor: pointer; padding: 0.25rem 0.5rem; border-radius: 0.375rem; }
      .hamburger:hover { background: rgba(255,255,255,0.05); }

      /* ── Layout ── */
      .admin-shell { display: flex; padding-top: 56px; min-height: 100vh; }

      /* ── Sidebar ── */
      .sidebar { width: 220px; background: #1e293b; border-right: 1px solid #334155; position: fixed; top: 56px; bottom: 0; left: 0; display: flex; flex-direction: column; overflow-y: auto; z-index: 100; }
      .sidebar-nav { flex: 1; padding: 0.5rem 0; }
      .nav-item { display: flex; align-items: center; gap: 0.625rem; width: 100%; padding: 0.7rem 1.25rem; background: none; border: none; border-left: 3px solid transparent; color: #94a3b8; font-size: 0.8125rem; font-family: inherit; cursor: pointer; text-align: left; transition: all 0.15s; }
      .nav-item:hover { color: #e2e8f0; background: rgba(255,255,255,0.03); }
      .nav-item.active { color: #3b82f6; border-left-color: #3b82f6; background: rgba(59,130,246,0.06); font-weight: 500; }
      .nav-item .nav-icon { width: 18px; height: 18px; opacity: 0.7; flex-shrink: 0; }
      .nav-item.active .nav-icon { opacity: 1; }
      .sidebar-bottom { padding: 1rem 1.25rem; border-top: 1px solid #334155; }
      .sidebar-bottom a { color: #64748b; text-decoration: none; font-size: 0.8rem; display: flex; align-items: center; gap: 0.5rem; transition: color 0.15s; }
      .sidebar-bottom a:hover { color: #94a3b8; }

      /* ── Sidebar overlay (mobile) ── */
      .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 99; }
      .sidebar-overlay.open { display: block; }

      /* ── Main Content ── */
      .main-content { flex: 1; margin-left: 220px; padding: 2rem 2.5rem; max-width: 900px; }
      .tab-panel { display: none; }
      .tab-panel.active { display: block; }

      /* ── Panel Header ── */
      .panel-header { margin-bottom: 2rem; }
      .panel-header h1 { font-size: 1.375rem; font-weight: 700; margin-bottom: 0.25rem; }
      .panel-header p { font-size: 0.8125rem; color: #64748b; }

      /* ── Stats Grid ── */
      .stats-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
      .stat-card { background: #1e293b; border: 1px solid #334155; border-radius: 0.75rem; padding: 1.25rem; }
      .stat-card .stat-label { font-size: 0.6875rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.5rem; }
      .stat-card .stat-value { font-size: 1.5rem; font-weight: 700; color: #f1f5f9; }
      .stat-card .stat-sub { font-size: 0.6875rem; color: #475569; margin-top: 0.375rem; }

      /* ── Section Card ── */
      .card { background: #1e293b; border: 1px solid #334155; border-radius: 0.75rem; padding: 1.5rem; margin-bottom: 1.5rem; }
      .card-title { font-size: 0.9375rem; font-weight: 600; margin-bottom: 0.25rem; }
      .card-desc { font-size: 0.8125rem; color: #64748b; margin-bottom: 1.25rem; }

      /* ── Form Field (StayAtNiche style: label floating on border) ── */
      .field { position: relative; margin-bottom: 1.5rem; }
      .field label { position: absolute; top: -0.5rem; left: 0.75rem; background: #1e293b; padding: 0 0.375rem; font-size: 0.6875rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.03em; z-index: 1; pointer-events: none; }
      .field input, .field select { width: 100%; padding: 0.875rem 1rem; border: 1px solid #334155; border-radius: 0.5rem; background: transparent; color: #e2e8f0; font-size: 0.875rem; font-family: inherit; transition: border-color 0.15s; }
      .field input:focus, .field select:focus { outline: none; border-color: #3b82f6; }
      .field .hint { font-size: 0.6875rem; color: #475569; margin-top: 0.375rem; padding-left: 0.125rem; }
      .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

      /* ── Toggle Switch ── */
      .toggle-row { display: flex; align-items: center; justify-content: space-between; padding: 0.875rem 1rem; border: 1px solid #334155; border-radius: 0.5rem; margin-bottom: 1.5rem; }
      .toggle-row .toggle-label { font-size: 0.875rem; }
      .toggle { position: relative; width: 44px; height: 24px; flex-shrink: 0; }
      .toggle input { opacity: 0; width: 0; height: 0; }
      .toggle .slider { position: absolute; inset: 0; background: #334155; border-radius: 24px; cursor: pointer; transition: 0.2s; }
      .toggle .slider::before { content: ''; position: absolute; width: 18px; height: 18px; left: 3px; bottom: 3px; background: white; border-radius: 50%; transition: 0.2s; }
      .toggle input:checked + .slider { background: #3b82f6; }
      .toggle input:checked + .slider::before { transform: translateX(20px); }

      /* ── Buttons ── */
      .btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.625rem 1.25rem; border-radius: 0.5rem; border: none; font-size: 0.8125rem; font-weight: 500; font-family: inherit; cursor: pointer; transition: all 0.15s; }
      .btn-primary { background: #3b82f6; color: white; }
      .btn-primary:hover { background: #2563eb; }
      .btn-save { background: #059669; color: white; }
      .btn-save:hover { background: #047857; }
      .btn:disabled { opacity: 0.5; cursor: not-allowed; }

      /* ── Status Badge ── */
      .badge { display: inline-flex; align-items: center; gap: 0.375rem; font-size: 0.75rem; padding: 0.25rem 0.625rem; border-radius: 2rem; }
      .badge-ok { background: rgba(52,211,153,0.1); color: #34d399; border: 1px solid rgba(52,211,153,0.2); }
      .badge-warn { background: rgba(251,191,36,0.1); color: #fbbf24; border: 1px solid rgba(251,191,36,0.2); }
      .badge-error { background: rgba(252,165,165,0.1); color: #fca5a5; border: 1px solid rgba(252,165,165,0.2); }

      /* ── API Status Row ── */
      .api-row { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
      .api-row .api-label { font-size: 0.875rem; color: #94a3b8; }
      .api-row .btn { margin-left: auto; }

      /* ── Build Runs ── */
      .build-runs { margin-top: 1.25rem; }
      .build-run { display: flex; align-items: center; gap: 0.75rem; padding: 0.625rem 0; border-bottom: 1px solid rgba(51,65,85,0.5); font-size: 0.8125rem; }
      .build-run:last-child { border-bottom: none; }
      .run-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
      .run-dot.success { background: #34d399; }
      .run-dot.failure { background: #ef4444; }
      .run-dot.in_progress { background: #fbbf24; animation: pulse 1s infinite; }
      .run-dot.queued { background: #64748b; }
      .run-info { flex: 1; }
      .run-info a { color: #60a5fa; text-decoration: none; font-weight: 500; }
      .run-info a:hover { text-decoration: underline; }
      .run-info .run-meta { color: #64748b; margin-left: 0.5rem; }
      .run-time { color: #475569; font-size: 0.75rem; }
      @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

      /* ── Save Row ── */
      .save-row { display: flex; align-items: center; gap: 1rem; margin-top: 0.5rem; padding-top: 1.25rem; border-top: 1px solid #334155; }
      .save-status { font-size: 0.8125rem; color: #64748b; }

      /* ── Responsive ── */
      @media (max-width: 768px) {
        .hamburger { display: block; }
        .sidebar { transform: translateX(-100%); transition: transform 0.2s ease; top: 56px; }
        .sidebar.open { transform: translateX(0); }
        .main-content { margin-left: 0; padding: 1.5rem 1rem; }
        .stats-grid { grid-template-columns: repeat(2, 1fr); }
        .field-row { grid-template-columns: 1fr; }
      }
      @media (max-width: 480px) {
        .stats-grid { grid-template-columns: 1fr; }
        .top-header { padding: 0 0.75rem; }
      }
    </style>
  </head>
  <body>

    <!-- ── Login Screen ── -->
    <div id="login-screen" class="login-screen">
      <div class="login-card">
        <svg class="lock-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>
        </svg>
        <h2>Admin Paneli</h2>
        <p>Devam etmek için GitHub hesabınızla giriş yapın</p>
        <a id="github-login-btn" class="login-btn" href="#">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          GitHub ile Giriş Yap
        </a>
      </div>
    </div>

    <!-- ── Top Header Bar ── -->
    <div id="top-header" class="top-header hidden">
      <div class="top-header-left">
        <button class="hamburger" id="hamburger-btn">&#9776;</button>
        <div class="logo">☁ Yarın <span>Hava</span> Admin</div>
      </div>
      <div class="top-header-right" id="header-user"></div>
    </div>

    <!-- Sidebar overlay (mobile) -->
    <div id="sidebar-overlay" class="sidebar-overlay"></div>

    <!-- ── Admin Shell ── -->
    <div id="admin-shell" class="admin-shell hidden">

      <!-- ── Left Sidebar (250px, dark) ── -->
      <aside class="sidebar" id="sidebar" style="width:250px;">
        <!-- Logo / Title -->
        <div style="padding:1.25rem 1.25rem 1rem;border-bottom:1px solid #334155;">
          <div style="font-size:1.125rem;font-weight:700;color:#f1f5f9;">☁ Yarın <span style="color:#3b82f6;">Hava</span></div>
          <div style="font-size:0.6875rem;color:#64748b;margin-top:0.25rem;text-transform:uppercase;letter-spacing:0.05em;">Admin Panel</div>
        </div>

        <!-- Navigation -->
        <nav class="sidebar-nav" id="sidebar-nav">
          <button class="nav-item active" data-tab="overview">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22"/></svg>
            GitHub
          </button>
          <button class="nav-item" data-tab="api">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            Auth
          </button>
          <button class="nav-item" data-tab="build">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
            Build
          </button>
          <button class="nav-item" data-tab="seo">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M9 14l2 2 4-4"/></svg>
            Routing
          </button>
          <button class="nav-item" data-tab="analytics">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
            Site Settings
          </button>
        </nav>

        <!-- Back to site -->
        <div class="sidebar-bottom">
          <a href="/">&#8592; Siteye Dön</a>
        </div>
      </aside>

      <!-- ── Main Content Area ── -->
      <main class="main-content" style="margin-left:250px;">

        <!-- ═══ GitHub Panel ═══ -->
        <div id="panel-overview" class="tab-panel active">
          <div class="panel-header">
            <h1>GitHub</h1>
            <p>Repo durumu, istatistikler ve genel bakış</p>
          </div>

          <!-- Stats Summary -->
          <div class="stats-grid" id="stats-grid">
            <div class="stat-card"><div class="stat-label">Yükleniyor</div><div class="stat-value">—</div></div>
          </div>

          <!-- Repo Info Card -->
          <div class="card">
            <div class="card-title">Repo Bilgisi</div>
            <div class="card-desc">ilkukaya/havatahminleri</div>
            <div class="api-row">
              <span class="api-label">Bağlantı:</span>
              <span class="badge badge-ok">Bağlı</span>
            </div>
          </div>
        </div>

        <!-- ═══ Auth Panel ═══ -->
        <div id="panel-api" class="tab-panel">
          <div class="panel-header">
            <h1>Auth</h1>
            <p>Kimlik doğrulama ve API bağlantı durumu</p>
          </div>

          <div class="card">
            <div class="card-title">Open-Meteo API</div>
            <div class="card-desc">Hava durumu verilerinin kaynağı</div>
            <div class="api-row">
              <span class="api-label">Durum:</span>
              <span class="badge badge-warn" id="api-status">Kontrol ediliyor...</span>
              <button class="btn btn-primary" id="check-api-btn">Kontrol Et</button>
            </div>
          </div>
        </div>

        <!-- ═══ Build Panel ═══ -->
        <div id="panel-build" class="tab-panel">
          <div class="panel-header">
            <h1>Build</h1>
            <p>GitHub Actions ile site derleme işlemleri</p>
          </div>

          <div class="card">
            <div class="card-title">Manuel Build</div>
            <div class="card-desc">Otomatik: Her gün 06:00 ve 20:00 (TR). Manuel tetikleme için butonu kullanın.</div>
            <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
              <button class="btn btn-primary" id="trigger-build-btn">Build Tetikle</button>
              <span class="save-status" id="build-status"></span>
            </div>
          </div>

          <div class="card">
            <div class="card-title">Son Build'ler</div>
            <div class="build-runs" id="build-runs">
              <div style="color:#64748b;font-size:0.8125rem;">Yükleniyor...</div>
            </div>
          </div>
        </div>

        <!-- ═══ Routing Panel ═══ -->
        <div id="panel-seo" class="tab-panel">
          <div class="panel-header">
            <h1>Routing</h1>
            <p>SEO ayarları ve arama motoru doğrulama kodları</p>
          </div>

          <div class="card" id="seo-card">
            <div class="card-title">Arama Motoru Doğrulama</div>
            <div class="card-desc">Sitenizi arama motorlarında doğrulamak için meta tag değerlerini girin</div>
            <div class="field">
              <label>Google Search Console</label>
              <input type="text" id="cfg-vg" autocomplete="off" />
              <div class="hint">meta tag content değeri</div>
            </div>
            <div class="field-row">
              <div class="field">
                <label>Yandex Webmaster</label>
                <input type="text" id="cfg-vy" autocomplete="off" />
                <div class="hint">meta tag content değeri</div>
              </div>
              <div class="field">
                <label>Bing Webmaster</label>
                <input type="text" id="cfg-vb" autocomplete="off" />
                <div class="hint">meta tag content değeri</div>
              </div>
            </div>
            <div class="save-row">
              <button class="btn btn-save" id="save-seo-btn">Kaydet &amp; Build Tetikle</button>
              <span class="save-status" id="seo-status"></span>
            </div>
          </div>
        </div>

        <!-- ═══ Site Settings Panel ═══ -->
        <div id="panel-analytics" class="tab-panel">
          <div class="panel-header">
            <h1>Site Settings</h1>
            <p>Analitik, reklam ve site yapılandırma ayarları</p>
          </div>

          <!-- Analytics Card -->
          <div class="card" id="analytics-card">
            <div class="card-title">Analitik</div>
            <div class="card-desc">Ziyaretçi analiz araçları yapılandırması</div>
            <div class="field">
              <label>Google Analytics 4 ID</label>
              <input type="text" id="cfg-ga" autocomplete="off" />
              <div class="hint">G-XXXXXXXXXX</div>
            </div>
            <div class="field">
              <label>Yandex Metrica ID</label>
              <input type="text" id="cfg-ym" autocomplete="off" />
              <div class="hint">12345678</div>
            </div>
            <div class="save-row">
              <button class="btn btn-save" id="save-analytics-btn">Kaydet &amp; Build Tetikle</button>
              <span class="save-status" id="analytics-status"></span>
            </div>
          </div>

          <!-- Ads Card -->
          <div class="card" id="ads-card">
            <div class="card-title">Reklamlar</div>
            <div class="card-desc">Google AdSense yapılandırması</div>
            <div class="toggle-row">
              <span class="toggle-label">Reklamlar aktif</span>
              <label class="toggle">
                <input type="checkbox" id="cfg-ads-enabled" />
                <span class="slider"></span>
              </label>
            </div>
            <div class="field">
              <label>AdSense Publisher ID</label>
              <input type="text" id="cfg-ads-pub" autocomplete="off" />
              <div class="hint">ca-pub-1234567890</div>
            </div>
            <div class="field-row">
              <div class="field">
                <label>Header Slot</label>
                <input type="text" id="cfg-ads-header" autocomplete="off" />
              </div>
              <div class="field">
                <label>Sidebar Slot</label>
                <input type="text" id="cfg-ads-sidebar" autocomplete="off" />
              </div>
            </div>
            <div class="field-row">
              <div class="field">
                <label>İçerik İçi Slot</label>
                <input type="text" id="cfg-ads-incontent" autocomplete="off" />
              </div>
              <div class="field">
                <label>Footer Slot</label>
                <input type="text" id="cfg-ads-footer" autocomplete="off" />
              </div>
            </div>
            <div class="save-row">
              <button class="btn btn-save" id="save-ads-btn">Kaydet &amp; Build Tetikle</button>
              <span class="save-status" id="ads-status"></span>
            </div>
          </div>
        </div>

        <!-- Hidden panel placeholder for JS compatibility (ads tab) -->
        <div id="panel-ads" class="tab-panel">
          <div class="panel-header">
            <h1>Reklamlar</h1>
            <p>Reklam ayarları Site Settings bölümünden yönetilmektedir.</p>
          </div>
        </div>

      </main>
    </div>

    <script src="/src/scripts/admin.js"></script>
  </body>
</html>
