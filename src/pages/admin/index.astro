---
// Admin panel - no server-side data exposed, everything loaded client-side after auth
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin Panel | Yarın Hava</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: 'Inter', sans-serif; background: #0f172a; color: #e2e8f0; min-height: 100vh; }
      .container { max-width: 900px; margin: 0 auto; padding: 2rem 1rem; }
      .header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem; }
      .header h1 { font-size: 1.5rem; font-weight: 700; }
      .header a { color: #60a5fa; text-decoration: none; font-size: 0.875rem; }
      .login-section { text-align: center; padding: 6rem 1rem; }
      .login-btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: #1e293b; border: 1px solid #334155; border-radius: 0.75rem; color: white; font-size: 0.875rem; font-weight: 500; cursor: pointer; transition: background 0.2s; text-decoration: none; }
      .login-btn:hover { background: #334155; }
      .login-btn svg { width: 20px; height: 20px; }
      .hidden { display: none !important; }
      .section { background: #1e293b; border: 1px solid #334155; border-radius: 1rem; padding: 1.5rem; margin-bottom: 1.5rem; }
      .section h2 { font-size: 1rem; font-weight: 600; margin-bottom: 1rem; }
      .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
      .stat-card { background: #1e293b; border: 1px solid #334155; border-radius: 1rem; padding: 1.25rem; }
      .stat-card .label { font-size: 0.75rem; color: #94a3b8; margin-bottom: 0.25rem; }
      .stat-card .value { font-size: 1.5rem; font-weight: 700; }
      .stat-card .sub { font-size: 0.65rem; color: #64748b; margin-top: 0.25rem; }
      .log-item { display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0; border-bottom: 1px solid #334155; font-size: 0.75rem; }
      .log-item:last-child { border-bottom: none; }
      .log-item .time { color: #64748b; }
      .log-item .action { color: #94a3b8; }
      .btn { padding: 0.5rem 1rem; border-radius: 0.5rem; border: none; font-size: 0.875rem; font-weight: 500; cursor: pointer; }
      .btn-primary { background: #3b82f6; color: white; }
      .btn-primary:hover { background: #2563eb; }
      .btn-success { background: #059669; color: white; }
      .btn-success:hover { background: #047857; }
      .btn-danger { background: #dc2626; color: white; }
      .btn-danger:hover { background: #b91c1c; }
      .btn:disabled { opacity: 0.5; cursor: not-allowed; }
      .status { display: inline-flex; align-items: center; gap: 0.375rem; font-size: 0.75rem; padding: 0.25rem 0.5rem; border-radius: 0.375rem; }
      .status-ok { background: #064e3b; color: #34d399; }
      .status-warn { background: #78350f; color: #fbbf24; }
      .status-error { background: #7f1d1d; color: #fca5a5; }
      .user-info { display: flex; align-items: center; gap: 0.75rem; }
      .user-info img { width: 32px; height: 32px; border-radius: 50%; }
      .logout-btn { font-size: 0.75rem; color: #ef4444; cursor: pointer; background: none; border: none; }
      .form-group { margin-bottom: 1rem; }
      .form-group label { display: block; font-size: 0.75rem; color: #94a3b8; margin-bottom: 0.25rem; }
      .form-group input { width: 100%; padding: 0.5rem 0.75rem; border-radius: 0.5rem; border: 1px solid #334155; background: #0f172a; color: white; font-size: 0.875rem; }
      .form-group input:focus { outline: none; border-color: #3b82f6; }
      .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
      .form-group .hint { font-size: 0.65rem; color: #64748b; margin-top: 0.25rem; }
      .toggle-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
      .toggle { position: relative; width: 44px; height: 24px; }
      .toggle input { opacity: 0; width: 0; height: 0; }
      .toggle .slider { position: absolute; inset: 0; background: #334155; border-radius: 24px; cursor: pointer; transition: 0.2s; }
      .toggle .slider:before { content: ''; position: absolute; width: 18px; height: 18px; left: 3px; bottom: 3px; background: white; border-radius: 50%; transition: 0.2s; }
      .toggle input:checked + .slider { background: #3b82f6; }
      .toggle input:checked + .slider:before { transform: translateX(20px); }
      .build-runs { margin-top: 1rem; }
      .build-run { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0; border-bottom: 1px solid #334155; font-size: 0.75rem; }
      .build-run:last-child { border-bottom: none; }
      .build-run .run-status { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
      .build-run .run-status.success { background: #34d399; }
      .build-run .run-status.failure { background: #ef4444; }
      .build-run .run-status.in_progress { background: #fbbf24; animation: pulse 1s infinite; }
      .build-run .run-status.queued { background: #64748b; }
      .build-run .run-info { flex: 1; }
      .build-run .run-time { color: #64748b; }
      @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
      @media (max-width: 640px) { .form-row { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Yarın Hava Admin</h1>
        <a href="/">← Siteye Dön</a>
      </div>

      <!-- Login -->
      <div id="login-section" class="login-section">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" style="margin: 0 auto 1rem;">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>
        </svg>
        <h2 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Admin Paneli</h2>
        <p style="color: #94a3b8; margin-bottom: 2rem; font-size: 0.875rem;">Devam etmek için GitHub hesabınızla giriş yapın</p>
        <a id="github-login-btn" class="login-btn" href="#">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          GitHub ile Giriş Yap
        </a>
      </div>

      <!-- Admin Content - rendered by JS only after auth -->
      <div id="admin-content" class="hidden"></div>
    </div>

    <script is:inline>
      const REPO_OWNER = 'ilkukaya';
      const REPO_NAME = 'havatahminleri';
      const CONFIG_PATH = 'src/data/site-config.json';
      const WORKFLOW_FILE = 'scheduled-build.yml';
      const ADMIN_USERS = ['ilkukaya'];
      const TOKEN_KEY = 'admin_gh_token';

      let currentToken = null;
      let currentConfig = null;
      let currentConfigSha = null;

      function sanitizeText(str) {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
      }

      function checkAuth() {
        const token = sessionStorage.getItem(TOKEN_KEY);
        if (token) validateToken(token);
      }

      async function validateToken(token) {
        if (!token || token.length < 10) {
          sessionStorage.removeItem(TOKEN_KEY);
          return;
        }
        try {
          const res = await fetch('https://api.github.com/user', {
            headers: { 'Authorization': 'token ' + token }
          });
          if (res.ok) {
            const user = await res.json();
            if (ADMIN_USERS.includes(user.login)) {
              currentToken = token;
              showAdmin(user);
              return;
            }
            alert('Bu GitHub hesabının admin yetkisi bulunmamaktadır.');
          }
          sessionStorage.removeItem(TOKEN_KEY);
        } catch {
          sessionStorage.removeItem(TOKEN_KEY);
        }
      }

      async function ghApi(path, options = {}) {
        const res = await fetch(`https://api.github.com${path}`, {
          ...options,
          headers: {
            'Authorization': 'token ' + currentToken,
            'Accept': 'application/vnd.github.v3+json',
            ...(options.headers || {}),
            ...(options.body ? { 'Content-Type': 'application/json' } : {})
          }
        });
        if (!res.ok) throw new Error(`GitHub API ${res.status}: ${await res.text()}`);
        return res.status === 204 ? null : res.json();
      }

      function createStatCard(label, value, sub) {
        const card = document.createElement('div');
        card.className = 'stat-card';
        const labelEl = document.createElement('div');
        labelEl.className = 'label';
        labelEl.textContent = label;
        const valueEl = document.createElement('div');
        valueEl.className = 'value';
        valueEl.textContent = value;
        card.appendChild(labelEl);
        card.appendChild(valueEl);
        if (sub) {
          const subEl = document.createElement('div');
          subEl.className = 'sub';
          subEl.textContent = sub;
          card.appendChild(subEl);
        }
        return card;
      }

      function createFormGroup(label, id, value, hint) {
        const group = document.createElement('div');
        group.className = 'form-group';
        const lbl = document.createElement('label');
        lbl.setAttribute('for', id);
        lbl.textContent = label;
        const input = document.createElement('input');
        input.type = 'text';
        input.id = id;
        input.value = value || '';
        input.autocomplete = 'off';
        group.appendChild(lbl);
        group.appendChild(input);
        if (hint) {
          const h = document.createElement('div');
          h.className = 'hint';
          h.textContent = hint;
          group.appendChild(h);
        }
        return group;
      }

      function showAdmin(user) {
        document.getElementById('login-section').classList.add('hidden');
        const content = document.getElementById('admin-content');
        content.classList.remove('hidden');
        content.replaceChildren();

        // User info section
        const userSection = document.createElement('div');
        userSection.className = 'section';
        userSection.style.cssText = 'display:flex;align-items:center;justify-content:space-between;';

        const userInfo = document.createElement('div');
        userInfo.className = 'user-info';
        const avatar = document.createElement('img');
        avatar.src = user.avatar_url;
        avatar.alt = sanitizeText(user.login);
        avatar.width = 32;
        avatar.height = 32;
        const username = document.createElement('span');
        username.textContent = user.login;
        const badge = document.createElement('span');
        badge.className = 'status status-ok';
        badge.textContent = 'Admin';
        userInfo.appendChild(avatar);
        userInfo.appendChild(username);
        userInfo.appendChild(badge);

        const logoutBtn = document.createElement('button');
        logoutBtn.className = 'logout-btn';
        logoutBtn.textContent = 'Çıkış Yap';
        logoutBtn.addEventListener('click', () => {
          sessionStorage.removeItem(TOKEN_KEY);
          location.reload();
        });

        userSection.appendChild(userInfo);
        userSection.appendChild(logoutBtn);

        // Stats grid
        const statsGrid = document.createElement('div');
        statsGrid.className = 'stats';
        statsGrid.id = 'stats-grid';
        statsGrid.appendChild(createStatCard('Yükleniyor...', '-'));

        // API status section
        const apiSection = document.createElement('div');
        apiSection.className = 'section';
        const apiTitle = document.createElement('h2');
        apiTitle.textContent = 'API Durumu';
        const apiRow = document.createElement('div');
        apiRow.style.cssText = 'display:flex;align-items:center;gap:1rem;flex-wrap:wrap;';
        const apiLabel = document.createElement('span');
        apiLabel.textContent = 'Open-Meteo API:';
        const apiStatus = document.createElement('span');
        apiStatus.id = 'api-status';
        apiStatus.className = 'status status-warn';
        apiStatus.textContent = 'Kontrol ediliyor...';
        const checkApiBtn = document.createElement('button');
        checkApiBtn.className = 'btn btn-primary';
        checkApiBtn.style.marginLeft = 'auto';
        checkApiBtn.textContent = 'Kontrol Et';
        checkApiBtn.addEventListener('click', checkAPI);
        apiRow.appendChild(apiLabel);
        apiRow.appendChild(apiStatus);
        apiRow.appendChild(checkApiBtn);
        apiSection.appendChild(apiTitle);
        apiSection.appendChild(apiRow);

        // Build section (GitHub Actions)
        const buildSection = document.createElement('div');
        buildSection.className = 'section';
        const buildTitle = document.createElement('h2');
        buildTitle.textContent = 'Build Yönetimi (GitHub Actions)';
        const buildDesc = document.createElement('p');
        buildDesc.style.cssText = 'font-size:0.875rem;color:#94a3b8;margin-bottom:1rem;';
        buildDesc.textContent = 'Otomatik: Her gün 06:00 ve 20:00 (TR). Manuel tetikleme için aşağıdaki butonu kullanın.';
        const buildBtnRow = document.createElement('div');
        buildBtnRow.style.cssText = 'display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;';
        const triggerBtn = document.createElement('button');
        triggerBtn.className = 'btn btn-primary';
        triggerBtn.id = 'trigger-build-btn';
        triggerBtn.textContent = 'Build Tetikle';
        triggerBtn.addEventListener('click', triggerBuild);
        const buildStatus = document.createElement('span');
        buildStatus.id = 'build-status';
        buildStatus.style.cssText = 'font-size:0.75rem;color:#94a3b8;';
        buildBtnRow.appendChild(triggerBtn);
        buildBtnRow.appendChild(buildStatus);
        buildSection.appendChild(buildTitle);
        buildSection.appendChild(buildDesc);
        buildSection.appendChild(buildBtnRow);

        // Recent runs
        const runsTitle = document.createElement('h3');
        runsTitle.style.cssText = 'font-size:0.875rem;font-weight:600;margin-top:1.25rem;margin-bottom:0.75rem;';
        runsTitle.textContent = 'Son Build\'ler';
        const runsContainer = document.createElement('div');
        runsContainer.className = 'build-runs';
        runsContainer.id = 'build-runs';
        runsContainer.textContent = 'Yükleniyor...';
        buildSection.appendChild(runsTitle);
        buildSection.appendChild(runsContainer);

        // Config section
        const configSection = document.createElement('div');
        configSection.className = 'section';
        configSection.id = 'config-section';
        const configTitle = document.createElement('h2');
        configTitle.textContent = 'Site Ayarları';
        const configDesc = document.createElement('p');
        configDesc.style.cssText = 'font-size:0.875rem;color:#94a3b8;margin-bottom:1rem;';
        configDesc.textContent = 'Değişiklikler GitHub\'a kaydedilir. Yeni build sonrası aktif olur.';
        const configForm = document.createElement('div');
        configForm.id = 'config-form';
        configForm.textContent = 'Ayarlar yükleniyor...';
        const configBtnRow = document.createElement('div');
        configBtnRow.style.cssText = 'display:flex;gap:0.5rem;align-items:center;margin-top:1rem;';
        const saveConfigBtn = document.createElement('button');
        saveConfigBtn.className = 'btn btn-success';
        saveConfigBtn.id = 'save-config-btn';
        saveConfigBtn.textContent = 'Kaydet & Build Tetikle';
        saveConfigBtn.addEventListener('click', saveConfig);
        const configStatus = document.createElement('span');
        configStatus.id = 'config-status';
        configStatus.style.cssText = 'font-size:0.75rem;color:#94a3b8;';
        configBtnRow.appendChild(saveConfigBtn);
        configBtnRow.appendChild(configStatus);
        configSection.appendChild(configTitle);
        configSection.appendChild(configDesc);
        configSection.appendChild(configForm);
        configSection.appendChild(configBtnRow);

        // Assemble
        content.appendChild(userSection);
        content.appendChild(statsGrid);
        content.appendChild(apiSection);
        content.appendChild(buildSection);
        content.appendChild(configSection);

        loadStats();
        checkAPI();
        loadBuildRuns();
        loadConfig();
      }

      async function loadStats() {
        try {
          const res = await fetch('/search-index.json');
          const districts = res.ok ? await res.json() : [];
          const provinceCount = 81;
          const districtCount = districts.length;
          const periodCount = 6;
          const staticPages = 4;
          const provincePeriodPages = provinceCount * periodCount;
          const districtPeriodPages = districtCount * periodCount;
          const totalPages = provinceCount + districtCount + provincePeriodPages + districtPeriodPages + staticPages;
          const coveredProvinces = new Set(districts.map(d => {
            const parts = d.u.split('/');
            return parts[1];
          })).size;

          const grid = document.getElementById('stats-grid');
          grid.replaceChildren();
          grid.appendChild(createStatCard('Toplam Sayfa', totalPages.toLocaleString('tr-TR'), `${provinceCount} il + ${districtCount} ilçe + ${(provincePeriodPages + districtPeriodPages).toLocaleString('tr-TR')} dönem + ${staticPages} statik`));
          grid.appendChild(createStatCard('İl Sayısı', provinceCount, `+ ${provincePeriodPages} dönem sayfası`));
          grid.appendChild(createStatCard('İlçe Sayısı', districtCount, `+ ${districtPeriodPages.toLocaleString('tr-TR')} dönem sayfası`));
          grid.appendChild(createStatCard('İlçe Kapsam', coveredProvinces + '/81', `${Math.round(coveredProvinces/81*100)}% il kapsanıyor`));
        } catch {}
      }

      async function checkAPI() {
        const el = document.getElementById('api-status');
        el.textContent = 'Kontrol ediliyor...';
        el.className = 'status status-warn';
        try {
          const start = Date.now();
          const res = await fetch('https://api.open-meteo.com/v1/forecast?latitude=41&longitude=29&current=temperature_2m');
          const ms = Date.now() - start;
          if (res.ok) {
            el.textContent = 'Aktif (' + ms + 'ms)';
            el.className = 'status status-ok';
          } else {
            el.textContent = 'Hata: ' + res.status;
            el.className = 'status status-error';
          }
        } catch {
          el.textContent = 'Bağlantı hatası';
          el.className = 'status status-error';
        }
      }

      async function triggerBuild() {
        const btn = document.getElementById('trigger-build-btn');
        const el = document.getElementById('build-status');
        btn.disabled = true;
        el.textContent = 'Tetikleniyor...';
        try {
          await ghApi(`/repos/${REPO_OWNER}/${REPO_NAME}/actions/workflows/${WORKFLOW_FILE}/dispatches`, {
            method: 'POST',
            body: JSON.stringify({ ref: 'main' })
          });
          el.textContent = 'Build başarıyla tetiklendi!';
          el.style.color = '#34d399';
          setTimeout(() => loadBuildRuns(), 3000);
        } catch (err) {
          el.textContent = 'Tetiklenemedi: ' + err.message;
          el.style.color = '#fca5a5';
        }
        btn.disabled = false;
      }

      async function loadBuildRuns() {
        const container = document.getElementById('build-runs');
        try {
          const data = await ghApi(`/repos/${REPO_OWNER}/${REPO_NAME}/actions/workflows/${WORKFLOW_FILE}/runs?per_page=5`);
          container.replaceChildren();
          if (!data.workflow_runs || data.workflow_runs.length === 0) {
            container.textContent = 'Henüz build kaydı yok.';
            return;
          }
          data.workflow_runs.forEach(run => {
            const item = document.createElement('div');
            item.className = 'build-run';

            const dot = document.createElement('div');
            dot.className = 'run-status ' + (run.conclusion || run.status);

            const info = document.createElement('div');
            info.className = 'run-info';

            const link = document.createElement('a');
            link.href = run.html_url;
            link.target = '_blank';
            link.rel = 'noopener';
            link.style.cssText = 'color:#60a5fa;text-decoration:none;';
            link.textContent = '#' + run.run_number;

            const statusText = document.createElement('span');
            statusText.style.cssText = 'margin-left:0.5rem;color:#94a3b8;';
            const statusMap = {
              success: 'Başarılı',
              failure: 'Başarısız',
              cancelled: 'İptal',
              in_progress: 'Devam ediyor',
              queued: 'Kuyrukta'
            };
            statusText.textContent = statusMap[run.conclusion || run.status] || run.status;

            const trigger = document.createElement('span');
            trigger.style.cssText = 'margin-left:0.5rem;color:#64748b;';
            const triggerMap = { schedule: 'Otomatik', workflow_dispatch: 'Manuel', push: 'Push' };
            trigger.textContent = '(' + (triggerMap[run.event] || run.event) + ')';

            info.appendChild(link);
            info.appendChild(statusText);
            info.appendChild(trigger);

            const time = document.createElement('span');
            time.className = 'run-time';
            time.textContent = new Date(run.created_at).toLocaleString('tr-TR');

            item.appendChild(dot);
            item.appendChild(info);
            item.appendChild(time);
            container.appendChild(item);
          });
        } catch (err) {
          container.textContent = 'Build geçmişi yüklenemedi.';
        }
      }

      async function loadConfig() {
        const form = document.getElementById('config-form');
        try {
          const data = await ghApi(`/repos/${REPO_OWNER}/${REPO_NAME}/contents/${CONFIG_PATH}`);
          currentConfig = JSON.parse(atob(data.content));
          currentConfigSha = data.sha;
          renderConfigForm(form, currentConfig);
        } catch (err) {
          form.textContent = 'Ayarlar yüklenemedi: ' + err.message;
        }
      }

      function renderConfigForm(container, config) {
        container.replaceChildren();

        // Analytics
        const analyticsTitle = document.createElement('h3');
        analyticsTitle.style.cssText = 'font-size:0.875rem;font-weight:600;margin-bottom:0.75rem;color:#60a5fa;';
        analyticsTitle.textContent = 'Analitik';
        container.appendChild(analyticsTitle);

        const analyticsRow = document.createElement('div');
        analyticsRow.className = 'form-row';
        analyticsRow.appendChild(createFormGroup('Google Analytics ID', 'cfg-ga', config.analytics.googleAnalyticsId, 'Örn: G-XXXXXXXXXX'));
        analyticsRow.appendChild(createFormGroup('Yandex Metrica ID', 'cfg-ym', config.analytics.yandexMetricaId, 'Örn: 12345678'));
        container.appendChild(analyticsRow);

        // Verification
        const verTitle = document.createElement('h3');
        verTitle.style.cssText = 'font-size:0.875rem;font-weight:600;margin-top:1.25rem;margin-bottom:0.75rem;color:#60a5fa;';
        verTitle.textContent = 'Arama Motoru Doğrulama';
        container.appendChild(verTitle);

        container.appendChild(createFormGroup('Google Search Console', 'cfg-vg', config.verification.google, 'meta tag content değeri'));
        const verRow = document.createElement('div');
        verRow.className = 'form-row';
        verRow.appendChild(createFormGroup('Yandex Webmaster', 'cfg-vy', config.verification.yandex, 'meta tag content değeri'));
        verRow.appendChild(createFormGroup('Bing Webmaster', 'cfg-vb', config.verification.bing, 'meta tag content değeri'));
        container.appendChild(verRow);

        // Ads
        const adsTitle = document.createElement('h3');
        adsTitle.style.cssText = 'font-size:0.875rem;font-weight:600;margin-top:1.25rem;margin-bottom:0.75rem;color:#60a5fa;';
        adsTitle.textContent = 'Reklamlar';
        container.appendChild(adsTitle);

        const toggleRow = document.createElement('div');
        toggleRow.className = 'toggle-row';
        const toggleLabel = document.createElement('span');
        toggleLabel.style.cssText = 'font-size:0.875rem;';
        toggleLabel.textContent = 'Reklamlar aktif';
        const toggle = document.createElement('label');
        toggle.className = 'toggle';
        const toggleInput = document.createElement('input');
        toggleInput.type = 'checkbox';
        toggleInput.id = 'cfg-ads-enabled';
        toggleInput.checked = config.ads.enabled;
        const slider = document.createElement('span');
        slider.className = 'slider';
        toggle.appendChild(toggleInput);
        toggle.appendChild(slider);
        toggleRow.appendChild(toggleLabel);
        toggleRow.appendChild(toggle);
        container.appendChild(toggleRow);

        container.appendChild(createFormGroup('AdSense Publisher ID', 'cfg-ads-pub', config.ads.adsensePublisherId, 'Örn: ca-pub-1234567890'));
        const slotRow1 = document.createElement('div');
        slotRow1.className = 'form-row';
        slotRow1.appendChild(createFormGroup('Header Slot', 'cfg-ads-header', config.ads.adsenseSlots?.header, 'Slot ID'));
        slotRow1.appendChild(createFormGroup('Sidebar Slot', 'cfg-ads-sidebar', config.ads.adsenseSlots?.sidebar, 'Slot ID'));
        container.appendChild(slotRow1);
        const slotRow2 = document.createElement('div');
        slotRow2.className = 'form-row';
        slotRow2.appendChild(createFormGroup('İçerik İçi Slot', 'cfg-ads-incontent', config.ads.adsenseSlots?.inContent, 'Slot ID'));
        slotRow2.appendChild(createFormGroup('Footer Slot', 'cfg-ads-footer', config.ads.adsenseSlots?.footer, 'Slot ID'));
        container.appendChild(slotRow2);
      }

      function collectConfig() {
        return {
          analytics: {
            googleAnalyticsId: document.getElementById('cfg-ga').value.trim(),
            yandexMetricaId: document.getElementById('cfg-ym').value.trim()
          },
          verification: {
            google: document.getElementById('cfg-vg').value.trim(),
            yandex: document.getElementById('cfg-vy').value.trim(),
            bing: document.getElementById('cfg-vb').value.trim()
          },
          ads: {
            enabled: document.getElementById('cfg-ads-enabled').checked,
            provider: document.getElementById('cfg-ads-pub').value.trim() ? 'adsense' : '',
            adsensePublisherId: document.getElementById('cfg-ads-pub').value.trim(),
            adsenseSlots: {
              header: document.getElementById('cfg-ads-header').value.trim(),
              sidebar: document.getElementById('cfg-ads-sidebar').value.trim(),
              inContent: document.getElementById('cfg-ads-incontent').value.trim(),
              footer: document.getElementById('cfg-ads-footer').value.trim()
            }
          }
        };
      }

      async function saveConfig() {
        const btn = document.getElementById('save-config-btn');
        const el = document.getElementById('config-status');
        btn.disabled = true;
        el.textContent = 'Kaydediliyor...';
        el.style.color = '#94a3b8';

        try {
          const newConfig = collectConfig();
          const content = btoa(unescape(encodeURIComponent(JSON.stringify(newConfig, null, 2) + '\n')));

          const result = await ghApi(`/repos/${REPO_OWNER}/${REPO_NAME}/contents/${CONFIG_PATH}`, {
            method: 'PUT',
            body: JSON.stringify({
              message: 'chore: update site config via admin panel',
              content: content,
              sha: currentConfigSha
            })
          });
          currentConfigSha = result.content.sha;
          currentConfig = newConfig;

          // Trigger build
          try {
            await ghApi(`/repos/${REPO_OWNER}/${REPO_NAME}/actions/workflows/${WORKFLOW_FILE}/dispatches`, {
              method: 'POST',
              body: JSON.stringify({ ref: 'main' })
            });
            el.textContent = 'Kaydedildi ve build tetiklendi!';
            el.style.color = '#34d399';
            setTimeout(() => loadBuildRuns(), 3000);
          } catch {
            el.textContent = 'Kaydedildi ama build tetiklenemedi. Manuel tetikleyin.';
            el.style.color = '#fbbf24';
          }
        } catch (err) {
          el.textContent = 'Kayıt hatası: ' + err.message;
          el.style.color = '#fca5a5';
        }
        btn.disabled = false;
      }

      // GitHub login - using personal access token with masked input
      document.getElementById('github-login-btn').addEventListener('click', (e) => {
        e.preventDefault();

        const overlay = document.createElement('div');
        overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.7);display:flex;align-items:center;justify-content:center;z-index:1000;';

        const modal = document.createElement('div');
        modal.style.cssText = 'background:#1e293b;border:1px solid #334155;border-radius:1rem;padding:2rem;max-width:480px;width:90%;';

        const title = document.createElement('h3');
        title.style.cssText = 'margin-bottom:0.75rem;font-size:1rem;';
        title.textContent = 'GitHub Personal Access Token';

        const desc = document.createElement('p');
        desc.style.cssText = 'font-size:0.8rem;color:#94a3b8;margin-bottom:1rem;line-height:1.5;';
        desc.textContent = 'GitHub → Settings → Developer settings → Personal access tokens → Fine-grained tokens → Generate new token. Gerekli izinler: Contents (read/write), Actions (read/write), Metadata (read).';

        const input = document.createElement('input');
        input.type = 'password';
        input.placeholder = 'github_pat_...';
        input.autocomplete = 'off';
        input.style.cssText = 'width:100%;padding:0.5rem 0.75rem;border-radius:0.5rem;border:1px solid #334155;background:#0f172a;color:white;font-size:0.875rem;margin-bottom:1rem;';

        const btnRow = document.createElement('div');
        btnRow.style.cssText = 'display:flex;gap:0.5rem;justify-content:flex-end;';

        const cancelBtn = document.createElement('button');
        cancelBtn.className = 'btn';
        cancelBtn.style.cssText = 'background:#334155;color:white;';
        cancelBtn.textContent = 'İptal';
        cancelBtn.addEventListener('click', () => overlay.remove());

        const okBtn = document.createElement('button');
        okBtn.className = 'btn btn-primary';
        okBtn.textContent = 'Giriş Yap';
        okBtn.addEventListener('click', () => {
          const token = input.value.trim();
          if (token) {
            sessionStorage.setItem(TOKEN_KEY, token);
            validateToken(token);
          }
          overlay.remove();
        });

        input.addEventListener('keydown', (ev) => {
          if (ev.key === 'Enter') okBtn.click();
          if (ev.key === 'Escape') overlay.remove();
        });

        btnRow.appendChild(cancelBtn);
        btnRow.appendChild(okBtn);
        modal.appendChild(title);
        modal.appendChild(desc);
        modal.appendChild(input);
        modal.appendChild(btnRow);
        overlay.appendChild(modal);
        document.body.appendChild(overlay);
        input.focus();
      });

      checkAuth();
    </script>
  </body>
</html>
