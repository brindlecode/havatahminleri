---
// Admin panel - no server-side data exposed, everything loaded client-side after auth
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin Panel | Hava Tahminleri</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: 'Inter', sans-serif; background: #0f172a; color: #e2e8f0; min-height: 100vh; }
      .container { max-width: 900px; margin: 0 auto; padding: 2rem 1rem; }
      .header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem; }
      .header h1 { font-size: 1.5rem; font-weight: 700; }
      .header a { color: #60a5fa; text-decoration: none; font-size: 0.875rem; }
      .login-section { text-align: center; padding: 6rem 1rem; }
      .login-btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: #1e293b; border: 1px solid #334155; border-radius: 0.75rem; color: white; font-size: 0.875rem; font-weight: 500; cursor: pointer; transition: background 0.2s; text-decoration: none; }
      .login-btn:hover { background: #334155; }
      .login-btn svg { width: 20px; height: 20px; }
      .hidden { display: none !important; }
      .section { background: #1e293b; border: 1px solid #334155; border-radius: 1rem; padding: 1.5rem; margin-bottom: 1.5rem; }
      .section h2 { font-size: 1rem; font-weight: 600; margin-bottom: 1rem; }
      .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
      .stat-card { background: #1e293b; border: 1px solid #334155; border-radius: 1rem; padding: 1.25rem; }
      .stat-card .label { font-size: 0.75rem; color: #94a3b8; margin-bottom: 0.25rem; }
      .stat-card .value { font-size: 1.5rem; font-weight: 700; }
      .btn { padding: 0.5rem 1rem; border-radius: 0.5rem; border: none; font-size: 0.875rem; font-weight: 500; cursor: pointer; }
      .btn-primary { background: #3b82f6; color: white; }
      .btn-primary:hover { background: #2563eb; }
      .status { display: inline-flex; align-items: center; gap: 0.375rem; font-size: 0.75rem; padding: 0.25rem 0.5rem; border-radius: 0.375rem; }
      .status-ok { background: #064e3b; color: #34d399; }
      .status-warn { background: #78350f; color: #fbbf24; }
      .user-info { display: flex; align-items: center; gap: 0.75rem; }
      .user-info img { width: 32px; height: 32px; border-radius: 50%; }
      .logout-btn { font-size: 0.75rem; color: #ef4444; cursor: pointer; background: none; border: none; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Hava Tahminleri Admin</h1>
        <a href="/">← Siteye Dön</a>
      </div>

      <!-- Login -->
      <div id="login-section" class="login-section">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" style="margin: 0 auto 1rem;">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>
        </svg>
        <h2 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Admin Paneli</h2>
        <p style="color: #94a3b8; margin-bottom: 2rem; font-size: 0.875rem;">Devam etmek için GitHub hesabınızla giriş yapın</p>
        <a id="github-login-btn" class="login-btn" href="#">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          GitHub ile Giriş Yap
        </a>
      </div>

      <!-- Admin Content - rendered by JS only after auth -->
      <div id="admin-content" class="hidden"></div>
    </div>

    <script is:inline>
      const ADMIN_USERS = ['ilkukaya'];
      const TOKEN_KEY = 'admin_gh_token';

      function checkAuth() {
        const token = localStorage.getItem(TOKEN_KEY);
        if (token) validateToken(token);
      }

      async function validateToken(token) {
        try {
          const res = await fetch('https://api.github.com/user', {
            headers: { 'Authorization': 'token ' + token }
          });
          if (res.ok) {
            const user = await res.json();
            if (ADMIN_USERS.includes(user.login)) {
              showAdmin(user);
              return;
            }
            alert('Bu GitHub hesabının admin yetkisi bulunmamaktadır.');
          }
          localStorage.removeItem(TOKEN_KEY);
        } catch {
          localStorage.removeItem(TOKEN_KEY);
        }
      }

      function showAdmin(user) {
        document.getElementById('login-section').classList.add('hidden');
        const content = document.getElementById('admin-content');
        content.classList.remove('hidden');

        content.innerHTML = `
          <div class="section" style="display:flex;align-items:center;justify-content:space-between;">
            <div class="user-info">
              <img src="${user.avatar_url}" alt="${user.login}" />
              <span>${user.login}</span>
              <span class="status status-ok">Admin</span>
            </div>
            <button class="logout-btn" id="logout-btn">Çıkış Yap</button>
          </div>

          <div class="stats" id="stats-grid">
            <div class="stat-card"><div class="label">Yükleniyor...</div><div class="value">-</div></div>
          </div>

          <div class="section">
            <h2>API Durumu</h2>
            <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
              <span>Open-Meteo API:</span>
              <span id="api-status" class="status status-warn">Kontrol ediliyor...</span>
              <button class="btn btn-primary" id="check-api-btn" style="margin-left:auto;">Kontrol Et</button>
            </div>
          </div>

          <div class="section">
            <h2>Build Yönetimi</h2>
            <p style="font-size:0.875rem;color:#94a3b8;margin-bottom:1rem;">Netlify build hook URL'si ile manuel build tetikleyebilirsiniz.</p>
            <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
              <input type="text" id="build-hook-input" placeholder="Netlify Build Hook URL"
                style="flex:1;min-width:200px;padding:0.5rem 0.75rem;border-radius:0.5rem;border:1px solid #334155;background:#0f172a;color:white;font-size:0.875rem;" />
              <button class="btn btn-primary" id="trigger-build-btn">Build Tetikle</button>
            </div>
            <p id="build-status" style="font-size:0.75rem;color:#94a3b8;margin-top:0.5rem;"></p>
          </div>
        `;

        // Load stats via search index
        loadStats();

        document.getElementById('logout-btn').addEventListener('click', () => {
          localStorage.removeItem(TOKEN_KEY);
          location.reload();
        });

        document.getElementById('check-api-btn').addEventListener('click', checkAPI);
        document.getElementById('trigger-build-btn').addEventListener('click', triggerBuild);

        checkAPI();
      }

      async function loadStats() {
        try {
          const res = await fetch('/search-index.json');
          const districts = res.ok ? await res.json() : [];
          const provinceCount = 81;
          const districtCount = districts.length;
          const totalPages = provinceCount + districtCount + 4;
          const coveredProvinces = new Set(districts.map(d => {
            const parts = d.u.split('/');
            return parts[1];
          })).size;

          document.getElementById('stats-grid').innerHTML = `
            <div class="stat-card"><div class="label">Toplam Sayfa</div><div class="value">${totalPages}</div></div>
            <div class="stat-card"><div class="label">İl Sayısı</div><div class="value">${provinceCount}</div></div>
            <div class="stat-card"><div class="label">İlçe Sayısı</div><div class="value">${districtCount}</div></div>
            <div class="stat-card"><div class="label">İlçe Kapsam</div><div class="value">${coveredProvinces}/81</div></div>
          `;
        } catch {}
      }

      async function checkAPI() {
        const el = document.getElementById('api-status');
        el.textContent = 'Kontrol ediliyor...';
        el.className = 'status status-warn';
        try {
          const start = Date.now();
          const res = await fetch('https://api.open-meteo.com/v1/forecast?latitude=41&longitude=29&current=temperature_2m');
          const ms = Date.now() - start;
          if (res.ok) {
            el.textContent = 'Aktif (' + ms + 'ms)';
            el.className = 'status status-ok';
          } else {
            el.textContent = 'Hata: ' + res.status;
          }
        } catch {
          el.textContent = 'Bağlantı hatası';
        }
      }

      async function triggerBuild() {
        const url = document.getElementById('build-hook-input').value.trim();
        const el = document.getElementById('build-status');
        if (!url) { el.textContent = 'URL giriniz.'; return; }
        try {
          el.textContent = 'Tetikleniyor...';
          await fetch(url, { method: 'POST', body: '{}' });
          el.textContent = 'Build başarıyla tetiklendi!';
        } catch {
          el.textContent = 'Tetiklenemedi. URL kontrol edin.';
        }
      }

      // GitHub login - using personal access token
      document.getElementById('github-login-btn').addEventListener('click', (e) => {
        e.preventDefault();
        const token = prompt('GitHub Personal Access Token girin:\\n\\nGitHub → Settings → Developer settings → Personal access tokens → Tokens (classic) → Generate new token\\n\\nSadece "read:user" scope yeterli.');
        if (token && token.trim()) {
          localStorage.setItem(TOKEN_KEY, token.trim());
          validateToken(token.trim());
        }
      });

      checkAuth();
    </script>
  </body>
</html>
