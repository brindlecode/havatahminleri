---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TurkeyMap from '../components/TurkeyMap.astro';
import AdSlot from '../components/AdSlot.astro';
import { generateLegalPageStructuredData } from '../lib/seo';
import { fetchWeatherData } from '../lib/weather';
import { getAlerts, maxAlertLevel, ALERT_KIND_LABEL, ALERT_LEVEL_LABEL, MGM_WARNINGS_URL, type Alert, type AlertKind } from '../lib/alerts';
import { getWarnings, warningTitle, warningWindow, LEVEL_LABEL } from '../lib/extras';
import provinces from '../data/provinces.json';

const pageName = 'Hava Uyarıları';
const title = 'Hava Uyarıları: Yağış, Rüzgar, Kar ve Sıcaklık - Yarın Hava';
const description =
  'Bugün ve yarın hangi illerde kuvvetli yağış, sağanak, kar, fırtına, aşırı sıcak veya soğuk bekleniyor? 81 il için tahmine dayalı hava uyarıları ve harita.';
const canonical = 'https://yarinhava.com/hava-uyarilari/';
const structuredData = generateLegalPageStructuredData(pageName, description, canonical);

const rows = await Promise.all(
  provinces.map(async (p: any) => {
    const weather = await fetchWeatherData(p.lat, p.lon);
    return { p, alerts: getAlerts(weather), date: weather.daily.time };
  }),
);
const official = getWarnings();
const plateName = new Map(provinces.map((p: any) => [p.plate, p.name]));

const FILL = { 0: 'var(--color-surface-2)', 1: '#f6c58f', 2: '#ef8b8b' } as const;
const points = rows.map((r) => {
  const lvl = maxAlertLevel(r.alerts);
  return { name: r.p.name, slug: r.p.slug, plate: r.p.plate, fill: FILL[lvl], label: '' };
});

const KINDS: AlertKind[] = ['storm', 'rain', 'snow', 'wind', 'heat', 'cold'];
const byDay = [0, 1].map((day) =>
  KINDS.map((kind) => {
    const hits = rows
      .map((r) => ({ p: r.p, a: r.alerts.find((a: Alert) => a.day === day && a.kind === kind) }))
      .filter((x): x is { p: any; a: Alert } => Boolean(x.a))
      .sort((x, y) => y.a.level - x.a.level || x.p.name.localeCompare(y.p.name, 'tr'));
    return { kind, hits };
  }).filter((g) => g.hits.length),
);
const dayDate = (i: number) => {
  const iso = rows[0]?.date[i];
  return iso ? new Date(`${iso}T00:00:00Z`).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', weekday: 'long', timeZone: 'UTC' }) : '';
};
const total = rows.filter((r) => r.alerts.length).length;
---

<BaseLayout title={title} description={description} canonical={canonical} structuredData={structuredData}>
  <Header slot="header" />

  <div class="max-w-5xl mx-auto px-4 py-8">
    <Breadcrumb items={[{ name: pageName, url: canonical }]} />
    <h1 class="font-display text-[2rem] sm:text-[2.4rem] font-semibold tracking-[-0.03em] leading-tight mb-2">Hava Uyarıları</h1>
    <p class="text-[var(--color-text-secondary)] leading-relaxed mb-6 max-w-3xl">
      Bugün ve yarın kuvvetli yağış, gök gürültülü sağanak, kar, fırtına, aşırı sıcak ya da aşırı soğuk beklenen iller.
      {total > 0 ? ` Şu anda ${total} ilde en az bir uyarı var.` : ' Şu anda hiçbir ilde olağanüstü hava beklenmiyor.'}
    </p>

    {official.length > 0 && (
      <section class="weather-card mb-4" aria-labelledby="resmi">
        <h2 id="resmi" class="section-title">Meteoroloji Genel Müdürlüğü uyarıları</h2>
        <ul class="space-y-3">
          {official.map((w) => (
            <li data-expires={w.expires ?? ''}>
              <p class="font-semibold">{LEVEL_LABEL[w.level]} uyarı: {warningTitle(w)}</p>
              <p class="text-[0.82rem] text-[var(--color-text-secondary)] tabular">{warningWindow(w)} · {(w.plates.length ? w.plates.map((p) => plateName.get(p)) : w.areas).join(', ')}</p>
              {w.description && <p class="text-[0.88rem] mt-1 leading-relaxed">{w.description}</p>}
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="weather-card" aria-label="Uyarı haritası">
      <TurkeyMap points={points} caption="Bugün ve yarın" title="Hava uyarısı olan iller haritası" legend={false} />
      <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5 text-[0.78rem] text-[var(--color-text-secondary)]">
        <li class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full" style={`background:${FILL[2]}`} aria-hidden="true"></span>Tehlike</li>
        <li class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full" style={`background:${FILL[1]}`} aria-hidden="true"></span>Dikkat</li>
        <li class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full border border-[var(--color-border)]" style={`background:${FILL[0]}`} aria-hidden="true"></span>Uyarı yok</li>
      </ul>
    </section>

    {[0, 1].map((day) => (
      <section class="weather-card mt-4" aria-labelledby={`gun-${day}`} data-day-relative>
        <h2 id={`gun-${day}`} class="section-title">{day === 0 ? 'Bugün' : 'Yarın'} <span class="font-normal text-[0.9rem] text-[var(--color-text-secondary)]">{dayDate(day)}</span></h2>
        {byDay[day].length === 0 ? (
          <p class="text-[0.92rem] text-[var(--color-text-secondary)]">Hiçbir ilde olağanüstü hava beklenmiyor.</p>
        ) : (
          <div class="space-y-4">
            {byDay[day].map((g) => (
              <div>
                <h3 class="font-semibold text-[0.95rem] mb-1.5">{ALERT_KIND_LABEL[g.kind]} <span class="font-normal text-[var(--color-text-secondary)]">({g.hits.length} il)</span></h3>
                <ul class="flex flex-wrap gap-1.5">
                  {g.hits.map((h) => (
                    <li>
                      <a href={`/${h.p.slug}-hava-durumu/${day === 0 ? 'bugun/' : ''}`} class:list={['inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[0.82rem] border', h.a.level === 2 ? 'al-danger' : 'al-watch']} title={h.a.detail}>
                        {h.p.name}{h.a.level === 2 && <span class="text-[0.7rem] font-semibold uppercase tracking-wide">{ALERT_LEVEL_LABEL[2]}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}
      </section>
    ))}

    <AdSlot slot="inContent" id="alerts-mid" />

    <section class="weather-card mt-4 prose-text" aria-labelledby="nasil">
      <h2 id="nasil" class="section-title">Uyarılar nasıl belirleniyor?</h2>
      <p>
        Bu sayfadaki uyarılar Yarın Hava'nın kendi tahmin verisinden, aşağıdaki eşiklere göre otomatik hazırlanır. Resmi meteorolojik
        uyarı değildir; resmi sarı, turuncu ve kırmızı uyarılar için
        <a href={MGM_WARNINGS_URL} rel="noopener" target="_blank" class="font-semibold text-[var(--color-accent)] hover:underline">Meteoroloji Genel Müdürlüğü MeteoUyarı</a>
        sayfasını takip edin.
      </p>
      <ul class="mt-3 space-y-1.5 text-[0.92rem]">
        <li><strong>Kuvvetli yağış:</strong> günlük 25 mm ve üzeri (Dikkat), 50 mm ve üzeri (Tehlike).</li>
        <li><strong>Gök gürültülü sağanak:</strong> günün baskın hava durumu sağanak ve gök gürültüsü; 50 mm üzeri yağışla Tehlike.</li>
        <li><strong>Kar yağışı:</strong> yaklaşık 3 cm ve üzeri kar (Dikkat), 10 cm ve üzeri (Tehlike).</li>
        <li><strong>Kuvvetli rüzgar:</strong> saatte 50 km ve üzeri (Dikkat), 65 km ve üzeri fırtına (Tehlike).</li>
        <li><strong>Aşırı sıcak:</strong> 38° ve üzeri (Dikkat), 42° ve üzeri (Tehlike).</li>
        <li><strong>Aşırı soğuk:</strong> -15° ve altı (Dikkat), -25° ve altı (Tehlike).</li>
      </ul>
      <p class="mt-3 text-[0.85rem] text-[var(--color-text-secondary)]">Değerler il merkezleri içindir ve günde iki kez yenilenir.</p>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .al-watch { background: color-mix(in srgb, #f08a1c 12%, transparent); border-color: color-mix(in srgb, #f08a1c 45%, transparent); }
  .al-danger { background: color-mix(in srgb, #d7263d 12%, transparent); border-color: color-mix(in srgb, #d7263d 50%, transparent); }
  .al-danger span { color: #b3162c; }
  :global(.dark) .al-danger span { color: #ff7a85; }
</style>
