---
import ForecastLayout from '../../layouts/ForecastLayout.astro';
import RelatedForecasts from '../../components/RelatedForecasts.astro';
import { getPeriodSEO, generateStructuredData, buildBreadcrumbs, getLocationNames } from '../../lib/seo';
import { fetchWeatherData } from '../../lib/weather';
import { PERIODS, getLocationPath } from '../../lib/periods';
import provinces from '../../data/provinces.json';
import districts from '../../data/districts.json';
import regions from '../../data/regions.json';

export function getStaticPaths() {
  const paths: any[] = [];
  for (const prov of provinces) {
    for (const period of PERIODS) {
      paths.push({
        params: { province: prov.slug, period: period.slug },
        props: { province: prov, periodId: period.id },
      });
    }
  }
  return paths;
}

const { province, periodId } = Astro.props;
const weather = await fetchWeatherData(province.lat, province.lon);

const loc = {
  provinceName: province.name,
  provinceSlug: province.slug,
  lat: province.lat,
  lon: province.lon,
};

const names = getLocationNames(loc);
const seo = getPeriodSEO(loc, periodId, {
  temperature: weather.current.temperature,
  weatherCode: weather.current.weatherCode,
  maxTemp: weather.daily.temperatureMax[0],
  minTemp: weather.daily.temperatureMin[0],
});

const region = regions.find((r: any) => r.id === province.region);
const breadcrumbs = buildBreadcrumbs(loc, periodId, region?.name);

const structuredData = generateStructuredData('location', {
  name: seo.heading,
  description: seo.description,
  url: seo.canonical,
  lat: province.lat,
  lon: province.lon,
  breadcrumbs,
});

const provinceDistricts = districts.filter((d: any) => d.province === province.slug);
const basePath = getLocationPath(province.slug).replace(/\/$/, '');
---

<ForecastLayout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  structuredData={structuredData}
  cityName={names.short}
  heading={seo.heading}
  weather={weather}
  breadcrumbs={breadcrumbs}
  period={periodId}
  basePath={basePath}
  lat={province.lat}
  lon={province.lon}
>
  {provinceDistricts.length > 0 && (
    <section class="weather-card mt-6">
      <h2 class="text-lg font-semibold mb-4">{province.name} İlçeleri Hava Durumu</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2">
        {provinceDistricts.map((d: any) => (
          <a href={`/${province.slug}/${d.slug}-hava-durumu/`}
            class="px-3 py-2.5 rounded-xl hover:bg-[var(--color-bg)] transition-colors text-sm">
            {d.name === 'Merkez' ? `${province.name} Merkez` : d.name}
          </a>
        ))}
      </div>
    </section>
  )}

  <RelatedForecasts cityName={names.short} basePath={basePath} current={periodId} />
</ForecastLayout>
