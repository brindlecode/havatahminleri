---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CurrentWeather from '../../components/CurrentWeather.astro';
import HourlyForecast from '../../components/HourlyForecast.astro';
import DailyForecast from '../../components/DailyForecast.astro';

import WeatherDetails from '../../components/WeatherDetails.astro';
import WeatherSummary from '../../components/WeatherSummary.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getDistrictSEO, generateStructuredData } from '../../lib/seo';
import { fetchWeatherData } from '../../lib/weather';
import provinces from '../../data/provinces.json';
import districts from '../../data/districts.json';
import regions from '../../data/regions.json';

export function getStaticPaths() {
  return districts.map((d: any) => {
    const prov = provinces.find((p: any) => p.slug === d.province);
    return {
      params: {
        province: prov!.slug,
        district: `${d.slug}-hava-durumu`,
      },
      props: { district: d, province: prov },
    };
  });
}

const { district, province } = Astro.props;
const weather = await fetchWeatherData(district.lat, district.lon);

const seo = getDistrictSEO(
  district.name,
  province.name,
  province.slug,
  district.slug,
  weather.current.temperature,
  weather.current.weatherCode,
);

const region = regions.find((r: any) => r.id === province.region);
const breadcrumbs = [
  { name: region?.name || '', url: '/' },
  { name: province.name, url: `/${province.slug}-hava-durumu` },
  { name: `${district.name} Hava Durumu`, url: seo.canonical },
];

const structuredData = generateStructuredData('district', {
  name: `${district.name} (${province.name}) Hava Durumu`,
  description: seo.description,
  url: seo.canonical,
  lat: district.lat,
  lon: district.lon,
  breadcrumbs: [{ name: 'Ana Sayfa', url: 'https://havatahminleri.com' }, ...breadcrumbs],
});

const siblingDistricts = districts
  .filter((d: any) => d.province === province.slug && d.slug !== district.slug)
  .slice(0, 20);

const baseUrl = `/${province.slug}/${district.slug}-hava-durumu`;
const periodLinks = [
  { label: 'Bugün', href: `${baseUrl}/bugun` },
  { label: 'Yarın', href: `${baseUrl}/yarin` },
  { label: '7 Günlük', href: `${baseUrl}/7-gunluk` },
  { label: '10 Günlük', href: `${baseUrl}/10-gunluk` },
  { label: '15 Günlük', href: baseUrl },
  { label: 'Saatlik', href: `${baseUrl}/saatlik` },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  structuredData={structuredData}
>
  <Header slot="header" />

  <div class="max-w-4xl mx-auto px-4 py-6">
    <Breadcrumb items={breadcrumbs} />

    <CurrentWeather cityName={`${district.name}, ${province.name}`} current={weather.current} daily={weather.daily} />

    <AdSlot id="district-top" />

    <!-- Period Navigation Links -->
    <div class="weather-card my-4">
      <div class="flex gap-1 overflow-x-auto scrollbar-hide pb-1 -mx-1 px-1">
        {periodLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'px-3 py-2 rounded-lg text-xs font-medium whitespace-nowrap transition-all border',
              link.label === '15 Günlük'
                ? 'bg-blue-500 text-white border-blue-500'
                : 'bg-[var(--color-bg)] text-[var(--color-text-secondary)] border-[var(--color-border)] hover:bg-[var(--color-surface)] hover:text-[var(--color-text)]'
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <div class="mt-4">
      <HourlyForecast hourly={weather.hourly} />
    </div>

    <div class="mt-4">
      <DailyForecast daily={weather.daily} />
    </div>

    <AdSlot id="district-mid" />

    <div class="mt-4">
      <WeatherDetails current={weather.current} daily={weather.daily} />
    </div>

    <AdSlot id="district-details" />

    {siblingDistricts.length > 0 && (
      <section class="weather-card mt-6">
        <h2 class="text-lg font-semibold mb-4">{province.name} Diğer İlçeler</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2">
          {siblingDistricts.map((d: any) => (
            <a
              href={`/${province.slug}/${d.slug}-hava-durumu`}
              class="flex items-center gap-2 px-3 py-2.5 rounded-xl hover:bg-[var(--color-bg)] transition-colors"
            >
              <svg class="w-3.5 h-3.5 text-[var(--color-text-secondary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              </svg>
              <span class="text-sm">{d.name}</span>
            </a>
          ))}
        </div>
        <a
          href={`/${province.slug}-hava-durumu`}
          class="block text-center text-sm text-primary-500 hover:text-primary-600 mt-4 font-medium"
        >
          ← {province.name} Hava Durumuna Dön
        </a>
      </section>
    )}

    <WeatherSummary cityName={district.name} weather={weather} isDistrict={true} provinceName={province.name} />

    <AdSlot id="district-bottom" />
  </div>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline define:vars={{ lat: district.lat, lon: district.lon }}>
  (function() {
    const CACHE_KEY = `weather_${lat}_${lon}`;
    const CACHE_MS = 30 * 60 * 1000;
    function getCached() {
      try {
        const c = localStorage.getItem(CACHE_KEY);
        if (!c) return null;
        const { ts } = JSON.parse(c);
        if (Date.now() - ts > CACHE_MS) return null;
        return true;
      } catch { return null; }
    }
    async function refresh() {
      if (getCached()) return;
      try {
        const p = new URLSearchParams({
          latitude: String(lat), longitude: String(lon),
          current: 'temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m,wind_direction_10m,is_day,surface_pressure,cloud_cover,visibility',
          hourly: 'temperature_2m,weather_code,relative_humidity_2m,precipitation_probability,wind_speed_10m,is_day,dew_point_2m,visibility,surface_pressure,cloud_cover',
          daily: 'weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum,precipitation_probability_max,wind_speed_10m_max,uv_index_max,sunrise,sunset',
          timezone: 'Europe/Istanbul', forecast_days: '16', forecast_hours: '48'
        });
        const r = await fetch('https://api.open-meteo.com/v1/forecast?' + p);
        const d = await r.json();
        localStorage.setItem(CACHE_KEY, JSON.stringify({ d, ts: Date.now() }));
      } catch {}
    }
    refresh();
  })();
</script>
