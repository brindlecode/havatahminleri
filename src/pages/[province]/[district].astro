---
import ForecastLayout from '../../layouts/ForecastLayout.astro';
import RelatedForecasts from '../../components/RelatedForecasts.astro';
import DistrictSiblings from '../../components/DistrictSiblings.astro';
import { getPeriodSEO, generateStructuredData, buildBreadcrumbs, getLocationNames } from '../../lib/seo';
import { fetchWeatherData } from '../../lib/weather';
import { getLocationPath } from '../../lib/periods';
import provinces from '../../data/provinces.json';
import districts from '../../data/districts.json';
import regions from '../../data/regions.json';

export function getStaticPaths() {
  return districts.map((d: any) => {
    const prov = provinces.find((p: any) => p.slug === d.province);
    return {
      params: {
        province: prov!.slug,
        district: `${d.slug}-hava-durumu`,
      },
      props: { district: d, province: prov },
    };
  });
}

const { district, province } = Astro.props;
const weather = await fetchWeatherData(district.lat, district.lon);

const loc = {
  provinceName: province.name,
  provinceSlug: province.slug,
  districtName: district.name,
  districtSlug: district.slug,
  lat: district.lat,
  lon: district.lon,
};

const names = getLocationNames(loc);
const seo = getPeriodSEO(loc, 'base', {
  temperature: weather.current.temperature,
  weatherCode: weather.current.weatherCode,
  maxTemp: weather.daily.temperatureMax[1],
  minTemp: weather.daily.temperatureMin[1],
});

const region = regions.find((r: any) => r.id === province.region);
const breadcrumbs = buildBreadcrumbs(loc, 'base', region?.name);

const structuredData = generateStructuredData('location', {
  name: `${names.qualified} Hava Durumu`,
  description: seo.description,
  url: seo.canonical,
  lat: district.lat,
  lon: district.lon,
  breadcrumbs,
});

const basePath = getLocationPath(province.slug, district.slug).replace(/\/$/, '');
---

<ForecastLayout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  structuredData={structuredData}
  cityName={names.short}
  heading={seo.heading}
  weather={weather}
  breadcrumbs={breadcrumbs}
  period="base"
  basePath={basePath}
  lat={district.lat}
  lon={district.lon}
>
  <DistrictSiblings province={province} currentSlug={district.slug} districts={districts} />
  <RelatedForecasts cityName={names.short} basePath={basePath} current="base" />
</ForecastLayout>
