---
import ForecastLayout from '../../../layouts/ForecastLayout.astro';
import RelatedForecasts from '../../../components/RelatedForecasts.astro';
import DistrictSiblings from '../../../components/DistrictSiblings.astro';
import { getPeriodSEO, generateStructuredData, buildBreadcrumbs, getLocationNames } from '../../../lib/seo';
import { fetchWeatherData } from '../../../lib/weather';
import { PERIODS, getLocationPath } from '../../../lib/periods';
import provinces from '../../../data/provinces.json';
import districts from '../../../data/districts.json';
import regions from '../../../data/regions.json';

export function getStaticPaths() {
  const paths: any[] = [];
  for (const dist of districts) {
    const prov = provinces.find((p: any) => p.slug === dist.province);
    if (!prov) continue;
    for (const period of PERIODS) {
      paths.push({
        params: { province: prov.slug, district: dist.slug, period: period.slug },
        props: { district: dist, province: prov, periodId: period.id },
      });
    }
  }
  return paths;
}

const { district, province, periodId } = Astro.props;
const weather = await fetchWeatherData(district.lat, district.lon);

const loc = {
  provinceName: province.name,
  provinceSlug: province.slug,
  districtName: district.name,
  districtSlug: district.slug,
  lat: district.lat,
  lon: district.lon,
};

const names = getLocationNames(loc);
const seo = getPeriodSEO(loc, periodId, {
  temperature: weather.current.temperature,
  weatherCode: weather.current.weatherCode,
  maxTemp: weather.daily.temperatureMax[0],
  minTemp: weather.daily.temperatureMin[0],
});

const region = regions.find((r: any) => r.id === province.region);
const breadcrumbs = buildBreadcrumbs(loc, periodId, region?.name);

const structuredData = generateStructuredData('location', {
  name: `${names.qualified} ${seo.heading.replace(names.short, '').trim()}`.trim(),
  description: seo.description,
  url: seo.canonical,
  lat: district.lat,
  lon: district.lon,
  breadcrumbs,
});

const basePath = getLocationPath(province.slug, district.slug).replace(/\/$/, '');
---

<ForecastLayout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  structuredData={structuredData}
  cityName={names.short}
  heading={seo.heading}
  weather={weather}
  breadcrumbs={breadcrumbs}
  period={periodId}
  basePath={basePath}
  lat={district.lat}
  lon={district.lon}
>
  <DistrictSiblings province={province} currentSlug={district.slug} districts={districts} limit={16} />
  <RelatedForecasts cityName={names.short} basePath={basePath} current={periodId} />
</ForecastLayout>
