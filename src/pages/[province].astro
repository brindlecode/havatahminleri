---
import ForecastLayout from '../layouts/ForecastLayout.astro';
import ProvinceDistricts from '../components/ProvinceDistricts.astro';
import RelatedForecasts from '../components/RelatedForecasts.astro';
import { getPeriodSEO, generateStructuredData, buildBreadcrumbs, getLocationNames } from '../lib/seo';
import { fetchWeatherData } from '../lib/weather';
import { getLocationPath } from '../lib/periods';
import provinces from '../data/provinces.json';
import districts from '../data/districts.json';
import regions from '../data/regions.json';

export function getStaticPaths() {
  return provinces.map((p: any) => ({
    params: { province: `${p.slug}-hava-durumu` },
    props: { province: p },
  }));
}

const { province } = Astro.props;
const weather = await fetchWeatherData(province.lat, province.lon);

const loc = {
  provinceName: province.name,
  provinceSlug: province.slug,
  lat: province.lat,
  lon: province.lon,
};

const names = getLocationNames(loc);
const seo = getPeriodSEO(loc, 'base', {
  temperature: weather.current.temperature,
  weatherCode: weather.current.weatherCode,
  maxTemp: weather.daily.temperatureMax[1],
  minTemp: weather.daily.temperatureMin[1],
});

const region = regions.find((r: any) => r.id === province.region);
const breadcrumbs = buildBreadcrumbs(loc, 'base', region?.name);

const structuredData = generateStructuredData('location', {
  name: `${province.name} Hava Durumu`,
  description: seo.description,
  url: seo.canonical,
  lat: province.lat,
  lon: province.lon,
  breadcrumbs,
});

const basePath = getLocationPath(province.slug).replace(/\/$/, '');
---

<ForecastLayout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  structuredData={structuredData}
  cityName={names.short}
  heading={seo.heading}
  weather={weather}
  breadcrumbs={breadcrumbs}
  period="base"
  basePath={basePath}
  lat={province.lat}
  lon={province.lon}
>
  <ProvinceDistricts province={province} districts={districts} />

  <RelatedForecasts cityName={names.short} basePath={basePath} current="base" />
</ForecastLayout>
