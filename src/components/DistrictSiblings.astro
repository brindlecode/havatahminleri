---
interface Props {
  province: { name: string; slug: string };
  currentSlug: string;
  districts: any[];
  limit?: number;
}

const { province, currentSlug, districts, limit = 20 } = Astro.props;

const siblings = districts
  .filter((d: any) => d.province === province.slug && d.slug !== currentSlug)
  .slice(0, limit);
---

{siblings.length > 0 && (
  <section class="weather-card">
    <h2 class="section-title">{province.name} Diğer İlçeler</h2>
    <div class="flex flex-wrap gap-1.5">
      {siblings.map((d: any) => (
        <a href={`/${province.slug}/${d.slug}-hava-durumu/`} class="px-3 py-1.5 rounded-full bg-[var(--color-surface-2)] text-[0.85rem] font-medium hover:text-[var(--color-accent)] transition-colors">
          {d.name === 'Merkez' ? `${province.name} Merkez` : d.name}
        </a>
      ))}
    </div>
    <a href={`/${province.slug}-hava-durumu/`} class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-accent)] hover:underline">
      {province.name} hava durumu
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/></svg>
    </a>
  </section>
)}
