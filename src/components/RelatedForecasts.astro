---
import { getPeriodLinks, type PeriodId } from '../lib/periods';

interface Props {
  /** Name used in the anchor text ("Kocaeli", "İzmit", "Adıyaman Merkez"). */
  cityName: string;
  /** Location path without a trailing slash. */
  basePath: string;
  /** The period this page already is - it is not linked to itself. */
  current: PeriodId;
}

const { cityName, basePath, current } = Astro.props;

// Full query-shaped anchor text ("Kocaeli 15 Günlük Hava Durumu"); the tab
// strip uses short labels. Self-links are dropped.
const links = getPeriodLinks(basePath).filter((l) => l.id !== current);
---

<section class="weather-card">
  <h2 class="section-title">{cityName} İçin Diğer Tahminler</h2>
  <div class="grid grid-cols-1 gap-1.5">
    {links.map((link) => (
      <a href={link.href} class="chip-link">
        <span>{cityName} {link.label} Hava Durumu</span>
        <svg class="w-4 h-4 shrink-0 opacity-50" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/></svg>
      </a>
    ))}
  </div>
</section>
