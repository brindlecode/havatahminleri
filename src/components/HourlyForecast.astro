---
import WeatherIcon from './WeatherIcon.astro';
import { formatHour } from '../lib/utils';
import { tempColor } from '../lib/tempScale';
import { smoothPath } from '../lib/curve';
import type { HourlyForecast as HF } from '../lib/weather';

interface Props {
  hourly: HF;
  startIndex?: number;
  endIndex?: number;
  title?: string;
}

const { hourly, startIndex = 0, endIndex = 48, title = 'Saatlik Tahmin' } = Astro.props;

const hours = hourly.time.slice(0, 48).map((time, i) => ({
  time: formatHour(time),
  temp: Math.round(hourly.temperature[i]),
  code: hourly.weatherCode[i],
  precip: hourly.precipitationProbability[i] ?? 0,
  isDay: hourly.isDay[i] === 1,
  index: i,
  raw: time,
})).slice(startIndex, endIndex);

// The temperature curve is one SVG under fixed-width hour columns, so every
// point sits exactly over its hour. Its colour follows the temperature scale
// (top of the chart = the warmest hour's colour).
const COL = 58;
const H = 78;
const TOP = 26;
const width = hours.length * COL;
const temps = hours.map((h) => h.temp);
const tMin = Math.min(...temps);
const tMax = Math.max(...temps);
const span = tMax - tMin || 1;
const pts = hours.map((h, i) => ({
  x: i * COL + COL / 2,
  y: TOP + (1 - (h.temp - tMin) / span) * (H - TOP - 10),
  ...h,
}));
const line = smoothPath(pts);
const area = pts.length ? `${line} L${pts[pts.length - 1].x} ${H} L${pts[0].x} ${H} Z` : '';
const gradId = `hourly-grad-${startIndex}`;
const midnights = pts.filter((p, i) => i > 0 && p.time === '00:00');
const BAR = 22;
---

<section class="weather-card !px-0 !pb-3" id="hourly-forecast">
  <div class="flex items-baseline justify-between gap-3 px-5 mb-2">
    <h2 class="section-title !mb-0" id="hourly-forecast-title">{title}</h2>
    <p class="text-xs text-[var(--color-text-secondary)] flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5"><span class="w-3 h-[3px] rounded-full" style={`background:linear-gradient(90deg, ${tempColor(tMin)}, ${tempColor(tMax)})`}></span>Sıcaklık</span>
      <span class="inline-flex items-center gap-1.5"><span class="w-2 h-2.5 rounded-sm bg-[var(--color-rain)]"></span>Yağış</span>
    </p>
  </div>
  <div class="overflow-x-auto scrollbar-hide" data-hourly-scroller tabindex="0" role="region" aria-labelledby="hourly-forecast-title">
    <div class="relative px-2" style={`width:${width + 16}px`}>
      <div class="flex">
        {hours.map((h) => (
          <div data-hour-index={h.index} data-time={h.raw} class="hour-col flex flex-col items-center shrink-0 transition-opacity" style={`width:${COL}px`}>
            <span class="text-xs font-medium text-[var(--color-text-secondary)] tabular px-2 py-0.5 rounded-full" data-hour-label>{h.time}</span>
            <WeatherIcon code={h.code} isDay={h.isDay} size="w-8 h-8 my-1" decorative />
            <div style={`height:${H}px`} aria-hidden="true"></div>
            <div class="flex items-end justify-center mt-1" style={`height:${BAR}px`} aria-hidden="true">
              <span
                class="w-3.5 rounded-[4px] bg-[var(--color-rain)]"
                style={`height:${Math.max(2, Math.round((h.precip / 100) * BAR))}px;opacity:${(0.18 + (h.precip / 100) * 0.82).toFixed(2)}`}
              ></span>
            </div>
            <span class:list={['text-[0.7rem] font-bold tabular h-4 mt-0.5', h.precip >= 20 ? 'text-[var(--color-rain)]' : 'text-transparent']}>
              %{h.precip}
            </span>
            <span class="sr-only">Saat {h.time}: {h.temp} derece, yağış olasılığı yüzde {h.precip}</span>
          </div>
        ))}
      </div>
      <svg class="absolute left-2 pointer-events-none overflow-visible" style="top:62px" width={width} height={H} viewBox={`0 0 ${width} ${H}`} aria-hidden="true">
        <defs>
          <linearGradient id={gradId} x1="0" y1={TOP} x2="0" y2={H - 10} gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color={tempColor(tMax)} />
            <stop offset="100%" stop-color={tempColor(tMin)} />
          </linearGradient>
        </defs>
        {midnights.map((p) => (
          <line x1={p.x - COL / 2} y1={-58} x2={p.x - COL / 2} y2={H + 40} stroke="var(--color-border)" stroke-width="1" stroke-dasharray="3 3" />
        ))}
        <path d={area} fill={`url(#${gradId})`} opacity="0.16" />
        <path d={line} fill="none" stroke={`url(#${gradId})`} stroke-width="3" stroke-linejoin="round" stroke-linecap="round" />
        {pts.map((p) => (
          <g data-hour-point={p.index}>
            <circle cx={p.x} cy={p.y.toFixed(1)} r="3.2" fill={tempColor(p.temp)} stroke="var(--color-surface)" stroke-width="1.75" />
            <text x={p.x} y={(p.y - 9).toFixed(1)} text-anchor="middle" font-size="13" font-weight="650" fill="currentColor">{p.temp}°</text>
          </g>
        ))}
      </svg>
    </div>
  </div>
</section>
