---
interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-3">
  <ol class="flex items-center gap-1 text-[0.8rem] text-[var(--color-text-secondary)] overflow-x-auto scrollbar-hide whitespace-nowrap">
    <li><a href="/" class="hover:text-[var(--color-text)] transition-colors">Ana Sayfa</a></li>
    {items.map((item, i) => (
      <li class="flex items-center gap-1">
        <span aria-hidden="true" class="opacity-50">/</span>
        {i === items.length - 1 ? (
          <span class="font-medium text-[var(--color-text)]" aria-current="page">{item.name}</span>
        ) : (
          <a href={item.url} class="hover:text-[var(--color-text)] transition-colors">{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
