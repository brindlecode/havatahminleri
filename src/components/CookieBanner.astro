---
// CookieBanner.astro - KVKK ve GDPR uyumlu çerez onay bileşeni
---

<div id="cookie-banner" hidden class="cookie-off fixed z-[100] left-3 right-3 bottom-3 sm:left-5 sm:right-auto sm:bottom-5 sm:max-w-[25rem] rounded-3xl bg-[var(--color-surface)] border border-[var(--color-border)] shadow-[0_24px_60px_-20px_rgba(14,26,43,0.45)] p-4 sm:p-5 transition-[opacity,transform] duration-300" role="dialog" aria-labelledby="cookie-title" aria-describedby="cookie-desc">
  <p id="cookie-title" class="font-display text-base font-semibold text-[var(--color-text)]">Çerez tercihiniz</p>
  <p id="cookie-desc" class="mt-1 text-[0.82rem] text-[var(--color-text-secondary)] leading-relaxed">
    Trafik ölçümü (Google Analytics, Yandex Metrica) ve kişiselleştirilmiş reklam (Google AdSense) için çerezler kullanıyoruz; bunlar yalnızca onayınızla etkinleşir. Tercihinizi sayfa altındaki "Çerez Tercihleri"nden değiştirebilirsiniz.
    <a href="/cerez-politikasi/" class="text-[var(--color-accent)] hover:underline font-medium">Ayrıntılar</a>
  </p>
  <div class="mt-3.5 flex gap-2">
    <button id="cookie-reject" class="flex-1 px-4 py-2.5 text-sm font-semibold text-[var(--color-text)] bg-[var(--color-surface-2)] hover:brightness-95 rounded-full transition">
      Reddet
    </button>
    <button id="cookie-accept" class="flex-1 px-4 py-2.5 text-sm font-semibold text-white bg-[var(--color-accent)] dark:text-[#06101f] hover:opacity-90 rounded-full transition">
      Kabul Et
    </button>
  </div>
</div>

<script is:inline>
  (function() {
    // The initial consent state is applied in BaseLayout's <head>, before any
    // tag fires. This script only shows the banner and records a new choice.
    //
    // Show/hide toggles the .cookie-off class (global.css) rather than
    // style.transform: Tailwind v4 implements translate utilities with the CSS
    // `translate` property, which a `transform` value does not override - the
    // banner once stayed off-screen for every visitor, so nobody could give
    // consent.
    var KEY = 'yh_cookie_consent_v1';
    var banner = document.getElementById('cookie-banner');
    var acceptBtn = document.getElementById('cookie-accept');
    var rejectBtn = document.getElementById('cookie-reject');
    if (!banner) return;

    function showBanner() {
      banner.hidden = false;
      setTimeout(function() { banner.classList.remove('cookie-off'); }, 50);
    }

    function hideBanner() {
      banner.classList.add('cookie-off');
      setTimeout(function() { banner.hidden = true; }, 300);
    }

    function setConsent(granted) {
      var value = granted ? 'granted' : 'denied';
      try {
        localStorage.setItem(KEY, JSON.stringify({ status: value, timestamp: Date.now() }));
      } catch (e) {}
      window.yhConsentStatus = value;

      if (typeof gtag === 'function') {
        gtag('consent', 'update', {
          'ad_storage': value,
          'ad_user_data': value,
          'ad_personalization': value,
          'analytics_storage': value
        });
        gtag('set', 'ads_data_redaction', !granted);
      }
      try {
        window.dispatchEvent(new CustomEvent('yh:consent', { detail: value }));
      } catch (e) {}

      hideBanner();
    }

    // Footer "Çerez Tercihleri" link: consent must be as easy to withdraw as
    // to give.
    window.yhOpenCookieSettings = showBanner;

    if (!window.yhConsentStatus) showBanner();

    if (acceptBtn) acceptBtn.addEventListener('click', function() { setConsent(true); });
    if (rejectBtn) rejectBtn.addEventListener('click', function() { setConsent(false); });
  })();
</script>
