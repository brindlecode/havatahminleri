---
import { getForecastFreshness } from '../lib/freshness';

/**
 * Visible "last updated" line. The value is the moment the forecast was
 * fetched from Open-Meteo (weather-cache.json), never the browser or build
 * clock, so a stale site is visible to readers and to us.
 */
const freshness = getForecastFreshness();
---

<p id="stale-notice" hidden class="text-sm rounded-2xl px-4 py-3 bg-amber-50 text-amber-900 border border-amber-200 dark:bg-amber-950/40 dark:text-amber-100 dark:border-amber-900">
  Yeni günün tahmini hazırlanıyor. Bu sayfadaki bazı bölümler dünün tahminine göre yazıldı; kısa süre içinde güncellenecek.
</p>
{freshness && (
  <p class="text-xs text-[var(--color-text-secondary)] flex items-center gap-1.5 flex-wrap px-1">
    <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
    <span>Son güncelleme: <time datetime={freshness.iso}>{freshness.label}</time> (TSİ)</span>
    <span class="opacity-70 hidden sm:inline">· Veriler günde iki kez, gece yarısı ve öğlen yenilenir · Kaynak: <a href="https://open-meteo.com/" rel="noopener" target="_blank" class="underline">Open-Meteo</a></span>
  </p>
)}
