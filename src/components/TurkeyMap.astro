---
import { tempGradient, tempTint } from '../lib/tempScale';
import { PROVINCE_PATHS, MAP_VIEWBOX } from '../data/turkeyProvinces';

interface Point {
  name: string;
  slug: string;
  plate: number;
  temp: number;
}

interface Props {
  points: Point[];
  /** What the numbers are, e.g. "Bugün öğle". */
  caption: string;
}

// Every province drawn with its real outline, filled with a soft tint of the
// site-wide temperature scale and labelled with its temperature. Each
// province links to its page.
const { points, caption } = Astro.props;

/** Visual centre of a province: area centroid of the path's vertices. */
function centre(d: string): { x: number; y: number; w: number; h: number } {
  const n = d.match(/-?\d+/g)!.map(Number);
  const xs: number[] = [];
  const ys: number[] = [];
  for (let i = 0; i + 1 < n.length; i += 2) { xs.push(n[i]); ys.push(n[i + 1]); }
  let a = 0, cx = 0, cy = 0;
  for (let i = 0; i < xs.length; i++) {
    const j = (i + 1) % xs.length;
    const f = xs[i] * ys[j] - xs[j] * ys[i];
    a += f; cx += (xs[i] + xs[j]) * f; cy += (ys[i] + ys[j]) * f;
  }
  const w = Math.max(...xs) - Math.min(...xs);
  const h = Math.max(...ys) - Math.min(...ys);
  if (Math.abs(a) < 1e-6) return { x: (Math.max(...xs) + Math.min(...xs)) / 2, y: (Math.max(...ys) + Math.min(...ys)) / 2, w, h };
  return { x: cx / (3 * a), y: cy / (3 * a), w, h };
}

// Big cities also get their name; elsewhere the number alone, where it fits.
const NAMED = new Set(['istanbul', 'ankara', 'izmir', 'antalya', 'trabzon', 'erzurum', 'van', 'diyarbakir', 'adana', 'samsun', 'konya']);
const provinces = points
  .filter((p) => PROVINCE_PATHS[p.plate])
  .map((p) => {
    const d = PROVINCE_PATHS[p.plate];
    return { ...p, d, c: centre(d), named: NAMED.has(p.slug) };
  });

const temps = points.map((p) => p.temp);
const lo = Math.min(...temps);
const hi = Math.max(...temps);
---

<div>
  <svg class="tr-map w-full h-auto block" viewBox={MAP_VIEWBOX} role="img" aria-labelledby="tr-map-title">
    <title id="tr-map-title">Türkiye illeri sıcaklık haritası ({caption})</title>
    {provinces.map((p) => (
      <a href={`/${p.slug}-hava-durumu/`} class="tr-prov">
        <title>{p.name}: {p.temp}°</title>
        <path d={p.d} fill={tempTint(p.temp, 0.36)} />
      </a>
    ))}
    {/* Small provinces (Yalova, Kilis, Bartın...) get an invisible round
        target on top so they can still be tapped on a phone. */}
    <g aria-hidden="true">
      {provinces.filter((p) => p.c.w < 50 || p.c.h < 34).map((p) => (
        <a href={`/${p.slug}-hava-durumu/`} tabindex="-1" class="tr-prov">
          <circle cx={p.c.x.toFixed(0)} cy={p.c.y.toFixed(0)} r="34" fill="transparent" />
        </a>
      ))}
    </g>
    <g class="tr-labels" aria-hidden="true">
      {provinces.map((p) => p.named ? (
        <g>
          <text x={p.c.x.toFixed(0)} y={(p.c.y - 6).toFixed(0)} text-anchor="middle" class="tr-name">{p.name}</text>
          <text x={p.c.x.toFixed(0)} y={(p.c.y + 14).toFixed(0)} text-anchor="middle" class="tr-temp">{p.temp}°</text>
        </g>
      ) : p.c.w >= 30 && p.c.h >= 20 ? (
        <text x={p.c.x.toFixed(0)} y={(p.c.y + 6).toFixed(0)} text-anchor="middle" class="tr-temp tr-temp-sm">{p.temp}°</text>
      ) : null)}
    </g>
  </svg>
  <div class="flex items-center gap-2 text-[0.72rem] text-[var(--color-text-secondary)] tabular mt-2">
    <span>{lo}°</span>
    <span class="flex-1 h-1.5 rounded-full" style={`background:${tempGradient(lo, hi)}`}></span>
    <span>{hi}°</span>
    <span class="ml-1">{caption}</span>
  </div>
</div>

<style>
  .tr-prov path {
    stroke: var(--color-surface);
    stroke-width: 1.4;
    stroke-linejoin: round;
    transition: filter 0.15s;
  }
  .tr-prov:hover path,
  .tr-prov:focus-visible path {
    filter: brightness(0.9) saturate(1.25);
  }
  .tr-prov:focus-visible { outline: none; }
  .tr-labels { pointer-events: none; }
  /* A light halo keeps labels readable where a centre falls on a lake or sea. */
  .tr-labels text { paint-order: stroke; stroke: rgba(255, 255, 255, 0.75); stroke-width: 3px; stroke-linejoin: round; }
  .tr-name { font-size: 14px; font-weight: 600; fill: #24364f; }
  .tr-temp { font-family: var(--font-display); font-size: 20px; font-weight: 600; fill: #0e1a2b; letter-spacing: -0.02em; }
  .tr-temp-sm { font-size: 16px; font-weight: 500; fill: #24364f; }
</style>
