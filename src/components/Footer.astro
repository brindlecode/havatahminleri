---
import provinces from '../data/provinces.json';
import regions from '../data/regions.json';

const regionGroups = regions.map((r: any) => ({
  ...r,
  provinces: provinces.filter((p: any) => p.region === r.id),
}));
---

<footer class="mt-8 border-t border-[var(--color-border)] bg-[var(--color-surface)]">
  <div class="max-w-6xl mx-auto px-4 py-10">
    <p class="text-base font-bold mb-5">81 İlin Hava Durumu</p>
    <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-7 gap-x-6 gap-y-5">
      {regionGroups.map((region: any) => (
        <div>
          <p class="text-xs font-semibold text-[var(--color-text-secondary)] mb-2">{region.name}</p>
          <ul class="flex flex-wrap gap-x-3 gap-y-0.5 sm:block sm:space-y-1">
            {region.provinces.map((p: any) => (
              <li>
                <a href={`/${p.slug}-hava-durumu/`} class="text-[0.85rem] hover:text-[var(--color-accent)] transition-colors inline-block py-0.5">
                  {p.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="border-t border-[var(--color-border)]">
    <div class="max-w-6xl mx-auto px-4 py-5 flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-[0.82rem] text-[var(--color-text-secondary)]">
      <p>
        © {new Date().getFullYear()} yarınhava.com · Veri kaynağı:
        <a href="https://open-meteo.com/" target="_blank" rel="noopener" class="underline hover:text-[var(--color-text)]">Open-Meteo</a>
      </p>
      <nav aria-label="Kurumsal" class="flex flex-wrap gap-x-4 gap-y-2">
        <a href="/hakkimizda/" class="hover:text-[var(--color-text)] py-1">Hakkımızda</a>
        <a href="/iletisim/" class="hover:text-[var(--color-text)] py-1">İletişim</a>
        <a href="/gizlilik-politikasi/" class="hover:text-[var(--color-text)] py-1">Gizlilik</a>
        <a href="/cerez-politikasi/" class="hover:text-[var(--color-text)] py-1">Çerez Politikası</a>
        <a href="/kullanim-sartlari/" class="hover:text-[var(--color-text)] py-1">Kullanım Şartları</a>
        <button type="button" onclick="window.yhOpenCookieSettings && window.yhOpenCookieSettings()" class="hover:text-[var(--color-text)] py-1">
          Çerez Tercihleri
        </button>
      </nav>
    </div>
  </div>
</footer>
