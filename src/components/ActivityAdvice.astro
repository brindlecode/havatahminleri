---
import ShareButtons from './ShareButtons.astro';
import { getActivityAdvice } from '../lib/activityAdvice';
import type { PeriodId } from '../lib/periods';
import type { WeatherData } from '../lib/weather';

interface Props {
  weather: WeatherData;
  /** names.display - carries the province for shared district names. */
  cityName: string;
  period: PeriodId;
  /** Canonical URL of the page; shares link to this card on it. */
  canonical: string;
}

const { weather, cityName, period, canonical } = Astro.props;
const advice = getActivityAdvice(weather, period, cityName);
const shareUrl = `${canonical}#oneriler`;

// Verdict ring: how good the day is for the chore, drawn as a filled arc.
const C = 2 * Math.PI * 18;
const SCORE = { good: 0.9, fair: 0.55, poor: 0.2 } as const;
const RING = { good: '#22a06b', fair: '#e2a500', poor: '#e5484d' } as const;
---

{advice && (
  <section id="oneriler" class="weather-card scroll-mt-28" aria-labelledby="oneriler-baslik" data-day-relative>
    <h2 id="oneriler-baslik" class="section-title !mb-1">{advice.heading}</h2>
    <p class="text-sm text-[var(--color-text-secondary)] mb-4 leading-relaxed">{advice.intro}</p>

    <ul class="relative flex gap-2.5 overflow-x-auto scrollbar-hide snap-x snap-mandatory -mx-5 px-5 scroll-px-5 sm:grid sm:grid-cols-3 sm:overflow-visible sm:mx-0 sm:px-0">
      {advice.items.map((item) => {
        const score = SCORE[item.verdict];
        const color = RING[item.verdict];
        return (
          <li class="rounded-2xl bg-[var(--color-surface-2)] p-3.5 flex flex-col shrink-0 w-[82%] snap-start sm:w-auto">
            <div class="flex items-center gap-3">
              <svg class="w-11 h-11 shrink-0" viewBox="0 0 44 44" aria-hidden="true">
                <circle cx="22" cy="22" r="18" fill="none" stroke="currentColor" stroke-opacity=".1" stroke-width="4.5" />
                <circle cx="22" cy="22" r="18" fill="none" stroke={color} stroke-width="4.5" stroke-linecap="round" stroke-dasharray={`${(C * score).toFixed(1)} ${C.toFixed(1)}`} transform="rotate(-90 22 22)" />
                <text x="22" y="27.5" text-anchor="middle" font-size="15">{item.emoji}</text>
              </svg>
              <div class="min-w-0">
                <h3 class="font-bold leading-tight">
                  {item.title} <span class={`verdict-badge verdict-${item.verdict} align-middle ml-1`}>{item.verdictLabel}</span>
                </h3>
                <p class="text-xs text-[var(--color-text-secondary)] mt-1">{item.dayLabel}</p>
              </div>
            </div>
            <p class="mt-3 font-semibold text-[0.95rem] leading-snug">{item.headline}</p>
            <p class="mt-1 text-[0.85rem] text-[var(--color-text-secondary)] leading-relaxed flex-1">{item.detail}</p>
            <div class="mt-3">
              <ShareButtons
                variant="mini"
                text={item.shareText}
                url={shareUrl}
                title={`${item.title} - Yarın Hava`}
                type="activity"
                itemId={item.id}
              />
            </div>
          </li>
        );
      })}
    </ul>

    <div class="mt-4 pt-4 border-t border-[var(--color-border)]">
      <ShareButtons
        variant="compact"
        label="Bu planı paylaş:"
        text={advice.shareText}
        url={shareUrl}
        title={advice.heading}
        type="activity_plan"
      />
    </div>
  </section>
)}
