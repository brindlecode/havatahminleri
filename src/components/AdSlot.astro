---
interface Props {
  id: string;
  className?: string;
}

const { id, className = '' } = Astro.props;
---

<!-- Ad Unit: {id} -->
<div
  id={`ad-${id}`}
  class:list={[
    'my-4',
    className,
  ]}
  data-ad-slot={id}
>
  <!-- Google AdSense / Ezoic unit will be injected here when active -->
</div>
