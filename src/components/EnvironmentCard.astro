---
import { airDay, getAir, getSea, seaDay, waveFeel, AQI_BANDS } from '../lib/extras';
import { tempColor } from '../lib/tempScale';
import provinces from '../data/provinces.json';
import coastal from '../data/coastalPoints.json';

interface Props {
  provinceSlug?: string;
  /** Name used in prose; for a district page the district. */
  cityName: string;
  isDistrict: boolean;
}

// Air quality for today and tomorrow and, in coastal provinces, the sea
// temperature. Both are province-level values; a district page says so.
const { provinceSlug, cityName, isDistrict } = Astro.props;
const prov = provinces.find((p: any) => p.slug === provinceSlug);
const air = prov ? getAir(prov.plate) : null;
const today = airDay(air, 0);
const tomorrow = airDay(air, 1);
const point = prov ? coastal.points.find((p) => p.plate === prov.plate) : undefined;
const sea = point && prov ? getSea(prov.plate) : null;
const seaToday = seaDay(sea, 0);
const seaTomorrow = seaDay(sea, 1);
const where = isDistrict && prov ? `${prov.name} il merkezi` : cityName;
const fmt = (n: number) => n.toLocaleString('tr-TR', { maximumFractionDigits: 1 });
const maxBar = 100;
---

{(today || seaToday) && (
  <section id="hava-kalitesi" class="weather-card scroll-mt-28" aria-labelledby="cevre-baslik" data-day-relative>
    <h2 id="cevre-baslik" class="section-title">
      {seaToday ? `${cityName} hava kalitesi ve deniz suyu` : `${cityName} hava kalitesi`}
    </h2>
    <div class:list={['grid gap-3', today && seaToday && 'sm:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]']}>
      {today && (
        <div class="rounded-2xl bg-[var(--color-surface-2)] p-4">
          <p class="text-[0.8rem] font-semibold text-[var(--color-text-secondary)]">Bugün hava kalitesi</p>
          <p class="mt-1 flex items-center gap-2.5">
            <span class="w-3.5 h-3.5 rounded-full shrink-0" style={`background:${today.band.color}`} aria-hidden="true"></span>
            <span class="font-display text-[1.6rem] font-semibold tracking-[-0.02em] leading-none">{today.band.label}</span>
            <span class="text-sm text-[var(--color-text-secondary)] tabular">AQI {today.typical}</span>
          </p>
          <p class="mt-2 text-[0.88rem] leading-relaxed">
            {today.band.advice}
            {today.worstBand.key !== today.band.key && ` En kötü saat ${String(today.worstHour).padStart(2, '0')}:00 civarı (${today.worstBand.label.toLocaleLowerCase('tr')}, ${today.worst}).`}
          </p>

          <div class="mt-3" aria-hidden="true">
            <div class="flex items-end gap-[2px] h-10">
              {today.hours.map((x) => (
                <i class="flex-1 rounded-[2px] min-h-[3px]" style={`height:${Math.max(8, Math.min(100, (x.aqi / maxBar) * 100))}%;background:${AQI_BANDS.find((b) => x.aqi <= b.max)!.color}`} title={`${x.h}:00 AQI ${x.aqi}`}></i>
              ))}
            </div>
            <div class="flex justify-between text-[0.68rem] text-[var(--color-text-secondary)] tabular mt-1">
              <span>00</span><span>06</span><span>12</span><span>18</span><span>24</span>
            </div>
          </div>

          <dl class="mt-3 pt-3 border-t border-[var(--color-border)] grid grid-cols-3 gap-2 text-[0.8rem]">
            {tomorrow && (
              <div>
                <dt class="text-[var(--color-text-secondary)]">Yarın</dt>
                <dd class="font-semibold">{tomorrow.band.label} <span class="font-normal text-[var(--color-text-secondary)] tabular">({tomorrow.typical})</span></dd>
              </div>
            )}
            {today.pm25 !== null && (
              <div>
                <dt class="text-[var(--color-text-secondary)]">PM2,5</dt>
                <dd class="font-semibold tabular">{today.pm25} <span class="font-normal text-[var(--color-text-secondary)]">µg/m³</span></dd>
              </div>
            )}
            {today.pm10 !== null && (
              <div>
                <dt class="text-[var(--color-text-secondary)]">PM10</dt>
                <dd class="font-semibold tabular">{today.pm10} <span class="font-normal text-[var(--color-text-secondary)]">µg/m³</span></dd>
              </div>
            )}
          </dl>
        </div>
      )}

      {seaToday && point && (
        <div class="rounded-2xl bg-[var(--color-surface-2)] p-4 flex flex-col">
          <p class="text-[0.8rem] font-semibold text-[var(--color-text-secondary)]">Deniz suyu sıcaklığı</p>
          <p class="mt-1 flex items-baseline gap-2">
            <span class="font-display text-[2.2rem] font-semibold tracking-[-0.03em] leading-none tabular">{seaToday.temp}°</span>
            <span class="w-2.5 h-2.5 rounded-full self-center" style={`background:${tempColor(seaToday.temp)}`} aria-hidden="true"></span>
            <span class="text-sm">{seaToday.feel}</span>
          </p>
          <p class="mt-2 text-[0.88rem] leading-relaxed text-[var(--color-text-secondary)] flex-1">
            {point.place} açıklarında, {point.sea === 'Karadeniz' ? 'Karadeniz' : point.sea === 'Akdeniz' ? 'Akdeniz' : point.sea === 'Ege' ? 'Ege Denizi' : 'Marmara Denizi'}.
            {seaToday.wave !== null && ` Dalga boyu en fazla ${fmt(seaToday.wave)} m, ${waveFeel(seaToday.wave)}.`}
            {seaTomorrow && ` Yarın ${seaTomorrow.temp}°.`}
          </p>
          <a href="/deniz-suyu-sicakligi/" class="mt-3 text-[0.85rem] font-semibold text-[var(--color-accent)] hover:underline">Tüm kıyılarda deniz suyu sıcaklığı</a>
        </div>
      )}
    </div>
    <p class="mt-3 text-[0.75rem] text-[var(--color-text-secondary)] leading-relaxed">
      {today && <>Avrupa Hava Kalitesi İndeksi (AQI), {where} için Copernicus (CAMS) tahmini. </>}
      {today && <a href="/hava-kalitesi/" class="font-semibold text-[var(--color-accent)] hover:underline">81 ilin hava kalitesi</a>}
    </p>
  </section>
)}
