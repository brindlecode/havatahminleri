---
import { getUVLevel, getWindDirection, formatHour } from '../lib/utils';
import type { CurrentWeather, DailyForecast } from '../lib/weather';

interface Props {
  current: CurrentWeather;
  daily: DailyForecast;
}

const { current, daily } = Astro.props;
const windDir = getWindDirection(current.windDirection);
const uvInfo = getUVLevel(daily.uvIndexMax[0]);
const sunrise = daily.sunrise[0] ? formatHour(daily.sunrise[0]) : '06:30';
const sunset = daily.sunset[0] ? formatHour(daily.sunset[0]) : '19:30';
const visibilityKm = Math.round(current.visibility / 1000);
---

<section class="weather-card">
  <h2 class="text-lg font-semibold mb-4">Detaylı Hava Bilgileri</h2>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
    <!-- Humidity -->
    <div class="bg-[var(--color-bg)] rounded-xl p-3">
      <div class="flex items-center gap-2 mb-1">
        <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21c-4-4-8-7.5-8-11a8 8 0 1116 0c0 3.5-4 7-8 11z"/>
        </svg>
        <span class="text-xs text-[var(--color-text-secondary)]">Nem</span>
      </div>
      <p class="text-xl font-bold">%{current.humidity}</p>
    </div>

    <!-- Wind -->
    <div class="bg-[var(--color-bg)] rounded-xl p-3">
      <div class="flex items-center gap-2 mb-1">
        <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5a2 2 0 100 4H3m15 4a2 2 0 110 4H3m12-12a2 2 0 100-4H3"/>
        </svg>
        <span class="text-xs text-[var(--color-text-secondary)]">Rüzgar</span>
      </div>
      <p class="text-xl font-bold">{Math.round(current.windSpeed)} <span class="text-xs font-normal">km/s</span></p>
      <p class="text-xs text-[var(--color-text-secondary)]">Yön: {windDir}</p>
    </div>

    <!-- Pressure -->
    <div class="bg-[var(--color-bg)] rounded-xl p-3">
      <div class="flex items-center gap-2 mb-1">
        <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
        </svg>
        <span class="text-xs text-[var(--color-text-secondary)]">Basınç</span>
      </div>
      <p class="text-xl font-bold">{Math.round(current.pressure)} <span class="text-xs font-normal">hPa</span></p>
    </div>

    <!-- Visibility -->
    <div class="bg-[var(--color-bg)] rounded-xl p-3">
      <div class="flex items-center gap-2 mb-1">
        <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
        </svg>
        <span class="text-xs text-[var(--color-text-secondary)]">Görüş Mesafesi</span>
      </div>
      <p class="text-xl font-bold">{visibilityKm} <span class="text-xs font-normal">km</span></p>
    </div>

    <!-- UV Index -->
    <div class="bg-[var(--color-bg)] rounded-xl p-3">
      <div class="flex items-center gap-2 mb-1">
        <svg class="w-4 h-4 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        <span class="text-xs text-[var(--color-text-secondary)]">UV İndeks</span>
      </div>
      <p class="text-xl font-bold">{Math.round(daily.uvIndexMax[0])}</p>
      <p class:list={['text-xs font-medium', uvInfo.color]}>{uvInfo.label}</p>
    </div>

    <!-- Cloud Cover -->
    <div class="bg-[var(--color-bg)] rounded-xl p-3">
      <div class="flex items-center gap-2 mb-1">
        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
        </svg>
        <span class="text-xs text-[var(--color-text-secondary)]">Bulut Oranı</span>
      </div>
      <p class="text-xl font-bold">%{current.cloudCover}</p>
    </div>

    <!-- Sunrise -->
    <div class="bg-[var(--color-bg)] rounded-xl p-3">
      <div class="flex items-center gap-2 mb-1">
        <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v3m0 0l-3-2m3 2l3-2M5.636 5.636l2.122 2.121M3 12h3m-3 0h0m15 0h3m-3 0h0m-2.636-6.364l-2.122 2.121M12 18a6 6 0 100-12"/>
        </svg>
        <span class="text-xs text-[var(--color-text-secondary)]">Gün Doğumu</span>
      </div>
      <p class="text-xl font-bold">{sunrise}</p>
    </div>

    <!-- Sunset -->
    <div class="bg-[var(--color-bg)] rounded-xl p-3">
      <div class="flex items-center gap-2 mb-1">
        <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21v-3m0 0l-3 2m3-2l3 2M5.636 18.364l2.122-2.121M3 12h3m-3 0h0m15 0h3m-3 0h0m-2.636 6.364l-2.122-2.121M12 6a6 6 0 110 12"/>
        </svg>
        <span class="text-xs text-[var(--color-text-secondary)]">Gün Batımı</span>
      </div>
      <p class="text-xl font-bold">{sunset}</p>
    </div>

    <!-- Precipitation -->
    <div class="bg-[var(--color-bg)] rounded-xl p-3">
      <div class="flex items-center gap-2 mb-1">
        <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
        </svg>
        <span class="text-xs text-[var(--color-text-secondary)]">Yağış</span>
      </div>
      <p class="text-xl font-bold">{daily.precipitationSum[0]} <span class="text-xs font-normal">mm</span></p>
      <p class="text-xs text-[var(--color-text-secondary)]">Olasılık: %{daily.precipitationProbabilityMax[0]}</p>
    </div>

    <!-- Feels Like -->
    <div class="bg-[var(--color-bg)] rounded-xl p-3">
      <div class="flex items-center gap-2 mb-1">
        <svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
        <span class="text-xs text-[var(--color-text-secondary)]">Hissedilen</span>
      </div>
      <p class="text-xl font-bold">{Math.round(current.apparentTemperature)}°C</p>
    </div>
  </div>
</section>
