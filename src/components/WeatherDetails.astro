---
import { formatHour, getUVLevel } from '../lib/utils';
import type { CurrentWeather, DailyForecast } from '../lib/weather';

interface Props {
  current: CurrentWeather;
  daily: DailyForecast;
}

const { current, daily } = Astro.props;
// Never invent sun times: show a dash when the API did not return them.
const sunrise = (daily.sunrise[0] && formatHour(daily.sunrise[0])) || '—';
const sunset = (daily.sunset[0] && formatHour(daily.sunset[0])) || '—';
const visibilityKm = Math.round(current.visibility / 1000);
const uv = Math.round(daily.uvIndexMax[0] ?? 0);
const uvLevel = getUVLevel(uv).label;

const tiles = [
  { label: 'Gün doğumu', value: sunrise, icon: 'M12 3v3m-6.4 2.6l1.4 1.4m10-1.4l1.4-1.4M3 16h18M7 16a5 5 0 0110 0M8 20h8' },
  { label: 'Gün batımı', value: sunset, icon: 'M12 9V6m-6.4 2.6l1.4 1.4m10-1.4l1.4-1.4M3 16h18M7 16a5 5 0 0110 0M9 20l3-2 3 2' },
  { label: 'UV indeksi', value: `${uv}`, sub: uvLevel, icon: 'M12 4v2m0 12v2m8-8h-2M6 12H4m12.95 4.95l-1.4-1.4M8.45 8.45l-1.4-1.4m9.9 0l-1.4 1.4M8.45 15.55l-1.4 1.4M12 16a4 4 0 100-8 4 4 0 000 8z' },
  { label: 'Basınç', value: `${Math.round(current.pressure)}`, sub: 'hPa', icon: 'M4 14a8 8 0 1116 0M12 14l3.5-3.5' },
  { label: 'Görüş', value: `${visibilityKm}`, sub: 'km', icon: 'M2.5 12s3.5-6.5 9.5-6.5S21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12zM12 14.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5z' },
  { label: 'Bulut', value: `%${current.cloudCover}`, icon: 'M7 18h10a4 4 0 00.6-7.96A6 6 0 006.2 11.1 3.5 3.5 0 007 18z' },
];
---

<section class="weather-card">
  <h2 class="section-label">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h10"/></svg>
    Günün Detayları
  </h2>
  <dl class="grid grid-cols-3 gap-2">
    {tiles.map((t) => (
      <div class="rounded-2xl bg-[var(--color-surface-2)] px-3 py-2.5">
        <dt class="flex items-center gap-1.5 text-[0.72rem] text-[var(--color-text-secondary)]">
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d={t.icon} /></svg>
          {t.label}
        </dt>
        <dd class="mt-0.5 text-lg font-semibold tabular leading-tight">
          {t.value}{t.sub && <span class="text-xs font-medium text-[var(--color-text-secondary)]"> {t.sub}</span>}
        </dd>
      </div>
    ))}
  </dl>
  <p class="text-xs text-[var(--color-text-secondary)] mt-3">Basınç, görüş ve bulut oranı bugün öğle saatleri (12:00) için tahmindir.</p>
</section>
