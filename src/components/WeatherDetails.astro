---
import { formatHour, getUVLevel } from '../lib/utils';
import type { CurrentWeather, DailyForecast } from '../lib/weather';

interface Props {
  current: CurrentWeather;
  daily: DailyForecast;
}

const { current, daily } = Astro.props;
// Never invent sun times: show a dash when the API did not return them.
const sunrise = (daily.sunrise[0] && formatHour(daily.sunrise[0])) || '—';
const sunset = (daily.sunset[0] && formatHour(daily.sunset[0])) || '—';
const toMin = (s: string) => (/^\d\d:\d\d$/.test(s) ? Number(s.slice(0, 2)) * 60 + Number(s.slice(3)) : null);
const riseMin = toMin(sunrise);
const setMin = toMin(sunset);
const dayLength = riseMin !== null && setMin !== null && setMin > riseMin
  ? `${Math.floor((setMin - riseMin) / 60)} sa ${(setMin - riseMin) % 60} dk`
  : null;

const visibilityKm = Math.round(current.visibility / 1000);
const uv = Math.round(daily.uvIndexMax[0] ?? 0);
const uvLevel = getUVLevel(uv).label;
const uvPos = Math.min(100, Math.max(0, (uv / 11) * 100));

const DIR_NAMES = ['Kuzey', 'Kuzeydoğu', 'Doğu', 'Güneydoğu', 'Güney', 'Güneybatı', 'Batı', 'Kuzeybatı'];
const windFrom = DIR_NAMES[Math.round((current.windDirection ?? 0) / 45) % 8];
const windSpeed = Math.round(current.windSpeed);
const windMax = Math.round(daily.windSpeedMax?.[0] ?? current.windSpeed);
// The arrow shows where the wind blows to, i.e. away from its source.
const arrowDeg = ((current.windDirection ?? 0) + 180) % 360;
const ticks = Array.from({ length: 24 }, (_, i) => i * 15);

const pressure = Math.round(current.pressure);
---

<section class="weather-card" aria-labelledby="details-title">
  <h2 id="details-title" class="section-title">Günün Detayları</h2>
  <dl class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
    <div class="rounded-2xl bg-[var(--color-surface-2)] p-3.5 col-span-2 sm:col-span-1">
      <dt class="tile-label">Gün ışığı</dt>
      <dd class="mt-1">
        <svg class="w-full max-w-[13rem] h-auto block mx-auto" viewBox="0 0 160 84" aria-hidden="true">
          <defs>
            <linearGradient id="sun-arc" x1="0" x2="1">
              <stop offset="0" stop-color="#f6b26b" />
              <stop offset=".5" stop-color="#ffc23d" />
              <stop offset="1" stop-color="#ea8b66" />
            </linearGradient>
          </defs>
          <line x1="6" y1="68" x2="154" y2="68" stroke="var(--color-border)" stroke-width="1.5" />
          <path d="M18 68 A62 62 0 0 1 142 68" fill="none" stroke="url(#sun-arc)" stroke-width="3" stroke-linecap="round" />
          <circle cx="80" cy="6" r="7" fill="#ffc23d" />
          <text x="18" y="82" text-anchor="middle" font-size="11" font-weight="700" fill="currentColor">{sunrise}</text>
          <text x="142" y="82" text-anchor="middle" font-size="11" font-weight="700" fill="currentColor">{sunset}</text>
        </svg>
        <p class="text-xs text-[var(--color-text-secondary)] mt-1 text-center">
          Doğuş {sunrise} · Batış {sunset}{dayLength && <span class="block">Gün uzunluğu {dayLength}</span>}
        </p>
      </dd>
    </div>

    <div class="rounded-2xl bg-[var(--color-surface-2)] p-3.5">
      <dt class="tile-label">Rüzgar</dt>
      <dd class="mt-1.5">
        <div class="flex items-center gap-2.5">
        <svg class="w-12 h-12 shrink-0" viewBox="0 0 72 72" aria-hidden="true">
          <circle cx="36" cy="36" r="30" fill="none" stroke="var(--color-border)" stroke-width="1.5" />
          {ticks.map((t) => {
            const a = (t * Math.PI) / 180;
            const r1 = t % 90 === 0 ? 24 : 27;
            return <line x1={(36 + r1 * Math.sin(a)).toFixed(1)} y1={(36 - r1 * Math.cos(a)).toFixed(1)} x2={(36 + 30 * Math.sin(a)).toFixed(1)} y2={(36 - 30 * Math.cos(a)).toFixed(1)} stroke="var(--color-border)" stroke-width="1" />;
          })}
          <text x="36" y="16" text-anchor="middle" font-size="8.5" font-weight="800" fill="var(--color-text-secondary)">K</text>
          <g transform={`rotate(${arrowDeg} 36 36)`}>
            <path d="M36 15 L41.5 39 L36 34.5 L30.5 39 Z" fill="var(--color-accent)" />
            <line x1="36" y1="35" x2="36" y2="56" stroke="var(--color-accent)" stroke-width="2.2" stroke-linecap="round" />
          </g>
        </svg>
          <p class="font-display text-2xl font-medium tabular leading-none whitespace-nowrap">{windSpeed}<span class="font-sans text-xs font-semibold text-[var(--color-text-secondary)]"> km/s</span></p>
        </div>
        <p class="text-xs text-[var(--color-text-secondary)] mt-1.5 leading-snug">{windFrom} yönünden. Gün içinde en fazla {windMax} km/s.</p>
      </dd>
    </div>

    <div class="rounded-2xl bg-[var(--color-surface-2)] p-3.5">
      <dt class="tile-label">UV indeksi</dt>
      <dd class="mt-1.5">
        <p class="font-display text-2xl font-medium tabular leading-none">{uv} <span class="font-sans text-sm font-semibold text-[var(--color-text-secondary)]">{uvLevel}</span></p>
        <div class="relative h-1.5 rounded-full mt-3" style="background:linear-gradient(90deg,#3fbf6a,#e8d23a 30%,#f5a23a 55%,#e5484d 75%,#8e4fd6)" aria-hidden="true">
          <span class="absolute top-1/2 w-3 h-3 rounded-full bg-[var(--color-surface)] border-[2.5px] border-[var(--color-text)] -translate-x-1/2 -translate-y-1/2" style={`left:${uvPos}%`}></span>
        </div>
        <p class="text-xs text-[var(--color-text-secondary)] mt-2 leading-snug">{uv >= 6 ? 'Öğle saatlerinde güneşten korun.' : uv >= 3 ? 'Uzun süre güneşte kalacaksan krem sür.' : 'Koruma gerekmez.'}</p>
      </dd>
    </div>

    <div class="rounded-2xl bg-[var(--color-surface-2)] p-3.5">
      <dt class="tile-label">Basınç</dt>
      <dd class="mt-1.5">
        <p class="font-display text-2xl font-medium tabular leading-none">{pressure}<span class="font-sans text-xs font-semibold text-[var(--color-text-secondary)]"> hPa</span></p>
        <p class="text-xs text-[var(--color-text-secondary)] mt-1.5">{pressure < 1005 ? 'Alçak basınç; hava değişken.' : pressure > 1022 ? 'Yüksek basınç; hava durgun.' : 'Normal seviyede.'}</p>
      </dd>
    </div>

    <div class="rounded-2xl bg-[var(--color-surface-2)] p-3.5">
      <dt class="tile-label">Görüş</dt>
      <dd class="mt-1.5">
        <p class="font-display text-2xl font-medium tabular leading-none">{visibilityKm}<span class="font-sans text-xs font-semibold text-[var(--color-text-secondary)]"> km</span></p>
        <p class="text-xs text-[var(--color-text-secondary)] mt-1.5">{visibilityKm < 2 ? 'Sis veya pus var.' : visibilityKm < 8 ? 'Orta görüş.' : 'Açık görüş.'}</p>
      </dd>
    </div>

    <div class="rounded-2xl bg-[var(--color-surface-2)] p-3.5 col-span-2 sm:col-span-1">
      <dt class="tile-label">Bulut</dt>
      <dd class="mt-1.5">
        <p class="font-display text-2xl font-medium tabular leading-none">%{current.cloudCover}</p>
        <div class="range-track mt-3" aria-hidden="true"><i style={`left:0;width:${Math.min(100, current.cloudCover)}%;background:var(--color-text-secondary);opacity:.55`}></i></div>
      </dd>
    </div>
  </dl>
  <p class="text-xs text-[var(--color-text-secondary)] mt-3">Rüzgar, basınç, görüş ve bulut oranı bugün öğle saatleri (12:00) için tahmindir.</p>
</section>
