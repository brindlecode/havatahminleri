---
import WeatherIcon from './WeatherIcon.astro';
import { getWeatherDescription } from '../lib/weatherCodes';
import { getDayName, formatShortDate } from '../lib/utils';
import type { DailyForecast as DF } from '../lib/weather';

interface Props {
  daily: DF;
  title?: string;
}

const { daily, title = '15 Günlük Hava Tahmini' } = Astro.props;

const days = daily.time.map((time, i) => ({
  date: time,
  dayName: getDayName(time),
  shortDate: formatShortDate(time),
  code: daily.weatherCode[i],
  max: Math.round(daily.temperatureMax[i]),
  min: Math.round(daily.temperatureMin[i]),
  description: getWeatherDescription(daily.weatherCode[i]),
  precip: daily.precipitationSum[i],
  precipProb: daily.precipitationProbabilityMax[i],
}));

const globalMin = Math.min(...days.map((d) => d.min));
const globalMax = Math.max(...days.map((d) => d.max));
const range = globalMax - globalMin || 1;

// Colour of a temperature on a cold-to-hot scale, for the range bars.
function tempColor(t: number): string {
  const stops: [number, string][] = [
    [-10, '#6366f1'], [0, '#3b82f6'], [8, '#06b6d4'], [15, '#22c55e'],
    [22, '#eab308'], [28, '#f97316'], [35, '#ef4444'],
  ];
  if (t <= stops[0][0]) return stops[0][1];
  for (let i = 1; i < stops.length; i++) if (t <= stops[i][0]) return stops[i][1];
  return stops[stops.length - 1][1];
}
---

<section class="weather-card" id="daily-forecast">
  <h2 class="section-label">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path stroke-linecap="round" d="M3.5 10h17M8 3v4M16 3v4"/></svg>
    {title}
  </h2>
  <ul class="divide-y divide-[var(--color-border)] -my-1">
    {days.map((day, index) => {
      const left = ((day.min - globalMin) / range) * 100;
      const width = Math.max(((day.max - day.min) / range) * 100, 6);
      return (
        <li data-day-index={index} data-date={day.date} class="grid grid-cols-[5.5rem_2.5rem_2rem_1fr_2.25rem] sm:grid-cols-[7.5rem_3rem_2.5rem_1fr_2.5rem_9rem] items-center gap-x-2 sm:gap-x-3 py-2.5">
          <div class="min-w-0">
            <p class="text-[0.95rem] font-semibold leading-tight capitalize" data-day-label>{day.dayName}</p>
            <p class="text-xs text-[var(--color-text-secondary)] tabular">{day.shortDate}</p>
          </div>
          <div class="flex flex-col items-center leading-none">
            <WeatherIcon code={day.code} size="w-8 h-8" decorative />
            <span class:list={['text-[0.68rem] font-semibold tabular mt-0.5', day.precipProb >= 20 ? 'text-sky-700 dark:text-sky-300' : 'invisible']}>
              %{day.precipProb ?? 0}
            </span>
          </div>
          <span class="text-[0.95rem] text-[var(--color-text-secondary)] tabular text-right">{day.min}°</span>
          <div class="h-1.5 rounded-full bg-[var(--color-surface-2)] relative mx-1" aria-hidden="true">
            <div
              class="absolute inset-y-0 rounded-full"
              style={`left:${left}%;width:${width}%;background:linear-gradient(90deg, ${tempColor(day.min)}, ${tempColor(day.max)})`}
            ></div>
          </div>
          <span class="text-[0.95rem] font-semibold tabular">{day.max}°</span>
          <span class="hidden sm:block text-xs text-[var(--color-text-secondary)] truncate text-right">{day.description}</span>
          <span class="sr-only">{day.description}. En düşük {day.min}, en yüksek {day.max} derece.</span>
        </li>
      );
    })}
  </ul>
</section>
