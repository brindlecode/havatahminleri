---
import { getWeatherDescription } from '../lib/weatherCodes';

interface Props {
  code: number;
  isDay?: boolean;
  size?: string;
  label?: string;
  decorative?: boolean;
}

const { code, isDay = true, size = 'w-12 h-12', label, decorative = false } = Astro.props;
const accessibleLabel = decorative ? null : (label ?? getWeatherDescription(code));

function getIconSVG(code: number, isDay: boolean): string {
  // Clear
  if (code === 0) {
    return isDay
      ? `<circle cx="24" cy="24" r="8" fill="#FBBF24"/><g stroke="#FBBF24" stroke-width="2" stroke-linecap="round"><line x1="24" y1="6" x2="24" y2="10"/><line x1="24" y1="38" x2="24" y2="42"/><line x1="6" y1="24" x2="10" y2="24"/><line x1="38" y1="24" x2="42" y2="24"/><line x1="11.3" y1="11.3" x2="14.1" y2="14.1"/><line x1="33.9" y1="33.9" x2="36.7" y2="36.7"/><line x1="11.3" y1="36.7" x2="14.1" y2="33.9"/><line x1="33.9" y1="14.1" x2="36.7" y2="11.3"/></g>`
      : `<path d="M34 22A12 12 0 1 1 18.1 10.1 9 9 0 1 0 34 22z" fill="#CBD5E1"/>`;
  }
  // Mostly clear
  if (code === 1) {
    return isDay
      ? `<circle cx="20" cy="20" r="7" fill="#FBBF24"/><g stroke="#FBBF24" stroke-width="2" stroke-linecap="round"><line x1="20" y1="5" x2="20" y2="8"/><line x1="20" y1="32" x2="20" y2="35"/><line x1="5" y1="20" x2="8" y2="20"/><line x1="32" y1="20" x2="35" y2="20"/></g><path d="M30 30c0-3.3 2.7-6 6-6s6 2.7 6 6-2.7 6-6 6H20c-4.4 0-8-3.6-8-8s3.6-8 8-8c1 0 2 .2 2.8.5" fill="#E2E8F0" opacity="0.8"/>`
      : `<path d="M30 20A10 10 0 1 1 17 10a7 7 0 1 0 13 10z" fill="#CBD5E1"/><path d="M34 34c0-2.8 2.2-5 5-5s5 2.2 5 5-2.2 5-5 5H24c-3.9 0-7-3.1-7-7s3.1-7 7-7" fill="#94A3B8" opacity="0.6"/>`;
  }
  // Partly cloudy
  if (code === 2) {
    return isDay
      ? `<circle cx="18" cy="18" r="6" fill="#FBBF24"/><g stroke="#FBBF24" stroke-width="1.5" stroke-linecap="round"><line x1="18" y1="6" x2="18" y2="9"/><line x1="18" y1="27" x2="18" y2="30"/><line x1="6" y1="18" x2="9" y2="18"/><line x1="27" y1="18" x2="30" y2="18"/></g><path d="M32 32c0-4 3.2-7 7-7 3.9 0 7 3 7 7s-3.1 7-7 7H18c-5 0-9-4-9-9s4-9 9-9c1.5 0 3 .3 4.2 1" fill="#E2E8F0"/>`
      : `<path d="M30 18A10 10 0 1 1 16 9a8 8 0 1 0 14 9z" fill="#CBD5E1"/><path d="M32 32c0-4 3-7 7-7s7 3 7 7-3 7-7 7H18c-5 0-9-4-9-9s4-9 9-9c1.5 0 3 .3 4.2 1" fill="#94A3B8"/>`;
  }
  // Overcast
  if (code === 3) {
    return `<path d="M14 34c-4.4 0-8-3.6-8-8s3.6-8 8-8c.8 0 1.6.1 2.3.3C17.6 14.3 21.4 12 26 12c6.1 0 11 4.9 11 11 0 .3 0 .7-.1 1 2.9.5 5.1 3.1 5.1 6.2 0 3.5-2.8 6.3-6.2 6.3H14z" fill="#94A3B8"/><path d="M10 38c-3.3 0-6-2.7-6-6s2.7-6 6-6c.6 0 1.2.1 1.7.2C12.8 23 16 20.5 20 20.5c4.6 0 8.3 3.7 8.3 8.3 0 .2 0 .5-.1.7 2.2.4 3.8 2.3 3.8 4.7 0 2.6-2.1 4.8-4.7 4.8H10z" fill="#CBD5E1"/>`;
  }
  // Fog
  if (code === 45 || code === 48) {
    return `<path d="M6 18h36" stroke="#94A3B8" stroke-width="3" stroke-linecap="round"/><path d="M10 24h28" stroke="#94A3B8" stroke-width="3" stroke-linecap="round" opacity="0.7"/><path d="M6 30h36" stroke="#94A3B8" stroke-width="3" stroke-linecap="round" opacity="0.5"/><path d="M10 36h28" stroke="#94A3B8" stroke-width="3" stroke-linecap="round" opacity="0.3"/>`;
  }
  // Drizzle
  if (code >= 51 && code <= 57) {
    return `<path d="M14 26c-3.3 0-6-2.7-6-6s2.7-6 6-6c.5 0 1 .1 1.4.2C16.5 11 19.9 9 24 9c5.5 0 10 4.5 10 10 0 .4 0 .8-.1 1.2 2.4.6 4.1 2.7 4.1 5.2 0 3-2.4 5.4-5.4 5.4H14z" fill="#94A3B8"/><circle cx="16" cy="34" r="1.2" fill="#60A5FA"/><circle cx="24" cy="36" r="1.2" fill="#60A5FA"/><circle cx="32" cy="34" r="1.2" fill="#60A5FA"/>`;
  }
  // Rain
  if (code >= 61 && code <= 67 || code >= 80 && code <= 82) {
    const heavy = code === 65 || code === 67 || code === 82;
    return `<path d="M14 24c-3.3 0-6-2.7-6-6s2.7-6 6-6c.5 0 1 .1 1.4.2C16.5 9 19.9 7 24 7c5.5 0 10 4.5 10 10 0 .4 0 .8-.1 1.2 2.4.6 4.1 2.7 4.1 5.2 0 3-2.4 5.4-5.4 5.4H14z" fill="#64748B"/><line x1="16" y1="30" x2="14" y2="38" stroke="#3B82F6" stroke-width="2" stroke-linecap="round"/><line x1="24" y1="30" x2="22" y2="38" stroke="#3B82F6" stroke-width="2" stroke-linecap="round"/><line x1="32" y1="30" x2="30" y2="38" stroke="#3B82F6" stroke-width="2" stroke-linecap="round"/>${heavy ? '<line x1="20" y1="32" x2="18" y2="40" stroke="#3B82F6" stroke-width="2" stroke-linecap="round"/><line x1="28" y1="32" x2="26" y2="40" stroke="#3B82F6" stroke-width="2" stroke-linecap="round"/>' : ''}`;
  }
  // Snow
  if (code >= 71 && code <= 77 || code >= 85 && code <= 86) {
    return `<path d="M14 24c-3.3 0-6-2.7-6-6s2.7-6 6-6c.5 0 1 .1 1.4.2C16.5 9 19.9 7 24 7c5.5 0 10 4.5 10 10 0 .4 0 .8-.1 1.2 2.4.6 4.1 2.7 4.1 5.2 0 3-2.4 5.4-5.4 5.4H14z" fill="#94A3B8"/><circle cx="16" cy="32" r="2" fill="#DBEAFE"/><circle cx="24" cy="34" r="2" fill="#DBEAFE"/><circle cx="32" cy="32" r="2" fill="#DBEAFE"/><circle cx="20" cy="38" r="1.5" fill="#DBEAFE"/><circle cx="28" cy="38" r="1.5" fill="#DBEAFE"/>`;
  }
  // Thunderstorm
  if (code >= 95) {
    return `<path d="M14 22c-3.3 0-6-2.7-6-6s2.7-6 6-6c.5 0 1 .1 1.4.2C16.5 7 19.9 5 24 5c5.5 0 10 4.5 10 10 0 .4 0 .8-.1 1.2 2.4.6 4.1 2.7 4.1 5.2 0 3-2.4 5.4-5.4 5.4H14z" fill="#475569"/><path d="M22 26l-3 8h6l-3 8" stroke="#FBBF24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>`;
  }
  // Default/Unknown
  return `<circle cx="24" cy="24" r="10" fill="#94A3B8" opacity="0.5"/><text x="24" y="28" text-anchor="middle" fill="white" font-size="12">?</text>`;
}

const svgContent = getIconSVG(code, isDay);
---

{accessibleLabel ? (
  <svg
    class={size}
    viewBox="0 0 48 48"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label={accessibleLabel}
    set:html={`<title>${accessibleLabel}</title>${svgContent}`}
  />
) : (
  <svg
    class={size}
    viewBox="0 0 48 48"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    set:html={svgContent}
  />
)}
