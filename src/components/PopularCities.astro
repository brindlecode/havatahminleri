---
import WeatherIcon from './WeatherIcon.astro';
import { getWeatherDescription } from '../lib/weatherCodes';
import { getSkyClass } from '../lib/sky';

interface CityWeather {
  name: string;
  slug: string;
  temperature: number;
  weatherCode: number;
  max: number;
  min: number;
  lat?: number;
  lon?: number;
}

interface Props {
  cities: CityWeather[];
}

const { cities } = Astro.props;
---

<section>
  <div class="flex items-baseline justify-between mb-3">
    <h2 class="text-xl font-bold tracking-tight">Popüler Şehirler</h2>
    <span class="text-xs text-[var(--color-text-secondary)]">Bugün öğle tahmini</span>
  </div>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
    {cities.map((city) => (
      <a
        href={`/${city.slug}-hava-durumu/`}
        class:list={['sky rounded-3xl p-4 flex flex-col min-h-[8.5rem] hover:brightness-105 transition', getSkyClass(city.weatherCode, true)]}
      >
        <div class="flex items-start justify-between gap-2">
          <h3 class="text-[0.95rem] font-semibold leading-tight">{city.name}</h3>
          <WeatherIcon code={city.weatherCode} size="w-9 h-9 -mt-1 -mr-1" decorative />
        </div>
        <p class="mt-auto text-4xl font-light tracking-tight tabular">{Math.round(city.temperature)}°</p>
        <p class="text-xs text-white/85 leading-snug">{getWeatherDescription(city.weatherCode)} · {Math.round(city.max)}° / {Math.round(city.min)}°</p>
      </a>
    ))}
  </div>
</section>
