---
import WeatherIcon from './WeatherIcon.astro';
import { getTempColorClass } from '../lib/utils';
import { getWeatherDescription } from '../lib/weatherCodes';

interface CityWeather {
  name: string;
  slug: string;
  temperature: number;
  weatherCode: number;
  max: number;
  min: number;
}

interface Props {
  cities: CityWeather[];
}

const { cities } = Astro.props;
---

<section>
  <h2 class="text-xl font-bold mb-4">Popüler Şehirler</h2>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
    {cities.map((city) => (
      <a
        href={`/${city.slug}-hava-durumu`}
        class="weather-card group cursor-pointer flex flex-col items-center text-center p-4 hover:scale-[1.02] transition-transform"
      >
        <h3 class="text-sm font-semibold mb-2 group-hover:text-primary-500 transition-colors">
          {city.name}
        </h3>
        <WeatherIcon code={city.weatherCode} size="w-12 h-12" />
        <p class:list={['text-2xl font-bold mt-1', getTempColorClass(city.temperature)]}>
          {Math.round(city.temperature)}°
        </p>
        <p class="text-xs text-[var(--color-text-secondary)] mt-0.5">
          {getWeatherDescription(city.weatherCode)}
        </p>
        <div class="flex gap-2 text-xs text-[var(--color-text-secondary)] mt-1">
          <span>↑{Math.round(city.max)}°</span>
          <span>↓{Math.round(city.min)}°</span>
        </div>
      </a>
    ))}
  </div>
</section>
