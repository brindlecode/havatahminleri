---
import WeatherIcon from './WeatherIcon.astro';
import { getWeatherDescription } from '../lib/weatherCodes';
import { weekdayName, dayMonth } from '../lib/periodSummary';
import type { DailyForecast } from '../lib/weather';

interface Props {
  daily: DailyForecast;
  /** names.display - carries the province for shared district names. */
  cityName: string;
  /** The location's main page, which carries tomorrow's hourly forecast. */
  href: string;
}

// Most "yarınki hava durumu" searches land on the 7/10/15-day pages rather
// than the base page (Search Console, Apr-Oct 2026), so those pages answer
// "tomorrow" above the fold instead of in the second row of a long table.
// `data-day-relative` lets weather-now.js hide it after midnight, before the
// next build, when "yarın" would mean the wrong day.
const { daily, cityName, href } = Astro.props;
const i = 1;
const has = daily.time.length > i;
const date = has ? daily.time[i] : '';
const hi = has ? Math.round(daily.temperatureMax[i]) : 0;
const lo = has ? Math.round(daily.temperatureMin[i]) : 0;
const code = has ? daily.weatherCode[i] : 0;
const prob = has ? daily.precipitationProbabilityMax[i] : null;
const wind = has ? Math.round(daily.windSpeedMax[i]) : null;
---

{has && (
  <section class="weather-card" aria-labelledby="tomorrow-glance-title" data-day-relative>
    <h2 id="tomorrow-glance-title" class="section-title !mb-0">{cityName} Yarınki Hava Durumu</h2>
    <div class="mt-3 flex items-center gap-3 sm:gap-4">
      <WeatherIcon code={code} size="w-12 h-12 sm:w-14 sm:h-14 shrink-0" decorative />
      <div class="min-w-0 flex-1">
        <p class="font-semibold leading-tight">{weekdayName(date)}, {dayMonth(date)}</p>
        <p class="text-sm text-[var(--color-text-secondary)] mt-0.5">{getWeatherDescription(code)}</p>
      </div>
      <p class="font-display text-2xl sm:text-3xl font-medium tabular leading-none whitespace-nowrap">
        {hi}°<span class="text-[var(--color-text-secondary)] text-lg sm:text-xl"> / {lo}°</span>
      </p>
    </div>
    <div class="mt-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-sm">
      <p class="text-[var(--color-text-secondary)]">
        {prob !== null && <span>Yağış olasılığı %{prob}</span>}
        {prob !== null && wind !== null && <span> · </span>}
        {wind !== null && <span>Rüzgar en fazla {wind} km/s</span>}
      </p>
      <a href={href} class="font-semibold text-[var(--color-accent)] hover:underline">Yarın saat saat →</a>
    </div>
  </section>
)}
