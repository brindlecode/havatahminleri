---
import WeatherIcon from './WeatherIcon.astro';
import { getWeatherDescription } from '../lib/weatherCodes';
import { getWindDirection, formatDate } from '../lib/utils';
import { getSkyClass } from '../lib/sky';
import type { CurrentWeather as CW, DailyForecast, HourlyForecast } from '../lib/weather';

interface Props {
  cityName: string;
  current: CW;
  daily: DailyForecast;
  hourly?: HourlyForecast;
  heading?: string;
}

const { cityName, current, daily, hourly, heading } = Astro.props;
const h1Text = heading || `${cityName} Hava Durumu`;
const description = getWeatherDescription(current.weatherCode);
const windDir = getWindDirection(current.windDirection);
const todayMax = daily.temperatureMax[0];
const todayMin = daily.temperatureMin[0];
const todayLabel = daily.time[0] ? formatDate(daily.time[0], { day: 'numeric', month: 'long', weekday: 'long' }) : '';
const sky = getSkyClass(current.weatherCode, current.isDay);
const precipProb = daily.precipitationProbabilityMax?.[0];

// The page is built once a day, so the static numbers describe today at noon.
// weather-now.js swaps in the forecast for the visitor's current hour from
// this compact hourly table - no API call from the browser.
const asOf = current.hour ? `Bugün ${current.hour.slice(11, 16)} tahmini` : 'Bugün için tahmin';
const r = (v: number | undefined) => (typeof v === 'number' ? Math.round(v) : null);
const hourlyJson = hourly
  ? JSON.stringify({
      t: hourly.time.slice(0, 48),
      v: hourly.temperature.slice(0, 48).map(r),
      a: (hourly.apparentTemperature ?? []).slice(0, 48).map(r),
      c: hourly.weatherCode.slice(0, 48),
      h: hourly.humidity.slice(0, 48).map(r),
      w: hourly.windSpeed.slice(0, 48).map(r),
      d: (hourly.windDirection ?? []).slice(0, 48).map(r),
      i: hourly.isDay.slice(0, 48),
      n: Object.fromEntries(
        [...new Set(hourly.weatherCode.slice(0, 48))].map((c) => [c, getWeatherDescription(c)]),
      ),
    })
  : null;
---

<section id="current-weather" class:list={['sky rounded-[1.75rem] overflow-hidden px-5 pt-5 pb-5 sm:px-8 sm:pt-7 sm:pb-7', sky]} data-sky={sky}>
  {hourlyJson && <script type="application/json" id="hourly-data" set:html={hourlyJson} />}

  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <h1 class="text-[1.45rem] sm:text-[1.9rem] font-bold leading-tight tracking-tight">{h1Text}</h1>
      {todayLabel && <p class="text-sm text-white/80 mt-1 capitalize">{todayLabel}</p>}
    </div>
    <div class="shrink-0 -mt-1 drop-shadow-[0_6px_14px_rgba(0,0,0,0.18)]">
      <WeatherIcon code={current.weatherCode} isDay={current.isDay} size="w-16 h-16 sm:w-20 sm:h-20" decorative />
    </div>
  </div>

  <div class="mt-4 sm:mt-6 flex items-end gap-4 sm:gap-6">
    <p id="weather-temp" class="text-[5.25rem] sm:text-[6.75rem] font-extralight leading-[0.9] tracking-tighter tabular">
      {Math.round(current.temperature)}°
    </p>
    <div class="pb-2 min-w-0">
      <p id="weather-desc" class="text-lg sm:text-xl font-semibold leading-snug">{description}</p>
      <p class="text-sm text-white/85 mt-0.5 tabular">
        En yüksek <span id="weather-high">{Math.round(todayMax)}</span>° · En düşük <span id="weather-low">{Math.round(todayMin)}</span>°
      </p>
      <p id="weather-asof" class="text-xs text-white/70 mt-1">{asOf}</p>
    </div>
  </div>

  <dl class="mt-5 sm:mt-7 grid grid-cols-4 gap-2 sm:gap-3">
    <div class="sky-panel px-2.5 py-2 sm:px-3 sm:py-2.5">
      <dt class="text-[0.7rem] sm:text-xs text-white/75">Hissedilen</dt>
      <dd class="text-base sm:text-lg font-semibold tabular"><span id="weather-feels">{Math.round(current.apparentTemperature)}</span>°</dd>
    </div>
    <div class="sky-panel px-2.5 py-2 sm:px-3 sm:py-2.5">
      <dt class="text-[0.7rem] sm:text-xs text-white/75">Nem</dt>
      <dd class="text-base sm:text-lg font-semibold tabular">%<span id="weather-humidity">{current.humidity}</span></dd>
    </div>
    <div class="sky-panel px-2.5 py-2 sm:px-3 sm:py-2.5">
      <dt class="text-[0.7rem] sm:text-xs text-white/75">Rüzgar</dt>
      <dd class="text-base sm:text-lg font-semibold tabular leading-tight">
        <span id="weather-wind">{Math.round(current.windSpeed)}</span><span class="text-[0.7rem] font-medium"> km/s</span>
        <span class="block text-[0.7rem] font-medium text-white/75" id="weather-winddir">{windDir}</span>
      </dd>
    </div>
    <div class="sky-panel px-2.5 py-2 sm:px-3 sm:py-2.5">
      <dt class="text-[0.7rem] sm:text-xs text-white/75">Yağış</dt>
      <dd class="text-base sm:text-lg font-semibold tabular leading-tight">
        %{precipProb ?? 0}
        <span class="block text-[0.7rem] font-medium text-white/75"><span id="weather-precip">{daily.precipitationSum[0]}</span> mm</span>
      </dd>
    </div>
  </dl>
  <p class="sr-only">UV indeksi: <span id="weather-uv">{Math.round(daily.uvIndexMax[0])}</span></p>
</section>
