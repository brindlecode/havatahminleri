---
import WeatherIcon from './WeatherIcon.astro';
import SkyFx from './SkyFx.astro';
import { getWeatherDescription } from '../lib/weatherCodes';
import { getWindDirection, formatDate } from '../lib/utils';
import { getSkyClass } from '../lib/sky';
import type { HeroTip } from '../lib/heroTip';
import type { CurrentWeather as CW, DailyForecast, HourlyForecast } from '../lib/weather';

interface Props {
  cityName: string;
  current: CW;
  daily: DailyForecast;
  hourly?: HourlyForecast;
  heading?: string;
  /** One-line advice for the day the page is about (src/lib/heroTip.ts). */
  tip?: HeroTip | null;
  /** Name and URL saved to "Konumlarım" by the star button. */
  place?: { name: string; href: string };
}

const { cityName, current, daily, hourly, heading, tip, place } = Astro.props;
const h1Text = heading || `${cityName} Hava Durumu`;
const description = getWeatherDescription(current.weatherCode);
const windDir = getWindDirection(current.windDirection);
const todayMax = daily.temperatureMax[0];
const todayMin = daily.temperatureMin[0];
const todayLabel = daily.time[0] ? formatDate(daily.time[0], { day: 'numeric', month: 'long', weekday: 'long' }) : '';
const sky = getSkyClass(current.weatherCode, current.isDay);
const precipProb = daily.precipitationProbabilityMax?.[0];

// Icons for every code/day-night pair in the 48h series, so weather-now.js can
// show the icon of the visitor's current hour without shipping icon code.
const iconKeys = hourly
  ? [...new Set(hourly.weatherCode.slice(0, 48).map((c, i) => `${c}-${hourly.isDay[i] === 1 ? 1 : 0}`))]
  : [];

// The page is built once a day, so the static numbers describe today at noon.
// weather-now.js swaps in the forecast for the visitor's current hour from
// this compact hourly table - no API call from the browser.
const asOf = current.hour ? `Bugün ${current.hour.slice(11, 16)} tahmini` : 'Bugün için tahmin';
const r = (v: number | undefined) => (typeof v === 'number' ? Math.round(v) : null);
const hm = (s: string | undefined) => (s && s.length >= 16 ? s.slice(11, 16) : null);
const hourlyJson = hourly
  ? JSON.stringify({
      t: hourly.time.slice(0, 48),
      v: hourly.temperature.slice(0, 48).map(r),
      a: (hourly.apparentTemperature ?? []).slice(0, 48).map(r),
      c: hourly.weatherCode.slice(0, 48),
      h: hourly.humidity.slice(0, 48).map(r),
      w: hourly.windSpeed.slice(0, 48).map(r),
      d: (hourly.windDirection ?? []).slice(0, 48).map(r),
      i: hourly.isDay.slice(0, 48),
      // First days of the daily series, so the hero can show the right
      // high/low if the page is viewed after midnight, before the next build.
      dt: daily.time.slice(0, 3),
      dx: daily.temperatureMax.slice(0, 3).map(r),
      dn: daily.temperatureMin.slice(0, 3).map(r),
      // Sunrise/sunset ("06:58"), for the dawn and dusk skies.
      sr: daily.sunrise.slice(0, 3).map(hm),
      ss: daily.sunset.slice(0, 3).map(hm),
      n: Object.fromEntries(
        [...new Set(hourly.weatherCode.slice(0, 48))].map((c) => [c, getWeatherDescription(c)]),
      ),
    })
  : null;
---

<section
  id="current-weather"
  class:list={['sky rounded-[2rem] overflow-hidden px-5 pt-5 pb-5 sm:px-8 sm:pt-7 sm:pb-8 shadow-[0_24px_60px_-32px_rgba(14,26,43,0.55)]', sky]}
  data-sky={sky}
>
  <SkyFx />
  {hourlyJson && <script type="application/json" id="hourly-data" set:html={hourlyJson} />}

  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_17.5rem] lg:gap-8 lg:items-end">
    <div class="min-w-0">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="text-[0.78rem] font-semibold uppercase tracking-[0.08em] text-white/80">
            {todayLabel && <span id="weather-date" class="capitalize">{todayLabel}</span>}
            <span aria-hidden="true"> · </span><span id="weather-asof" class="normal-case tracking-normal">{asOf}</span>
          </p>
          <h1 class="font-display mt-1.5 text-[1.6rem] sm:text-[2.35rem] font-[650] leading-[1.08] tracking-[-0.025em]">{h1Text}</h1>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <div id="hero-icon" class="drop-shadow-[0_8px_18px_rgba(0,0,0,0.2)]">
            <WeatherIcon code={current.weatherCode} isDay={current.isDay} size="w-14 h-14 sm:w-20 sm:h-20" decorative />
          </div>
        </div>
        {iconKeys.length > 0 && (
          <template id="hero-icons">
            {iconKeys.map((k) => {
              const [c, d] = k.split('-').map(Number);
              return <span data-icon-key={k}><WeatherIcon code={c} isDay={d === 1} size="w-14 h-14 sm:w-20 sm:h-20" decorative /></span>;
            })}
          </template>
        )}
      </div>

      <div class="mt-3 sm:mt-5 flex items-end gap-4 sm:gap-6">
        <p id="weather-temp" class="font-display text-[6.5rem] sm:text-[8.75rem] font-[200] leading-[0.8] tracking-[-0.06em] tabular">
          {Math.round(current.temperature)}°
        </p>
        <div class="pb-1.5 min-w-0">
          <p id="weather-desc" class="text-lg sm:text-2xl font-bold leading-snug">{description}</p>
          <p class="text-sm sm:text-base text-white/85 mt-0.5 tabular leading-snug">
            <span class="block">En yüksek <span id="weather-high">{Math.round(todayMax)}</span>°</span>
            <span class="block">En düşük <span id="weather-low">{Math.round(todayMin)}</span>°</span>
          </p>
        </div>
      </div>

      {tip && (
        <div class="sky-panel mt-5 flex items-start gap-3 px-4 py-3 max-w-xl" data-day-relative>
          <svg class="w-6 h-6 shrink-0 mt-0.5" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3a9 9 0 0 1 9 9H3a9 9 0 0 1 9-9z" fill="currentColor" opacity=".95"/>
            <path d="M12 12v6.5a2 2 0 0 0 4 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <p class="text-[0.95rem] sm:text-base leading-snug">
            <span class="text-[0.7rem] font-bold uppercase tracking-[0.08em] text-white/75 mr-1">{tip.day}</span>
            <strong class="font-bold">{tip.lead}</strong> {tip.detail}
          </p>
        </div>
      )}
    </div>

    <div class="mt-4 lg:mt-0">
      <dl class="grid grid-cols-4 lg:grid-cols-2 gap-2 sm:gap-2.5">
        <div class="sky-panel px-2.5 py-2 sm:px-3.5 sm:py-3">
          <dt class="text-[0.68rem] sm:text-xs text-white/75">Hissedilen</dt>
          <dd class="text-base sm:text-xl font-bold tabular"><span id="weather-feels">{Math.round(current.apparentTemperature)}</span>°</dd>
        </div>
        <div class="sky-panel px-2.5 py-2 sm:px-3.5 sm:py-3">
          <dt class="text-[0.68rem] sm:text-xs text-white/75">Nem</dt>
          <dd class="text-base sm:text-xl font-bold tabular">%<span id="weather-humidity">{current.humidity}</span></dd>
        </div>
        <div class="sky-panel px-2.5 py-2 sm:px-3.5 sm:py-3">
          <dt class="text-[0.68rem] sm:text-xs text-white/75">Rüzgar <span id="weather-winddir">{windDir}</span></dt>
          <dd class="text-base sm:text-xl font-bold tabular leading-tight">
            <span id="weather-wind">{Math.round(current.windSpeed)}</span><span class="text-[0.68rem] sm:text-xs font-semibold"> km/s</span>
          </dd>
        </div>
        <div class="sky-panel px-2.5 py-2 sm:px-3.5 sm:py-3">
          <dt class="text-[0.68rem] sm:text-xs text-white/75">Yağış</dt>
          <dd class="text-base sm:text-xl font-bold tabular leading-tight">
            %{precipProb ?? 0}
            <span class="sr-only"><span id="weather-precip">{daily.precipitationSum[0]}</span> mm</span>
          </dd>
        </div>
      </dl>
      {place && (
        <button
          type="button"
          class="sky-panel mt-2.5 w-full flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-semibold hover:bg-white/20 transition-colors"
          data-save-place
          data-place-name={place.name}
          data-place-href={place.href}
          aria-pressed="false"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.8z" fill="currentColor" data-star /></svg>
          <span data-save-label>Konumlarıma ekle</span>
        </button>
      )}
    </div>
  </div>
  <p class="sr-only">UV indeksi: <span id="weather-uv">{Math.round(daily.uvIndexMax[0])}</span></p>
</section>
