---
import type { PeriodId } from '../lib/periods';

interface Props {
  links: { label: string; href: string; id: PeriodId }[];
  /** Matched by period id, not by label - "Yarın" is both a label and the
   *  intent the base location page owns. */
  activeId: PeriodId;
}

const { links, activeId } = Astro.props;
---

<div class="weather-card my-4">
  <div class="period-tabs relative">
    <div class="period-tabs-scroll flex gap-2 overflow-x-auto scrollbar-hide pb-1 -mx-1 px-1">
      {links.map((link) => {
        const isActive = link.id === activeId;
        return (
          <a
            href={link.href}
            data-period-tab-active={isActive ? 'true' : 'false'}
            class:list={[
              'px-4 py-2.5 rounded-xl text-sm font-semibold whitespace-nowrap transition-all border-2 shadow-sm',
              isActive
                ? 'bg-blue-500 text-white border-blue-500 shadow-blue-200'
                : 'bg-[var(--color-surface)] text-[var(--color-text-secondary)] border-[var(--color-border)] hover:bg-[var(--color-bg)] hover:text-blue-500 hover:border-blue-400',
            ]}
          >
            {link.label}
          </a>
        );
      })}
    </div>
    <div class="period-tabs-fade-left pointer-events-none absolute left-0 top-0 bottom-0 w-6 opacity-0 transition-opacity" aria-hidden="true"></div>
    <div class="period-tabs-fade pointer-events-none absolute right-0 top-0 bottom-0 w-8" aria-hidden="true"></div>
  </div>
</div>

<style>
  .period-tabs-fade {
    background: linear-gradient(to left, var(--color-surface), transparent);
  }
  .period-tabs-fade-left {
    background: linear-gradient(to right, var(--color-surface), transparent);
  }
</style>

<script is:inline>
  (function () {
    function alignActiveToStart() {
      document.querySelectorAll('.period-tabs').forEach(function (container) {
        const scroller = container.querySelector('.period-tabs-scroll');
        const active = container.querySelector('[data-period-tab-active="true"]');
        if (scroller && active) {
          // Align active tab to the left edge (with a small gutter) so the
          // following tabs are still discoverable and previous tabs can be
          // reached by scrolling left.
          scroller.scrollLeft = Math.max(0, active.offsetLeft - 8);
          updateLeftFade(scroller, container);
          scroller.addEventListener('scroll', function () {
            updateLeftFade(scroller, container);
          });
        }
      });
    }
    function updateLeftFade(scroller, container) {
      const fade = container.querySelector('.period-tabs-fade-left');
      if (!fade) return;
      fade.style.opacity = scroller.scrollLeft > 4 ? '1' : '0';
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', alignActiveToStart);
    } else {
      alignActiveToStart();
    }
  })();
</script>
