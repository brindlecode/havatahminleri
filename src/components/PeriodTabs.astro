---
import type { PeriodId } from '../lib/periods';

interface Props {
  links: { label: string; href: string; id: PeriodId }[];
  /** Matched by period id, not by label - "Yarın" is both a label and the
   *  intent the base location page owns. */
  activeId: PeriodId;
}

const { links, activeId } = Astro.props;
---

<nav aria-label="Tahmin dönemi" class="period-tabs relative -mx-4 sm:mx-0">
  <div class="period-tabs-scroll flex gap-1.5 overflow-x-auto scrollbar-hide px-4 sm:px-0 py-0.5">
    {links.map((link) => {
      const isActive = link.id === activeId;
      return (
        <a
          href={link.href}
          aria-current={isActive ? 'page' : undefined}
          data-period-tab-active={isActive ? 'true' : 'false'}
          class:list={[
            'h-10 px-4 inline-flex items-center rounded-full text-[0.9rem] font-semibold whitespace-nowrap transition-colors border',
            isActive
              ? 'bg-[var(--color-text)] text-[var(--color-bg)] border-[var(--color-text)]'
              : 'bg-[var(--color-surface)] text-[var(--color-text-secondary)] border-[var(--color-border)] hover:text-[var(--color-text)] hover:border-[var(--color-text-secondary)]',
          ]}
        >
          {link.label}
        </a>
      );
    })}
  </div>
</nav>

<script is:inline>
  (function () {
    function align() {
      document.querySelectorAll('.period-tabs').forEach(function (c) {
        var s = c.querySelector('.period-tabs-scroll');
        var a = c.querySelector('[data-period-tab-active="true"]');
        if (s && a && s.scrollWidth > s.clientWidth) s.scrollLeft = Math.max(0, a.offsetLeft - 16);
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', align);
    else align();
  })();
</script>
