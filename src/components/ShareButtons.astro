---
interface Props {
  /** Message to share, without the URL. */
  text: string;
  url: string;
  /** Title for the native share sheet. */
  title?: string;
  /** compact = WhatsApp + share/copy; full adds X, Facebook and Telegram;
   *  mini = the compact pair as small icon-only buttons. */
  variant?: 'full' | 'compact' | 'mini';
  label?: string;
  /** Analytics: what is shared ("page", "activity_plan", "activity") and which one. */
  type: string;
  itemId?: string;
}

// Plain links work without JavaScript; public/scripts/share.js adds the
// native share sheet / copy button and share analytics.
const { text, url, title, variant = 'full', label, type, itemId } = Astro.props;
const enc = encodeURIComponent;
// X counts characters, so it only gets the first line.
const shortText = text.split('\n')[0];
const links = {
  whatsapp: `https://wa.me/?text=${enc(`${text}\n👉 ${url}`)}`,
  x: `https://twitter.com/intent/tweet?text=${enc(shortText)}&url=${enc(url)}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`,
  telegram: `https://t.me/share/url?url=${enc(url)}&text=${enc(text)}`,
};
---

<div
  class="flex flex-wrap items-center gap-2"
  data-share
  data-share-text={text}
  data-share-url={url}
  data-share-title={title}
  data-share-type={type}
  data-share-id={itemId}
>
  {label && <span class="text-[0.8rem] font-semibold text-[var(--color-text-secondary)] mr-1">{label}</span>}
  <a class="share-btn share-btn-wa" href={links.whatsapp} target="_blank" rel="noopener nofollow" data-share-method="whatsapp" aria-label={variant === 'mini' ? "WhatsApp'ta paylaş" : undefined}>
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Z"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.5-2-1-1 1c-1-.5-2-1.5-2.5-2.5l1-1-1-2Z" fill="currentColor" stroke="none"/></svg>
    {variant !== 'mini' && <span>WhatsApp</span>}
  </a>
  {variant === 'full' && (
    <Fragment>
      <a class="share-btn" href={links.x} target="_blank" rel="noopener nofollow" data-share-method="x" aria-label="X'te paylaş">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 3h5.5l4.2 5.9L17.8 3H21l-6.8 7.9L21.5 21H16l-4.6-6.4L5.8 21H2.6l7.3-8.4Z"/></svg>
      </a>
      <a class="share-btn" href={links.facebook} target="_blank" rel="noopener nofollow" data-share-method="facebook" aria-label="Facebook'ta paylaş">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3.2h-3.1V7.8c0-.9.3-1.6 1.6-1.6h1.7V3.4a22 22 0 0 0-2.5-.1c-2.5 0-4.1 1.5-4.1 4.2v2.3H7.5V13h2.7v8Z"/></svg>
        <span class="hidden sm:inline">Facebook</span>
      </a>
      <a class="share-btn" href={links.telegram} target="_blank" rel="noopener nofollow" data-share-method="telegram" aria-label="Telegram'da paylaş">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.5 3.5 2.8 10.7c-1 .4-1 1.5 0 1.8l4.6 1.5 1.8 5.6c.2.7 1.1.9 1.6.4l2.6-2.4 4.8 3.5c.7.5 1.6.1 1.8-.7L22.9 4.9c.2-1-.6-1.8-1.4-1.4ZM9.6 14.3l-.5 3.6-1.3-4.3 9.4-6-7.6 6.7Z"/></svg>
        <span class="hidden sm:inline">Telegram</span>
      </a>
    </Fragment>
  )}
  <button type="button" class="share-btn share-btn-ghost" data-share-method="native" hidden>
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="m8.2 10.8 7.6-4.4M8.2 13.2l7.6 4.4"/></svg>
    <span data-share-label class:list={[variant === 'mini' && 'sr-only']}>Paylaş</span>
  </button>
</div>
