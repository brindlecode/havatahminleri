---
import provinces from '../data/provinces.json';
import districts from '../data/districts.json';

const popularCities = provinces.filter((p: any) => p.popular).slice(0, 6);

// Build search index - compact format to reduce page size
// Only pass province search data inline (81 items), districts loaded on-demand
const provinceSearch = provinces.map((p: any) => ({
  n: p.name,
  u: `/${p.slug}-hava-durumu`,
  t: 'il'
}));
---

<header class="sticky top-0 z-50 glass border-b border-[var(--color-border)]">
  <div class="max-w-7xl mx-auto px-4 py-3">
    <div class="flex items-center justify-between gap-4">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 shrink-0">
        <svg class="w-8 h-8 text-primary-500" viewBox="0 0 32 32" fill="none">
          <circle cx="16" cy="14" r="6" fill="currentColor" opacity="0.9"/>
          <path d="M16 4v3M16 21v3M24 14h3M5 14h3M22.2 7.8l-2.1 2.1M11.9 18.1l-2.1 2.1M22.2 20.2l-2.1-2.1M11.9 9.9l-2.1-2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M20 22c0-2.2 1.8-4 4-4s4 1.8 4 4-1.8 4-4 4h-10c-2.8 0-5-2.2-5-5s2.2-5 5-5c.5 0 1 .1 1.5.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="var(--color-surface)" opacity="0.8"/>
        </svg>
        <span class="text-lg font-bold text-primary-600 dark:text-primary-400 hidden sm:block">
          Hava Tahminleri
        </span>
      </a>

      <!-- Search -->
      <div class="flex-1 max-w-md relative" id="search-container">
        <div class="relative">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[var(--color-text-secondary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input
            type="text"
            id="city-search"
            placeholder="Şehir veya ilçe ara..."
            autocomplete="off"
            class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)] text-[var(--color-text)] placeholder:text-[var(--color-text-secondary)] focus:outline-none focus:ring-2 focus:ring-primary-500/50 focus:border-primary-500 transition-all text-sm"
          />
        </div>
        <div id="search-results" class="absolute top-full left-0 right-0 mt-1 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl shadow-lg overflow-hidden hidden z-50 max-h-80 overflow-y-auto">
        </div>
      </div>

      <!-- Theme Toggle -->
      <button
        id="theme-toggle"
        class="p-2.5 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)] hover:bg-primary-50 dark:hover:bg-primary-900/30 transition-colors"
        aria-label="Tema değiştir"
      >
        <svg class="w-5 h-5 hidden dark:block text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"/>
        </svg>
        <svg class="w-5 h-5 block dark:hidden text-slate-700" fill="currentColor" viewBox="0 0 20 20">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline define:vars={{ provData: JSON.stringify(provinceSearch) }}>
  // Theme toggle
  document.getElementById('theme-toggle').addEventListener('click', () => {
    const html = document.documentElement;
    const isDark = html.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Search - provinces inline, districts loaded from separate file on first search
  const provinces = JSON.parse(provData);
  let districtData = null;
  let allItems = provinces;
  const searchInput = document.getElementById('city-search');
  const searchResults = document.getElementById('search-results');

  function normalize(str) {
    return str.toLowerCase()
      .replace(/ğ/g, 'g').replace(/ü/g, 'u').replace(/ş/g, 's')
      .replace(/ı/g, 'i').replace(/ö/g, 'o').replace(/ç/g, 'c')
      .replace(/â/g, 'a').replace(/î/g, 'i').replace(/û/g, 'u');
  }

  async function loadDistricts() {
    if (districtData) return;
    try {
      const res = await fetch('/search-index.json');
      if (res.ok) {
        districtData = await res.json();
        allItems = [...provinces, ...districtData];
      }
    } catch {}
  }

  searchInput.addEventListener('focus', () => {
    loadDistricts(); // Preload on focus
  });

  searchInput.addEventListener('input', async (e) => {
    const query = normalize(e.target.value.trim());
    if (query.length < 2) {
      searchResults.classList.add('hidden');
      return;
    }

    // Ensure districts are loaded
    await loadDistricts();

    const matches = allItems.filter(c => normalize(c.n).includes(query)).slice(0, 10);
    if (matches.length === 0) {
      searchResults.innerHTML = '<div class="px-4 py-3 text-sm text-[var(--color-text-secondary)]">Sonuç bulunamadı</div>';
    } else {
      searchResults.innerHTML = matches.map(c =>
        `<a href="${c.u}" class="flex items-center gap-3 px-4 py-3 hover:bg-primary-50 dark:hover:bg-primary-900/30 transition-colors border-b border-[var(--color-border)] last:border-0">
          <svg class="w-4 h-4 text-[var(--color-text-secondary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <div>
            <span class="text-sm font-medium">${c.n}</span>
            <span class="text-xs text-[var(--color-text-secondary)] ml-1">${c.t === 'ilce' ? '(İlçe)' : '(İl)'}</span>
          </div>
        </a>`
      ).join('');
    }
    searchResults.classList.remove('hidden');
  });

  searchInput.addEventListener('focus', () => {
    if (searchInput.value.trim().length >= 2) {
      searchResults.classList.remove('hidden');
    }
  });

  document.addEventListener('click', (e) => {
    if (!document.getElementById('search-container').contains(e.target)) {
      searchResults.classList.add('hidden');
    }
  });
</script>
