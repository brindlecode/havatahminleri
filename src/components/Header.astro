---
// Search behavior is handled by /scripts/search.js using /search-index.json.
---

<header class="sticky top-0 z-50 glass border-b border-[var(--color-border)]">
  <div class="max-w-7xl mx-auto px-4 py-3">
    <div class="flex items-center justify-between gap-4">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 shrink-0 group">
        <svg class="w-9 h-9 drop-shadow-sm" viewBox="0 0 48 48" fill="none" aria-hidden="true">
          <defs>
            <linearGradient id="hdr-bg" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#2563EB"/>
              <stop offset="100%" stop-color="#7C3AED"/>
            </linearGradient>
            <linearGradient id="hdr-sun" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#FBBF24"/>
              <stop offset="100%" stop-color="#F59E0B"/>
            </linearGradient>
          </defs>
          <rect width="48" height="48" rx="14" fill="url(#hdr-bg)"/>
          <circle cx="33" cy="14" r="7" fill="url(#hdr-sun)"/>
          <g stroke="#FBBF24" stroke-width="1.8" stroke-linecap="round" opacity="0.7">
            <line x1="33" y1="4" x2="33" y2="5.5"/>
            <line x1="40" y1="7" x2="39" y2="8.2"/>
            <line x1="43" y1="14" x2="41.5" y2="14"/>
            <line x1="26" y1="7" x2="27" y2="8.2"/>
          </g>
          <ellipse cx="18" cy="24" rx="10" ry="6.5" fill="white" opacity="0.95"/>
          <ellipse cx="27" cy="22" rx="8" ry="6" fill="white" opacity="0.95"/>
          <ellipse cx="12" cy="25" rx="6" ry="4.5" fill="white" opacity="0.9"/>
          <path d="M16 33 L21 38 L21 43" stroke="white" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          <path d="M26 33 L21 38" stroke="white" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          <circle cx="32" cy="34" r="1.2" fill="white" opacity="0.6"/>
          <circle cx="36" cy="38" r="1" fill="white" opacity="0.5"/>
          <circle cx="30" cy="40" r="1.1" fill="white" opacity="0.5"/>
        </svg>
        <div class="hidden sm:flex flex-col leading-tight">
          <span class="text-[1.1rem] font-extrabold tracking-tight text-slate-800 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
            yarınhava
          </span>
          <span class="text-[0.65rem] font-medium text-slate-400 dark:text-slate-500 tracking-wide uppercase">
            Türkiye Hava Durumu
          </span>
        </div>
      </a>

      <!-- Search -->
      <div class="flex-1 max-w-md relative" id="search-container" role="search">
        <div class="relative">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[var(--color-text-secondary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input
            type="text"
            id="city-search"
            placeholder="Şehir veya ilçe ara..."
            aria-label="Şehir veya ilçe ara"
            autocomplete="off"
            data-search-input
            data-search-target="search-results"
            data-search-theme="header"
            class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)] text-[var(--color-text)] placeholder:text-[var(--color-text-secondary)] focus:outline-none focus:ring-2 focus:ring-primary-500/50 focus:border-primary-500 transition-all text-sm"
          />
        </div>
        <div id="search-results" class="absolute top-full left-0 right-0 mt-1 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl shadow-lg overflow-hidden hidden z-50 max-h-80 overflow-y-auto">
        </div>
      </div>

      <!-- Theme Toggle -->
      <button
        id="theme-toggle"
        class="p-2.5 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)] hover:bg-primary-50 dark:hover:bg-primary-900/30 transition-colors"
        aria-label="Tema değiştir"
      >
        <svg class="w-5 h-5 hidden dark:block text-yellow-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"/>
        </svg>
        <svg class="w-5 h-5 block dark:hidden text-slate-700" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  // Theme toggle
  document.getElementById('theme-toggle').addEventListener('click', () => {
    const html = document.documentElement;
    const isDark = html.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
</script>
<script is:inline src="/scripts/search.js" defer></script>
