---
import { groupsForIcons, ICON_SPRITE_PATH, ICON_GUIDE_PATH } from '../lib/iconLegend';

interface Props {
  /** Every icon drawn on the page (hero, hourly strip, daily rows). */
  icons: { code: number; isDay: boolean }[];
}

// Explains only the icons this page actually shows; the full catalogue lives
// on /hava-durumu-simgeleri/.
const groups = groupsForIcons(Astro.props.icons);
---

{groups.length > 0 && (
  <section class="weather-card" aria-labelledby="icon-legend-title">
    <h2 id="icon-legend-title" class="section-label">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
      Bu sayfadaki simgeler
    </h2>
    <ul class="space-y-3">
      {groups.map((g) => (
        <li class="flex items-start gap-3">
          <svg class="w-9 h-9 shrink-0 rounded-xl bg-[var(--color-surface-2)] p-1" viewBox="0 0 48 48" aria-hidden="true">
            <use href={`${ICON_SPRITE_PATH}#${g.id}`} />
          </svg>
          <div class="min-w-0">
            <p class="text-sm font-semibold leading-tight">{g.label}</p>
            <p class="text-xs text-[var(--color-text-secondary)] leading-snug mt-0.5">{g.meaning}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="text-xs text-[var(--color-text-secondary)] leading-snug mt-3">
      Simgelerin altındaki <span class="font-semibold text-sky-700 dark:text-sky-300">%</span> değeri o saat ya da gün için yağış olasılığıdır.
    </p>
    <a href={ICON_GUIDE_PATH} class="chip-link mt-3">
      Tüm simgeler ve anlamları
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/></svg>
    </a>
  </section>
)}
