---
import '../styles/global.css';
import siteConfig from '../data/site-config.json';
import CookieBanner from '../components/CookieBanner.astro';
// Same file global.css references, so the preload is reused, not refetched.
import figtreeLatin from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Omitted only on pages that must not be indexed (the 404 page). */
  canonical?: string;
  noindex?: boolean;
  structuredData?: string;
  /** Present on forecast pages; enables the client-side "current conditions" refresh. */
  lat?: number;
  lon?: number;
  /** Absolute URL of a 1200x630 PNG share image; defaults to the site image. */
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title, description, canonical, structuredData, lat, lon, noindex = false,
  ogImage = 'https://yarinhava.com/og-image.png', ogImageAlt,
} = Astro.props;
const { analytics, verification, ads } = siteConfig;
const hasCoords = typeof lat === 'number' && typeof lon === 'number';
const siteHost = new URL(Astro.site ?? 'https://yarinhava.com').hostname;
---

<!doctype html>
<html lang="tr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="author" content="Yarın Hava" />
    <!-- Search Engine Verification -->
    {verification.google && <meta name="google-site-verification" content={verification.google} />}
    {verification.yandex && <meta name="yandex-verification" content={verification.yandex} />}
    {verification.bing && <meta name="msvalidate.01" content={verification.bing} />}
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="Yarın Hava" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#f4f6f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0f1a" media="(prefers-color-scheme: dark)" />

    <link rel="preload" as="font" type="font/woff2" href={figtreeLatin} crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- Consent Mode v2. Everything defaults to denied (KVKK/GDPR: analytics
         and advertising cookies are opt-in). A visitor who already chose is
         read from localStorage HERE, before any tag fires, so a returning
         visitor who accepted is measured from the first hit and one who
         declined is never measured. The banner (CookieBanner.astro) stores
         the choice and sends gtag('consent','update') plus a `yh:consent`
         event that Yandex Metrica waits for. With the defaults denied, GA4
         still receives cookieless pings (advanced consent mode), so traffic
         reporting drops to modelled numbers rather than to zero. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      (function () {
        // The admin panel keeps its GitHub token in sessionStorage. Public
        // pages load third-party scripts (ads, analytics) on the same origin,
        // so drop the token before any of them run if the admin navigated
        // here in the same tab.
        try { sessionStorage.removeItem('admin_gh_token'); } catch (e) {}
        var stored = null;
        try { stored = JSON.parse(localStorage.getItem('yh_cookie_consent_v1')); } catch (e) {}
        var v = stored && stored.status === 'granted' ? 'granted' : 'denied';
        window.yhConsentStatus = stored && stored.status ? stored.status : null;
        gtag('consent', 'default', {
          'ad_storage': v,
          'ad_user_data': v,
          'ad_personalization': v,
          'analytics_storage': v,
          'wait_for_update': 500
        });
        gtag('set', 'url_passthrough', true);
        gtag('set', 'ads_data_redaction', v === 'denied');
      })();
    </script>

    {analytics.googleAnalyticsId && (
      <Fragment>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analytics.googleAnalyticsId}`}></script>
        <script is:inline define:vars={{ gaId: analytics.googleAnalyticsId }}>
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </Fragment>
    )}

    <title>{title}</title>

    {structuredData && structuredData.split('\n').map((json: string) => (
      <script type="application/ld+json" set:html={json} />
    ))}

    <!-- Dark mode init (prevent flash) -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark' ||
          (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {}
    </script>

    <!-- AdSense limited ad serving for invalid traffic (2026-10-18). The
         script used to load unconditionally, so every automated browser
         (headless crawlers, SEO auditors, uptime monitors, AI agents),
         every scraped copy of the site on another domain and the owner's
         own daily visits produced impressions under our publisher ID.
         It now loads only for a real visitor: on our own domain, not in a
         frame, not under automation, not on the 404 page, not on a device
         opted out with ?reklamsiz=1 (the admin panel sets that too), and
         only after the first scroll/tap/key/mouse move - bots that render
         the page but never interact no longer see ads at all. -->
    {ads.enabled && ads.adsensePublisherId && !noindex && (
      <script is:inline define:vars={{ adClient: ads.adsensePublisherId, adHosts: [siteHost, `www.${siteHost}`] }}>
        (function () {
          var optOut = false;
          try {
            var flag = /[?&]reklamsiz=([01])/.exec(location.search);
            if (flag && flag[1] === '1') localStorage.setItem('yh_no_ads', '1');
            if (flag && flag[1] === '0') localStorage.removeItem('yh_no_ads');
            optOut = localStorage.getItem('yh_no_ads') === '1';
          } catch (e) {}
          var ua = navigator.userAgent || '';
          var automated = navigator.webdriver ||
            /bot[\/;)]|\+https?:|crawl|spider|slurp|headless|lighthouse|pagespeed|gtmetrix|ptst|pingdom|uptime|phantom|selenium|puppeteer|playwright|python|curl|wget|httpclient|okhttp|axios|node-fetch|go-http|java\//i.test(ua);
          var framed = false;
          try { framed = window.top !== window.self; } catch (e) { framed = true; }
          if (optOut || automated || framed || adHosts.indexOf(location.hostname) === -1) return;

          var events = ['pointerdown', 'touchstart', 'scroll', 'wheel', 'keydown', 'mousemove'];
          var loaded = false;
          function load() {
            if (loaded) return;
            loaded = true;
            events.forEach(function (e) { window.removeEventListener(e, load, { passive: true }); });
            var s = document.createElement('script');
            s.async = true;
            s.crossOrigin = 'anonymous';
            s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + adClient;
            document.head.appendChild(s);
          }
          events.forEach(function (e) { window.addEventListener(e, load, { passive: true }); });
        })();
      </script>
    )}
  </head>
  <body
    class="min-h-screen flex flex-col"
    data-lat={hasCoords ? String(lat) : undefined}
    data-lon={hasCoords ? String(lon) : undefined}
  >
    <slot name="header" />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <slot name="footer" />
    <CookieBanner />

    {hasCoords && <script is:inline defer src="/scripts/weather-now.js"></script>}

    {analytics.yandexMetricaId && (
      <Fragment>
        <script is:inline define:vars={{ ymId: analytics.yandexMetricaId }}>
          (function () {
            function loadYandex() {
              (function (m, e, t, r, i, k, a) {
                m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments) };
                m[i].l = 1 * new Date();
                for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) return; }
                k = e.createElement(t); a = e.getElementsByTagName(t)[0]; k.async = 1; k.src = r;
                a.parentNode.insertBefore(k, a);
              })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
              ym(ymId, 'init', {
                clickmap: true,
                trackLinks: true,
                accurateTrackBounce: true,
                webvisor: true,
              });
            }
            function scheduleLoad() {
              if (typeof window.requestIdleCallback === 'function') {
                window.requestIdleCallback(loadYandex, { timeout: 3000 });
              } else {
                setTimeout(loadYandex, 1500);
              }
            }
            // Yandex Metrica (incl. Webvisor session recording) only runs
            // after the visitor accepts analytics cookies.
            function whenLoaded() {
              if (document.readyState === 'complete') {
                scheduleLoad();
              } else {
                window.addEventListener('load', scheduleLoad, { once: true });
              }
            }
            if (window.yhConsentStatus === 'granted') {
              whenLoaded();
            } else {
              window.addEventListener('yh:consent', function (e) {
                if (e.detail === 'granted') whenLoaded();
              });
            }
          })();
        </script>
      </Fragment>
    )}
  </body>
</html>
