---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CurrentWeather from '../components/CurrentWeather.astro';
import HourlyForecast from '../components/HourlyForecast.astro';
import DailyForecast from '../components/DailyForecast.astro';
import PeriodTabs from '../components/PeriodTabs.astro';
import WeatherDetails from '../components/WeatherDetails.astro';
import PeriodInsights from '../components/PeriodInsights.astro';
import ForecastFreshness from '../components/ForecastFreshness.astro';
import AdSlot from '../components/AdSlot.astro';
import AnswerSummary from '../components/AnswerSummary.astro';
import NearbyLocations from '../components/NearbyLocations.astro';
import ActivityAdvice from '../components/ActivityAdvice.astro';
import { getPeriodForecastData, getPeriodLinks, type PeriodId } from '../lib/periods';
import type { WeatherData } from '../lib/weather';

interface Props {
  title: string;
  description: string;
  canonical: string;
  structuredData: string;
  /** Name used in the H1 and in prose ("İzmit", "Adıyaman Merkez", "Kocaeli"). */
  cityName: string;
  /** Standalone display name; includes the province for shared district names. */
  displayName?: string;
  provinceSlug?: string;
  districtSlug?: string | null;
  heading: string;
  weather: WeatherData;
  breadcrumbs: { name: string; url: string }[];
  period: PeriodId;
  /** Location path without a trailing slash, e.g. "/kocaeli-hava-durumu". */
  basePath: string;
  lat: number;
  lon: number;
}

const {
  title, description, canonical, structuredData,
  cityName, displayName, provinceSlug, districtSlug = null, heading, weather, breadcrumbs, period, basePath, lat, lon,
} = Astro.props;

// One source of truth for how many days/hours this period shows.
const { daily, showHourly, hourlyStart, hourlyEnd, period: def } = getPeriodForecastData(
  weather,
  period,
);

const links = getPeriodLinks(basePath);
const activeId: PeriodId = period === 'base' ? 'yarin' : period;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  structuredData={structuredData}
  lat={lat}
  lon={lon}
>
  <Header slot="header" />

  <div class="max-w-6xl mx-auto px-4 pt-4 pb-8">
    <Breadcrumb items={breadcrumbs} />

    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-6 lg:items-start">
      <div class="space-y-4 min-w-0">
        <CurrentWeather cityName={cityName} current={weather.current} daily={weather.daily} hourly={weather.hourly} heading={heading} />
        <ForecastFreshness />

        <AnswerSummary weather={weather} cityName={displayName ?? cityName} period={period} canonical={canonical} />

        <PeriodTabs links={links} activeId={activeId} />

        {showHourly && def.hourlyTitle && (
          <HourlyForecast
            hourly={weather.hourly}
            startIndex={hourlyStart}
            endIndex={hourlyEnd}
            title={def.hourlyTitle}
          />
        )}

        {daily.time.length > 0 && <DailyForecast daily={daily} title={def.dailyTitle} />}

        <ActivityAdvice weather={weather} cityName={displayName ?? cityName} period={period} canonical={canonical} />

        <AdSlot slot="inContent" id="forecast-mid" />

        <WeatherDetails current={weather.current} daily={weather.daily} />

        <PeriodInsights cityName={cityName} weather={weather} period={period} />
      </div>

      <aside class="space-y-4 mt-4 lg:mt-0" aria-label="Detaylar ve ilgili sayfalar">
        <AdSlot slot="sidebar" id="forecast-side" />
        {provinceSlug && <NearbyLocations provinceSlug={provinceSlug} districtSlug={districtSlug} />}
        <slot />
        <AdSlot slot="footer" id="forecast-bottom" />
      </aside>
    </div>
  </div>

  <Footer slot="footer" />
  <script is:inline defer src="/scripts/share.js"></script>
</BaseLayout>
