---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CurrentWeather from '../components/CurrentWeather.astro';
import HourlyForecast from '../components/HourlyForecast.astro';
import DailyForecast from '../components/DailyForecast.astro';
import PeriodTabs from '../components/PeriodTabs.astro';
import WeatherDetails from '../components/WeatherDetails.astro';
import PeriodInsights from '../components/PeriodInsights.astro';
import ForecastFreshness from '../components/ForecastFreshness.astro';
import AdSlot from '../components/AdSlot.astro';
import { getPeriodForecastData, getPeriodLinks, type PeriodId } from '../lib/periods';
import type { WeatherData } from '../lib/weather';

interface Props {
  title: string;
  description: string;
  canonical: string;
  structuredData: string;
  /** Name used in the H1 and in prose ("İzmit", "Adıyaman Merkez", "Kocaeli"). */
  cityName: string;
  heading: string;
  weather: WeatherData;
  breadcrumbs: { name: string; url: string }[];
  period: PeriodId;
  /** Location path without a trailing slash, e.g. "/kocaeli-hava-durumu". */
  basePath: string;
  lat: number;
  lon: number;
}

const {
  title, description, canonical, structuredData,
  cityName, heading, weather, breadcrumbs, period, basePath, lat, lon,
} = Astro.props;

// One source of truth for how many days/hours this period shows. The
// "15 Günlük" page used to slice `slice(0, 16)` and render 16 rows.
const { daily, showHourly, hourlyStart, hourlyEnd, period: def } = getPeriodForecastData(
  weather,
  period,
);

const links = getPeriodLinks(basePath);
const activeId: PeriodId = period === 'base' ? 'yarin' : period;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  structuredData={structuredData}
  lat={lat}
  lon={lon}
>
  <Header slot="header" />

  <div class="max-w-4xl mx-auto px-4 py-6">
    <Breadcrumb items={breadcrumbs} />

    <CurrentWeather cityName={cityName} current={weather.current} daily={weather.daily} heading={heading}>
      <ForecastFreshness />
    </CurrentWeather>

    <AdSlot slot="header" id="forecast-top" />

    <PeriodTabs links={links} activeId={activeId} />

    {showHourly && def.hourlyTitle && (
      <div class="mt-4">
        <HourlyForecast
          hourly={weather.hourly}
          startIndex={hourlyStart}
          endIndex={hourlyEnd}
          title={def.hourlyTitle}
        />
      </div>
    )}

    {daily.time.length > 0 && (
      <div class="mt-4">
        <DailyForecast daily={daily} title={def.dailyTitle} />
      </div>
    )}

    <AdSlot slot="inContent" id="forecast-mid" />

    <div class="mt-4">
      <WeatherDetails current={weather.current} daily={weather.daily} />
    </div>

    <!-- Location links (districts / siblings), supplied by the page. -->
    <slot />

    <PeriodInsights cityName={cityName} weather={weather} period={period} />

    <AdSlot slot="footer" id="forecast-bottom" />
  </div>

  <Footer slot="footer" />
</BaseLayout>
