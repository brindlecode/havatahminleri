---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CurrentWeather from '../components/CurrentWeather.astro';
import HourlyForecast from '../components/HourlyForecast.astro';
import DailyForecast from '../components/DailyForecast.astro';
import ForecastTabs from '../components/ForecastTabs.astro';
import WeatherDetails from '../components/WeatherDetails.astro';
import WeatherSummary from '../components/WeatherSummary.astro';
import AdSlot from '../components/AdSlot.astro';
import type { WeatherData } from '../lib/weather';

interface Props {
  title: string;
  description: string;
  canonical: string;
  structuredData: string;
  cityName: string;
  weather: WeatherData;
  breadcrumbs: { name: string; url: string }[];
  period: string; // 'bugun' | 'yarin' | '7gun' | '10gun' | '15gun' | 'saatlik'
  periodLabel: string;
  lat: number;
  lon: number;
  isDistrict?: boolean;
  provinceName?: string;
  links?: { label: string; href: string }[];
  relatedLinks?: { name: string; href: string }[];
}

const {
  title, description, canonical, structuredData,
  cityName, weather, breadcrumbs, period, periodLabel,
  lat, lon, isDistrict = false, provinceName,
  links = [], relatedLinks = [],
} = Astro.props;

// Determine which days to show based on period
const dayCount = period === 'bugun' ? 1 : period === 'yarin' ? 2 : period === '7gun' ? 7 : period === '10gun' ? 10 : 16;
const startDay = period === 'yarin' ? 1 : 0;
const showHourly = period === 'bugun' || period === 'yarin' || period === 'saatlik' || period === '15gun';

// Slice daily data for this period
const periodDaily = {
  ...weather.daily,
  time: weather.daily.time.slice(startDay, dayCount),
  weatherCode: weather.daily.weatherCode.slice(startDay, dayCount),
  temperatureMax: weather.daily.temperatureMax.slice(startDay, dayCount),
  temperatureMin: weather.daily.temperatureMin.slice(startDay, dayCount),
  precipitationSum: weather.daily.precipitationSum.slice(startDay, dayCount),
  precipitationProbabilityMax: weather.daily.precipitationProbabilityMax.slice(startDay, dayCount),
  windSpeedMax: weather.daily.windSpeedMax.slice(startDay, dayCount),
  uvIndexMax: weather.daily.uvIndexMax.slice(startDay, dayCount),
  sunrise: weather.daily.sunrise.slice(startDay, dayCount),
  sunset: weather.daily.sunset.slice(startDay, dayCount),
};
---

<BaseLayout title={title} description={description} canonical={canonical} structuredData={structuredData}>
  <Header slot="header" />

  <div class="max-w-4xl mx-auto px-4 py-6">
    <Breadcrumb items={breadcrumbs} />

    <CurrentWeather cityName={cityName} current={weather.current} daily={weather.daily} />

    <AdSlot id="city-top" />

    <!-- Period Navigation -->
    <div class="weather-card my-4">
      <div class="flex gap-1 overflow-x-auto scrollbar-hide pb-1 -mx-1 px-1">
        {links.map(link => (
          <a
            href={link.href}
            class:list={[
              'px-3 py-2 rounded-lg text-xs font-medium whitespace-nowrap transition-all border',
              link.label === periodLabel
                ? 'bg-blue-500 text-white border-blue-500'
                : 'bg-[var(--color-bg)] text-[var(--color-text-secondary)] border-[var(--color-border)] hover:bg-[var(--color-surface)] hover:text-[var(--color-text)]'
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>

    {showHourly && (
      <div class="mt-4">
        <HourlyForecast hourly={weather.hourly} />
      </div>
    )}

    {period !== 'saatlik' && (
      <div class="mt-4">
        <DailyForecast daily={periodDaily} />
      </div>
    )}

    <AdSlot id="city-mid" />

    <div class="mt-4">
      <WeatherDetails current={weather.current} daily={weather.daily} />
    </div>

    <AdSlot id="city-details" />

    <!-- Related links -->
    <slot />

    <WeatherSummary cityName={cityName} weather={weather} isDistrict={isDistrict} provinceName={provinceName} />

    <AdSlot id="city-bottom" />
  </div>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline define:vars={{ lat, lon }}>
  (function() {
    const CACHE_KEY = 'weather_' + lat + '_' + lon;
    const CACHE_MS = 30 * 60 * 1000;
    function getCached() {
      try { const c = localStorage.getItem(CACHE_KEY); if (!c) return null; const { ts } = JSON.parse(c); return Date.now() - ts <= CACHE_MS; } catch { return null; }
    }
    async function refresh() {
      if (getCached()) return;
      try {
        const p = new URLSearchParams({
          latitude: String(lat), longitude: String(lon),
          current: 'temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m,wind_direction_10m,is_day,surface_pressure,cloud_cover,visibility',
          hourly: 'temperature_2m,weather_code,relative_humidity_2m,precipitation_probability,wind_speed_10m,is_day,dew_point_2m,visibility,surface_pressure,cloud_cover',
          daily: 'weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum,precipitation_probability_max,wind_speed_10m_max,uv_index_max,sunrise,sunset',
          timezone: 'Europe/Istanbul', forecast_days: '16', forecast_hours: '48'
        });
        const r = await fetch('https://api.open-meteo.com/v1/forecast?' + p);
        const d = await r.json();
        localStorage.setItem(CACHE_KEY, JSON.stringify({ d, ts: Date.now() }));
      } catch {}
    }
    refresh();
  })();
</script>
